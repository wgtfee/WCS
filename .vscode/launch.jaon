{
    "version": "0.2.0",
    "configurations": [
        {
            "name": ".NET Core Launch (console)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            // 🚨 下面这行改为你 Wcs.Host 编译出的实际 dll 绝对或相对路径
            "program": "${workspaceFolder}/src/Wcs.Host/bin/Debug/net8.0/Wcs.Host.dll",
            "args": [],
            "cwd": "${workspaceFolder}/src/Wcs.Host",
            "console": "internalConsole",
            "stopAtEntry": false
        }
    ]
}
