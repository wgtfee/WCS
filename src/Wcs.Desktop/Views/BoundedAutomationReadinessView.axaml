<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Wcs.Desktop.ViewModels"
             xmlns:idi="using:Wcs.IndustrialIntelligence.Governance"
             x:Class="Wcs.Desktop.Views.BoundedAutomationReadinessView"
             x:DataType="vm:BoundedAutomationReadinessViewModel">
  <ScrollViewer>
    <StackPanel Margin="24" Spacing="16">
      <TextBlock Text="IDI-P6 Bounded Automation Readiness" FontSize="24" FontWeight="SemiBold" />
      <TextBlock Text="{Binding SafetyText}" TextWrapping="Wrap" Opacity="0.75" />

      <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="8">
        <TextBlock Grid.Row="0" Grid.Column="0" Text="Environment" FontWeight="SemiBold" />
        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Environment}" />
        <TextBlock Grid.Row="1" Grid.Column="0" Text="Mode / Boundary" FontWeight="SemiBold" />
        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ModeText}" TextWrapping="Wrap" />
        <TextBlock Grid.Row="2" Grid.Column="0" Text="Final Claim" FontWeight="SemiBold" />
        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ClaimText}" FontWeight="SemiBold" />
      </Grid>

      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Content="刷新只读 Evidence" Command="{Binding RefreshCommand}" />
        <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" TextWrapping="Wrap" />
      </StackPanel>

      <TextBlock Text="永久禁止自动化操作" FontSize="18" FontWeight="SemiBold" />
      <ItemsControl ItemsSource="{Binding PermanentProhibitions}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Padding="8" Margin="0,0,0,6" BorderThickness="1" CornerRadius="4">
              <TextBlock Text="{Binding}" />
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <TextBlock Text="最近 Readiness Evidence" FontSize="18" FontWeight="SemiBold" />
      <ItemsControl ItemsSource="{Binding Evidence}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="idi:BoundedAutomationReadinessEvidenceRecord">
            <Border Padding="10" Margin="0,0,0,8" BorderThickness="1" CornerRadius="4">
              <Grid ColumnDefinitions="180,80,120,120,*,160" ColumnSpacing="8">
                <TextBlock Grid.Column="0" Text="{Binding EvaluationId}" />
                <TextBlock Grid.Column="1" Text="{Binding RequestedLevel}" />
                <TextBlock Grid.Column="2" Text="{Binding SoftwareSideReady}" />
                <TextBlock Grid.Column="3" Text="{Binding ProductionEnablementAllowed}" />
                <TextBlock Grid.Column="4" Text="{Binding DecisionHash}" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="5" Text="{Binding EvaluatedAtUtc}" />
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <Border Padding="12" BorderThickness="1" CornerRadius="6">
        <StackPanel Spacing="8">
          <TextBlock Text="Evidence 查询（只读）" FontWeight="SemiBold" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBox Width="320" PlaceholderText="EvaluationId" Text="{Binding EvaluationId}" />
            <Button Content="读取 Evidence" Command="{Binding LoadEvidenceCommand}" />
          </StackPanel>
          <TextBlock Text="{Binding SelectedEvidenceText}" TextWrapping="Wrap" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
