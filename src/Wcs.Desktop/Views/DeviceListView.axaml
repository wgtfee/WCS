<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Wcs.Desktop.ViewModels"
             xmlns:conv="using:Wcs.Desktop.Converters"
             x:Class="Wcs.Desktop.Views.DeviceListView"
             Background="#1E1E1E">
    <UserControl.Resources>
        <conv:StatusToColorConverter x:Key="StatusToColor" />
    </UserControl.Resources>

    <DockPanel Margin="16">
        <!-- Toolbar -->
        <Border DockPanel.Dock="Top" Background="#2A2A2A" CornerRadius="8" Padding="12" Margin="0,0,0,8">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <TextBlock Text="Devices" FontSize="20" FontWeight="Bold" Foreground="White"
                           VerticalAlignment="Center" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                    <Button Content="Refresh" Command="{Binding RefreshCommand}"
                            Background="#1565C0" Foreground="White" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Device List - Header -->
        <Border DockPanel.Dock="Top" Background="#333333" CornerRadius="4,4,0,0" Padding="8,6">
            <Grid ColumnDefinitions="2*,*,*,1.5*">
                <TextBlock Text="Device ID" Foreground="#999" FontWeight="Bold" />
                <TextBlock Grid.Column="1" Text="Status" Foreground="#999" FontWeight="Bold" />
                <TextBlock Grid.Column="2" Text="Position" Foreground="#999" FontWeight="Bold" />
                <TextBlock Grid.Column="3" Text="Last Update" Foreground="#999" FontWeight="Bold" />
            </Grid>
        </Border>

        <ScrollViewer>
            <ItemsControl ItemsSource="{Binding Devices}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="8,6" BorderBrush="#404040" BorderThickness="0,0,0,1">
                            <Grid ColumnDefinitions="2*,*,*,1.5*">
                                <TextBlock Text="{Binding DeviceId}" Foreground="White" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <Ellipse Width="10" Height="10"
                                             Fill="{Binding Status, Converter={StaticResource StatusToColor}}" />
                                    <TextBlock Text="{Binding Status}" Foreground="White" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding CurrentPosition}" Foreground="#CCC" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="3" Text="{Binding LastUpdateTime}" Foreground="#CCC" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
