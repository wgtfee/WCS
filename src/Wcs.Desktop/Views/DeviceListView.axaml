<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Wcs.Desktop.ViewModels"
             xmlns:conv="using:Wcs.Desktop.Converters"
             xmlns:atom="https://atomui.net"
             x:Class="Wcs.Desktop.Views.DevicesView"
             x:DataType="vm:DevicesViewModel"
             Background="{DynamicResource BgPrimary}">
    <UserControl.Resources>
        <conv:StatusToColorConverter x:Key="StatusToColor" />
    </UserControl.Resources>

    <DockPanel Margin="16">
        <!-- Toolbar -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource BgSecondary}" CornerRadius="8" Padding="12" Margin="0,0,0,8">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <TextBlock Text="Devices" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"
                           VerticalAlignment="Center" />
                <Button Grid.Column="2" Content="刷新" Command="{Binding RefreshCommand}" Classes="Secondary" />
            </Grid>
        </Border>

        <!-- 设备列表 DataGrid -->
        <atom:DataGrid ItemsSource="{Binding Devices}" AutoGenerateColumns="False"
                       IsReadOnly="True"
                       CanUserSortColumns="True"
                       CanUserFilterColumns="True"
                       CanUserResizeColumns="True"
                       Margin="0,0,0,8">
            <atom:DataGrid.Columns>
                <atom:DataGridTemplateColumn Header="设备 ID" SortMemberPath="DeviceId">
                    <atom:DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding DeviceId}" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" Margin="4,0" />
                        </DataTemplate>
                    </atom:DataGridTemplateColumn.CellTemplate>
                </atom:DataGridTemplateColumn>
                <atom:DataGridTemplateColumn Header="状态" SortMemberPath="Status">
                    <atom:DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="4,0">
                                <Ellipse Width="10" Height="10"
                                         Fill="{Binding Status, Converter={StaticResource StatusToColor}}" />
                                <TextBlock Text="{Binding Status}" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </atom:DataGridTemplateColumn.CellTemplate>
                </atom:DataGridTemplateColumn>
                <atom:DataGridTemplateColumn Header="位置" SortMemberPath="CurrentPosition">
                    <atom:DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding CurrentPosition}" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" Margin="4,0" />
                        </DataTemplate>
                    </atom:DataGridTemplateColumn.CellTemplate>
                </atom:DataGridTemplateColumn>
                <atom:DataGridTemplateColumn Header="最后更新" SortMemberPath="LastUpdateTime">
                    <atom:DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding LastUpdateTime}" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" Margin="4,0" />
                        </DataTemplate>
                    </atom:DataGridTemplateColumn.CellTemplate>
                </atom:DataGridTemplateColumn>
            </atom:DataGrid.Columns>
        </atom:DataGrid>
    </DockPanel>
</UserControl>
