<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Wcs.Desktop.ViewModels"
             xmlns:conv="using:Wcs.Desktop.Converters"
             xmlns:atom="https://atomui.net"
             x:Class="Wcs.Desktop.Views.DevicesView"
             x:DataType="vm:DevicesViewModel"
             Background="{DynamicResource BgPrimary}">
    <UserControl.Resources>
        <conv:StatusToColorConverter x:Key="StatusToColor" />
    </UserControl.Resources>

    <Grid RowDefinitions="Auto,Auto,*" Margin="24" RowSpacing="16">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <StackPanel Spacing="4">
                <TextBlock Classes="wcs-page-title" Text="设备运行中心" />
                <TextBlock Classes="wcs-page-subtitle" Text="统一查看设备在线状态、当前位置与最后更新时间。" />
            </StackPanel>
            <atom:Button Grid.Column="1" Content="刷新" Command="{Binding RefreshCommand}" />
        </Grid>

        <UniformGrid Grid.Row="1" Columns="1" Rows="1">
            <atom:Card StyleVariant="Outlined" IsHoverable="True">
                <atom:Statistic Header="当前设备" Value="{Binding Devices.Count}" ContentFontSize="26" />
            </atom:Card>
        </UniformGrid>

        <atom:Card Grid.Row="2" Header="设备列表" StyleVariant="Outlined">
            <atom:DataGrid ItemsSource="{Binding Devices}" AutoGenerateColumns="False"
                           IsReadOnly="True"
                           CanUserSortColumns="True"
                           CanUserFilterColumns="True"
                           CanUserResizeColumns="True"
                           PaginationVisibility="None">
                <atom:DataGrid.Columns>
                    <atom:DataGridTextColumn Header="设备 ID" Binding="{Binding DeviceId}" Width="*" />
                    <atom:DataGridTemplateColumn Header="状态" SortMemberPath="Status" Width="140">
                        <atom:DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="4,0">
                                    <Ellipse Width="10" Height="10" Fill="{Binding Status, Converter={StaticResource StatusToColor}}" />
                                    <TextBlock Text="{Binding Status}" VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </atom:DataGridTemplateColumn.CellTemplate>
                    </atom:DataGridTemplateColumn>
                    <atom:DataGridTextColumn Header="位置" Binding="{Binding CurrentPosition}" Width="*" />
                    <atom:DataGridTextColumn Header="最后更新" Binding="{Binding LastUpdateTime}" Width="190" />
                </atom:DataGrid.Columns>
            </atom:DataGrid>
        </atom:Card>
    </Grid>
</UserControl>
