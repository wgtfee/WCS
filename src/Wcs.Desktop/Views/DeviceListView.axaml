<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Wcs.Desktop.ViewModels"
             xmlns:conv="using:Wcs.Desktop.Converters"
             xmlns:atom="https://atomui.net"
             x:Class="Wcs.Desktop.Views.DevicesView"
             x:DataType="vm:DevicesViewModel"
             Background="{DynamicResource BgPrimary}">
    <UserControl.Resources>
        <conv:StatusToColorConverter x:Key="StatusToColor" />
    </UserControl.Resources>

    <Grid RowDefinitions="Auto,Auto,*" Margin="22" RowSpacing="14">
        <Border Grid.Row="0" Classes="wcs-page-hero">
            <Grid ColumnDefinitions="4,*,Auto" ColumnSpacing="14">
                <Border Classes="wcs-accent-rail" />
                <StackPanel Grid.Column="1" Spacing="3">
                    <TextBlock Classes="wcs-page-eyebrow" Text="OPERATIONS · DEVICE RUNTIME" />
                    <TextBlock Classes="wcs-page-title" Text="设备状态" />
                    <TextBlock Classes="wcs-page-subtitle"
                               Text="从设备运行态数据源查看设备标识、当前状态、位置和最后更新时间。页面不构造设备状态，只呈现 Host 返回的实际记录。" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Border Classes="wcs-status-success">
                        <TextBlock Text="RUNTIME DATA" FontSize="10" FontWeight="SemiBold" />
                    </Border>
                    <atom:Button Content="刷新数据" Command="{Binding RefreshCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" ColumnDefinitions="220,*,Auto" ColumnSpacing="10">
            <Border Classes="wcs-kpi">
                <StackPanel Spacing="3">
                    <TextBlock Classes="wcs-kpi-label" Text="当前设备记录" />
                    <TextBlock Classes="wcs-kpi-value" Text="{Binding Devices.Count}" />
                    <TextBlock Classes="wcs-section-caption" Text="本次已加载行数" />
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Classes="wcs-toolbar">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                    <TextBlock Text="数据范围" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Classes="wcs-section-caption"
                               Text="DeviceId · Status · CurrentPosition · LastUpdateTime" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="DB RUNTIME" FontSize="10" FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentBlue}" VerticalAlignment="Center" />
                </Grid>
            </Border>
            <Border Grid.Column="2" Classes="wcs-panel-muted" MinWidth="120">
                <StackPanel Spacing="3">
                    <TextBlock Classes="wcs-kpi-label" Text="加载状态" />
                    <TextBlock Text="{Binding IsLoading}" FontSize="12" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2" Classes="wcs-table-shell">
            <Grid RowDefinitions="Auto,*">
                <Border Padding="16,12" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource BorderColor}">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="2">
                            <TextBlock Classes="wcs-section-title" Text="设备运行明细" />
                            <TextBlock Classes="wcs-section-caption" Text="状态点颜色仅用于辅助识别，设备状态文本仍以实际返回值为准。" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="LIVE / DB" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                    </Grid>
                </Border>
                <atom:DataGrid Grid.Row="1"
                               ItemsSource="{Binding Devices}"
                               AutoGenerateColumns="False"
                               IsReadOnly="True"
                               CanUserSortColumns="True"
                               CanUserFilterColumns="True"
                               CanUserResizeColumns="True"
                               PaginationVisibility="None">
                    <atom:DataGrid.Columns>
                        <atom:DataGridTextColumn Header="设备 ID" Binding="{Binding DeviceId}" Width="1.3*" />
                        <atom:DataGridTemplateColumn Header="运行状态" SortMemberPath="Status" Width="180">
                            <atom:DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="4,0">
                                        <Ellipse Width="9" Height="9" Fill="{Binding Status, Converter={StaticResource StatusToColor}}" />
                                        <TextBlock Text="{Binding Status}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </StackPanel>
                                </DataTemplate>
                            </atom:DataGridTemplateColumn.CellTemplate>
                        </atom:DataGridTemplateColumn>
                        <atom:DataGridTextColumn Header="当前位置" Binding="{Binding CurrentPosition}" Width="1.2*" />
                        <atom:DataGridTextColumn Header="最后更新" Binding="{Binding LastUpdateTime}" Width="220" />
                    </atom:DataGrid.Columns>
                </atom:DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>