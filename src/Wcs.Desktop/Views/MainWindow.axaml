<Window x:Class="Wcs.Desktop.Views.MainWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Wcs.Desktop.ViewModels"
        xmlns:Vc="using:Wcs.Entity"
        xmlns:ctl="using:Wcs.Desktop.Controls"
        x:DataType="vm:MainWindowViewModel"
        x:Name="MainWin"
        Title="WCS Runtime Engine"
        Width="1280" Height="800"
        Background="{DynamicResource BgPrimary}"
        Foreground="White"
        WindowStartupLocation="CenterScreen">

    <Window.Styles>
        <!-- 全局去掉焦点白框 + Flyout 白边框 -->
        <Style Selector="Button">
            <Setter Property="FocusAdorner" Value="{x:Null}"/>
        </Style>
        <Style Selector="FlyoutPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        <Style Selector="TreeView">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="TreeViewItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        </Style>
        <Style Selector="TreeViewItem:selected /template/ Border#RootBorder,
                         TreeViewItem:focus-visible /template/ Border#RootBorder,
                         TreeViewItem:selected:focus /template/ Border#RootBorder,
                         TreeViewItem:selected:pointerover /template/ Border#RootBorder">
            <Setter Property="Background" Value="{DynamicResource TreeViewSelectedBg}"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="TreeViewItem:selected, TreeViewItem:selected:focus">
            <Setter Property="Background" Value="{DynamicResource TreeViewSelectedBg}"/>
        </Style>

    </Window.Styles>

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- 顶部 Header 
        <Border Background="{DynamicResource BgSecondary}" Padding="16,8">
            <TextBlock Text="{Binding ConnectionText}" FontSize="12" Foreground="{DynamicResource TextSecondary}"/>
        </Border>
-->
        <!-- 主区域：固定左侧菜单 + 右侧标签页 -->
        <Grid Grid.Row="1" ColumnDefinitions="Auto,*">

            <!-- 左侧菜单 -->
            <Border Background="{DynamicResource BgSidebar}"
                    BorderThickness="0,0,1,0" BorderBrush="{DynamicResource BorderColor}"
                    Width="{Binding SidebarWidth}">
                <Grid RowDefinitions="Auto,*">

                    <!-- 展开/折叠切换按钮 -->
                    <Button Grid.Row="0"
                            Width="36" Height="36" Margin="0,8,0,4"
                            HorizontalAlignment="Center"
                            Background="Transparent" BorderThickness="0"
                            Focusable="False"
                            Command="{Binding ToggleSidebarCommand}"
                            ToolTip.Tip="切换侧边栏">
                        <Grid>
                            <TextBlock Text="◀" FontSize="16"
                                       Foreground="{DynamicResource TextSecondary}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       IsVisible="{Binding IsSidebarCollapsed, Converter={StaticResource InverseBool}}"/>
                            <TextBlock Text="☰" FontSize="20"
                                       Foreground="{DynamicResource TextSecondary}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       IsVisible="{Binding IsSidebarCollapsed}"/>
                        </Grid>
                    </Button>

                    <!-- ========== 展开模式：TreeView ========== -->
                    <TreeView Grid.Row="1"
                              ItemsSource="{Binding MenuItems}"
                              IsVisible="{Binding IsSidebarCollapsed, Converter={StaticResource InverseBool}}"
                              Background="Transparent"
                              BorderThickness="0"
                              SelectionMode="Single"
                              SelectedItem="{Binding SelectedMenuItem, Mode=TwoWay}">
                        <TreeView.DataTemplates>
                            <TreeDataTemplate ItemsSource="{Binding Children}" DataType="Vc:MenuItemDto">
                                <Border Padding="12,8" Background="Transparent">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextPrimary}" FontSize="13"/>
                                    </StackPanel>
                                </Border>
                            </TreeDataTemplate>
                        </TreeView.DataTemplates>
                         <TreeView.Resources>
                             <SolidColorBrush x:Key="TreeViewItemForeground" Color="{StaticResource TextSecondary}"/>
                         </TreeView.Resources>
                         <TreeView.Styles>
                            <Style Selector="TreeViewItem:pointerover /template/ Path#ChevronPath">
                                <Setter Property="Fill" Value="{StaticResource TextPrimary}"/>
                            </Style>
                            <Style Selector="TreeViewItem:selected /template/ Path#ChevronPath">
                                <Setter Property="Fill" Value="{StaticResource TextPrimary}"/>
                            </Style>
                        </TreeView.Styles>
                    </TreeView>

                    <!-- ========== 折叠模式：图标按钮 ========== -->
                    <ItemsControl Grid.Row="1"
                                  ItemsSource="{Binding MenuItems}"
                                  IsVisible="{Binding IsSidebarCollapsed}"
                                  Margin="0,4,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="Vc:MenuItemDto">
                                <Button Width="48" Height="48" Padding="0"
                                        Background="Transparent" BorderThickness="0"
                                        ToolTip.Tip="{Binding Name}"
                                        Command="{Binding $parent[ItemsControl].DataContext.CollapsedMenuClickCommand}"
                                        CommandParameter="{Binding}">
                                    <TextBlock Text="{Binding Name[0]}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontSize="18"
                                               Foreground="{DynamicResource TextSecondary}"/>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- ========== 折叠模式弹出菜单 ========== -->
                    <Popup IsOpen="{Binding IsCollapsedFlyoutOpen}"
                           Placement="RightEdgeAlignedTop"
                           IsLightDismissEnabled="True"
                           HorizontalOffset="1"
                           VerticalOffset="-4">
                        <Border Background="{DynamicResource BgCard}"
                                BorderBrush="{DynamicResource BorderColor}"
                                BorderThickness="1" CornerRadius="4"
                                Width="200" MaxHeight="400"
                                Padding="4">
                            <TreeView ItemsSource="{Binding ActiveFlyoutChildren}"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      SelectionMode="Single"
                                      SelectedItem="{Binding ActiveFlyoutSelectedItem, Mode=TwoWay}">
                                <TreeView.DataTemplates>
                                    <TreeDataTemplate ItemsSource="{Binding Children}" DataType="Vc:MenuItemDto">
                                        <Border Padding="12,8" Background="Transparent">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{Binding Name}"
                                                           Foreground="{DynamicResource TextPrimary}"
                                                           FontSize="13"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Text="▶" FontSize="10"
                                                           Foreground="{DynamicResource TextSecondary}"
                                                           VerticalAlignment="Center"
                                                           IsVisible="{Binding Children.Count}"/>
                                            </StackPanel>
                                        </Border>
                                    </TreeDataTemplate>
                                </TreeView.DataTemplates>
                            </TreeView>
                        </Border>
                    </Popup>

                </Grid>
            </Border>

            <!-- 右侧可关闭标签页 -->
            <ctl:ClosableTabControl Grid.Column="1"
                                    Tabs="{Binding Tabs}"
                                    SelectedTab="{Binding SelectedTabItem}" />

        </Grid>

        <!-- 底部状态栏 -->
        <Border Grid.Row="2" Background="{DynamicResource BgStatusBar}" Padding="8,4" Height="30">
            <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,*">

                <!-- 用户信息按钮（放最左侧） -->
                <Button Grid.Column="0" MinWidth="40" Height="28" Padding="8,0"
                        Background="Transparent" BorderThickness="0" Focusable="False"
                        Content="👤" FontSize="14"
                        ToolTip.Tip="用户菜单">
                    <Button.Flyout>
                        <Flyout Placement="Top">
                            <ctl:ProfileMenuView/>
                        </Flyout>
                    </Button.Flyout>
                </Button>

                <!-- 消息通知按钮 -->
                <Button Grid.Column="1" MinWidth="40" Height="28" Padding="8,0" Margin="2,0"
                        Background="Transparent" BorderThickness="0" Focusable="False"
                        Content="🔔" FontSize="14"
                        ToolTip.Tip="消息中心">
                    <Button.Flyout>
                        <Flyout Placement="Top" FlyoutPresenterClasses="NotificationFlyout">
                            <ctl:NotificationCenterView/>
                        </Flyout>
                    </Button.Flyout>
                </Button>

                <!-- 分隔线 -->
                <Border Grid.Column="2" Width="1" Background="{DynamicResource BorderColor}" Margin="8,2"/>

                <!-- 连接状态 -->
                <Ellipse Grid.Column="3" x:Name="StatusDot" Width="8" Height="8" Fill="Gray"
                         VerticalAlignment="Center"/>
                <TextBlock Grid.Column="4" x:Name="StatusText"
                           Text="{Binding ConnectionText}"
                           FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="6,0,0,0"
                           VerticalAlignment="Center"/>

            </Grid>
        </Border>

        <!-- Profile 覆盖层 -->
        <Border Grid.Row="1" x:Name="ProfileOverlay" IsVisible="False"
                Background="#80000000"
                ZIndex="100"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <ctl:UserProfileOverlay x:Name="ProfileOverlayControl"
                                    CloseRequested="OnProfileOverlayClosed"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>
        </Border>

        <!-- 修改密码覆盖层 -->
        <Border Grid.Row="1" x:Name="ChangePasswordOverlay" IsVisible="False"
                Background="#80000000"
                ZIndex="100"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <ctl:ChangePasswordOverlay x:Name="ChangePasswordOverlayControl"
                                       CloseRequested="OnChangePasswordOverlayClosed"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
        </Border>

    </Grid>
</Window>
