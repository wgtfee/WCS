<Window x:Class="Wcs.Desktop.Views.MainWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Wcs.Desktop.ViewModels"
        xmlns:Vc="using:Wcs.Entity"
        xmlns:ctl="using:Wcs.Desktop.Controls"
        xmlns:atom="https://atomui.net"
        x:DataType="vm:MainWindowViewModel"
        x:Name="MainWin"
        Title="WCS · Warehouse Control System"
        Width="1440" Height="900"
        MinWidth="1100" MinHeight="720"
        Background="{DynamicResource BgPrimary}"
        Foreground="{DynamicResource TextPrimary}"
        WindowStartupLocation="CenterScreen">

    <Window.Styles>
        <Style Selector="FlyoutPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="*,30">
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*">
            <!-- Industrial navigation rail -->
            <Border Grid.Column="0"
                    Width="{Binding SidebarWidth}"
                    Background="{DynamicResource BgSidebar}"
                    BorderThickness="0,0,1,0"
                    BorderBrush="#24354D">
                <Grid RowDefinitions="72,Auto,*,52">
                    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="14,12,10,8">
                        <Border Width="38" Height="38"
                                CornerRadius="9"
                                Background="{DynamicResource AccentBlue}"
                                VerticalAlignment="Center">
                            <TextBlock Text="W" FontSize="18" FontWeight="Bold"
                                       Foreground="White"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>

                        <StackPanel Grid.Column="1"
                                    Margin="10,0,4,0"
                                    VerticalAlignment="Center"
                                    IsVisible="{Binding IsSidebarCollapsed, Converter={StaticResource InverseBool}}">
                            <TextBlock Classes="wcs-sidebar-brand" Text="WCS" />
                            <TextBlock Classes="wcs-sidebar-caption" Text="WAREHOUSE CONTROL SYSTEM" />
                        </StackPanel>

                        <atom:Button Grid.Column="2"
                                     Width="32" Height="32"
                                     VerticalAlignment="Center"
                                     Command="{Binding ToggleSidebarCommand}"
                                     ToolTip.Tip="展开 / 收起导航">
                            <TextBlock Text="≡" FontSize="17" Foreground="{DynamicResource TextOnDarkSecondary}" />
                        </atom:Button>
                    </Grid>

                    <Border Grid.Row="1" Height="1" Background="#263750" Margin="14,0,14,8" />

                    <atom:TreeView Grid.Row="2"
                                   Margin="8,0,8,10"
                                   ItemsSource="{Binding MenuItems}"
                                   IsVisible="{Binding IsSidebarCollapsed, Converter={StaticResource InverseBool}}"
                                   SelectedItem="{Binding SelectedMenuItem, Mode=TwoWay}"
                                   NodeHoverMode="Block">
                        <atom:TreeView.ItemTemplate>
                            <TreeDataTemplate ItemsSource="{Binding Children}" DataType="Vc:MenuItemDto">
                                <Grid ColumnDefinitions="28,*" Margin="3,4">
                                    <TextBlock Grid.Column="0"
                                               Classes="wcs-sidebar-menu-icon"
                                               Text="{Binding Icon}" />
                                    <TextBlock Grid.Column="1"
                                               Classes="wcs-sidebar-menu-text"
                                               Text="{Binding Name}"
                                               Margin="6,0,0,0" />
                                </Grid>
                            </TreeDataTemplate>
                        </atom:TreeView.ItemTemplate>
                    </atom:TreeView>

                    <ItemsControl Grid.Row="2"
                                  ItemsSource="{Binding MenuItems}"
                                  IsVisible="{Binding IsSidebarCollapsed}"
                                  Margin="8,2,8,10">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="Vc:MenuItemDto">
                                <atom:Button Width="50" Height="48"
                                             Margin="0,2"
                                             ToolTip.Tip="{Binding Name}"
                                             Command="{Binding $parent[ItemsControl].DataContext.CollapsedMenuClickCommand}"
                                             CommandParameter="{Binding}">
                                    <TextBlock Text="{Binding Icon}"
                                               Foreground="{DynamicResource TextOnDark}"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </atom:Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Popup IsOpen="{Binding IsCollapsedFlyoutOpen}"
                           Placement="RightEdgeAlignedTop"
                           IsLightDismissEnabled="True"
                           HorizontalOffset="2"
                           VerticalOffset="-4">
                        <atom:Card StyleVariant="Outlined" Width="250" MaxHeight="480">
                            <atom:TreeView ItemsSource="{Binding ActiveFlyoutChildren}"
                                           SelectedItem="{Binding ActiveFlyoutSelectedItem, Mode=TwoWay}"
                                           NodeHoverMode="Block">
                                <atom:TreeView.ItemTemplate>
                                    <TreeDataTemplate ItemsSource="{Binding Children}" DataType="Vc:MenuItemDto">
                                        <Grid ColumnDefinitions="30,*" Margin="4,3">
                                            <TextBlock Text="{Binding Icon}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="13" Margin="6,0,0,0" VerticalAlignment="Center" />
                                        </Grid>
                                    </TreeDataTemplate>
                                </atom:TreeView.ItemTemplate>
                            </atom:TreeView>
                        </atom:Card>
                    </Popup>

                    <Border Grid.Row="3" Background="{DynamicResource BgSidebarElevated}" Padding="14,9">
                        <StackPanel IsVisible="{Binding IsSidebarCollapsed, Converter={StaticResource InverseBool}}">
                            <TextBlock Text="CONTROL PLANE" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource TextOnDarkSecondary}" />
                            <TextBlock Text="受治理运行 · 软件仿真隔离" FontSize="10" Foreground="{DynamicResource TextOnDarkSecondary}" Margin="0,2,0,0" />
                        </StackPanel>
                        <TextBlock IsVisible="{Binding IsSidebarCollapsed}"
                                   Text="CP"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextOnDarkSecondary}"
                                   FontSize="10" FontWeight="SemiBold" />
                    </Border>
                </Grid>
            </Border>

            <!-- Workspace -->
            <Grid Grid.Column="1" RowDefinitions="58,*" Background="{DynamicResource BgPrimary}">
                <Border Grid.Row="0"
                        Background="{DynamicResource BgTopBar}"
                        BorderThickness="0,0,0,1"
                        BorderBrush="{DynamicResource BorderColor}"
                        Padding="20,0,14,0">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                        <StackPanel VerticalAlignment="Center" Spacing="1">
                            <TextBlock Text="{Binding SelectedTabItem.Header}"
                                       FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}" />
                            <TextBlock Text="WCS 运行与调度工作台"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextSecondary}" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Border Classes="wcs-status-success" Padding="9,4">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Ellipse Width="7" Height="7" Fill="{DynamicResource AccentGreen}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding ConnectionText}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <atom:Button Width="42" Height="34" ToolTip.Tip="通知中心">
                                <TextBlock Text="!" FontSize="15" FontWeight="Bold" />
                                <atom:Button.Flyout>
                                    <Flyout Placement="Bottom" FlyoutPresenterClasses="NotificationFlyout">
                                        <ctl:NotificationCenterView/>
                                    </Flyout>
                                </atom:Button.Flyout>
                            </atom:Button>

                            <atom:Button MinWidth="64" Height="34" ToolTip.Tip="用户菜单">
                                <TextBlock Text="USER" FontSize="10" FontWeight="SemiBold" />
                                <atom:Button.Flyout>
                                    <Flyout Placement="Bottom">
                                        <ctl:ProfileMenuView/>
                                    </Flyout>
                                </atom:Button.Flyout>
                            </atom:Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <ctl:ClosableTabControl Grid.Row="1"
                                        Tabs="{Binding Tabs}"
                                        SelectedTab="{Binding SelectedTabItem}" />
            </Grid>
        </Grid>

        <Border Grid.Row="1" Background="{DynamicResource BgStatusBar}" Padding="12,0">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="10">
                <TextBlock Grid.Column="0" Text="WCS RUNTIME" Foreground="{DynamicResource TextOnDarkSecondary}" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" />
                <Border Grid.Column="1" Width="1" Height="12" Background="#31445E" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="受治理控制面 · Production / 未授权环境保持 fail-closed" Foreground="{DynamicResource TextOnDarkSecondary}" FontSize="10" VerticalAlignment="Center" />
                <TextBlock Grid.Column="3" Text="S0–S10" Foreground="{DynamicResource TextOnDarkSecondary}" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <Border Grid.Row="0" x:Name="ProfileOverlay" IsVisible="False"
                Background="#80000000" ZIndex="100"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <ctl:UserProfileOverlay x:Name="ProfileOverlayControl"
                                    CloseRequested="OnProfileOverlayClosed"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>
        </Border>

        <Border Grid.Row="0" x:Name="ChangePasswordOverlay" IsVisible="False"
                Background="#80000000" ZIndex="100"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <ctl:ChangePasswordOverlay x:Name="ChangePasswordOverlayControl"
                                       CloseRequested="OnChangePasswordOverlayClosed"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
        </Border>
    </Grid>
</Window>
