<Window x:Class="Wcs.Desktop.Views.MainWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Wcs.Desktop.ViewModels"
        xmlns:Vc="using:Wcs.Entity"
        xmlns:ctl="using:Wcs.Desktop.Controls"
        xmlns:atom="https://atomui.net"
        x:DataType="vm:MainWindowViewModel"
        x:Name="MainWin"
        Title="WCS Runtime Engine"
        Width="1280" Height="800"
        Background="{DynamicResource BgPrimary}"
        Foreground="{DynamicResource TextPrimary}"
        WindowStartupLocation="CenterScreen">

    <Window.Styles>
        <Style Selector="FlyoutPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="*,Auto">
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*">
            <Border Background="{DynamicResource BgSidebar}"
                    BorderThickness="0,0,1,0"
                    BorderBrush="{DynamicResource BorderColor}"
                    Width="{Binding SidebarWidth}">
                <Grid RowDefinitions="Auto,*">
                    <atom:Button Grid.Row="0"
                                 Width="38" Height="38" Margin="0,10,0,6"
                                 HorizontalAlignment="Center"
                                 Command="{Binding ToggleSidebarCommand}"
                                 ToolTip.Tip="切换侧边栏">
                        <Grid>
                            <TextBlock Text="◀" FontSize="15"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       IsVisible="{Binding IsSidebarCollapsed, Converter={StaticResource InverseBool}}"/>
                            <TextBlock Text="☰" FontSize="19"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       IsVisible="{Binding IsSidebarCollapsed}"/>
                        </Grid>
                    </atom:Button>

                    <atom:TreeView Grid.Row="1"
                                   ItemsSource="{Binding MenuItems}"
                                   IsVisible="{Binding IsSidebarCollapsed, Converter={StaticResource InverseBool}}"
                                   SelectedItem="{Binding SelectedMenuItem, Mode=TwoWay}"
                                   NodeHoverMode="Block">
                        <atom:TreeView.ItemTemplate>
                            <TreeDataTemplate ItemsSource="{Binding Children}" DataType="Vc:MenuItemDto">
                                <TextBlock Text="{Binding Name}" FontSize="13" Foreground="{DynamicResource TextPrimary}"/>
                            </TreeDataTemplate>
                        </atom:TreeView.ItemTemplate>
                    </atom:TreeView>

                    <ItemsControl Grid.Row="1"
                                  ItemsSource="{Binding MenuItems}"
                                  IsVisible="{Binding IsSidebarCollapsed}"
                                  Margin="0,4,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="Vc:MenuItemDto">
                                <atom:Button Width="48" Height="48"
                                             ToolTip.Tip="{Binding Name}"
                                             Command="{Binding $parent[ItemsControl].DataContext.CollapsedMenuClickCommand}"
                                             CommandParameter="{Binding}">
                                    <TextBlock Text="{Binding Name[0]}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontSize="17"/>
                                </atom:Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Popup IsOpen="{Binding IsCollapsedFlyoutOpen}"
                           Placement="RightEdgeAlignedTop"
                           IsLightDismissEnabled="True"
                           HorizontalOffset="1"
                           VerticalOffset="-4">
                        <atom:Card StyleVariant="Outlined" Width="220" MaxHeight="420">
                            <atom:TreeView ItemsSource="{Binding ActiveFlyoutChildren}"
                                           SelectedItem="{Binding ActiveFlyoutSelectedItem, Mode=TwoWay}"
                                           NodeHoverMode="Block">
                                <atom:TreeView.ItemTemplate>
                                    <TreeDataTemplate ItemsSource="{Binding Children}" DataType="Vc:MenuItemDto">
                                        <TextBlock Text="{Binding Name}" FontSize="13" Foreground="{DynamicResource TextPrimary}"/>
                                    </TreeDataTemplate>
                                </atom:TreeView.ItemTemplate>
                            </atom:TreeView>
                        </atom:Card>
                    </Popup>
                </Grid>
            </Border>

            <ctl:ClosableTabControl Grid.Column="1"
                                    Tabs="{Binding Tabs}"
                                    SelectedTab="{Binding SelectedTabItem}" />
        </Grid>

        <Border Grid.Row="1" Background="{DynamicResource BgStatusBar}" Padding="8,4" Height="34">
            <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,*">
                <atom:Button Grid.Column="0" Width="38" Height="28" Content="👤" ToolTip.Tip="用户菜单">
                    <atom:Button.Flyout>
                        <Flyout Placement="Top">
                            <ctl:ProfileMenuView/>
                        </Flyout>
                    </atom:Button.Flyout>
                </atom:Button>

                <atom:Button Grid.Column="1" Width="38" Height="28" Margin="4,0" Content="🔔" ToolTip.Tip="消息中心">
                    <atom:Button.Flyout>
                        <Flyout Placement="Top" FlyoutPresenterClasses="NotificationFlyout">
                            <ctl:NotificationCenterView/>
                        </Flyout>
                    </atom:Button.Flyout>
                </atom:Button>

                <Border Grid.Column="2" Width="1" Background="{DynamicResource BorderColor}" Margin="8,2"/>
                <Ellipse Grid.Column="3" x:Name="StatusDot" Width="8" Height="8" Fill="Gray" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="4" x:Name="StatusText"
                           Text="{Binding ConnectionText}"
                           FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="6,0,0,0"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <Border Grid.Row="0" x:Name="ProfileOverlay" IsVisible="False"
                Background="#80000000" ZIndex="100"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <ctl:UserProfileOverlay x:Name="ProfileOverlayControl"
                                    CloseRequested="OnProfileOverlayClosed"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>
        </Border>

        <Border Grid.Row="0" x:Name="ChangePasswordOverlay" IsVisible="False"
                Background="#80000000" ZIndex="100"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <ctl:ChangePasswordOverlay x:Name="ChangePasswordOverlayControl"
                                       CloseRequested="OnChangePasswordOverlayClosed"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
        </Border>
    </Grid>
</Window>
