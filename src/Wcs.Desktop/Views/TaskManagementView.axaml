<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="using:Wcs.Desktop.Converters"
             xmlns:vm="using:Wcs.Desktop.ViewModels"
             x:Class="Wcs.Desktop.Views.TasksView"
             x:DataType="vm:TasksViewModel"
             Background="{DynamicResource BgPrimary}">
    <UserControl.Resources>
        <conv:StatusToColorConverter x:Key="StatusToColor" />
    </UserControl.Resources>

    <DockPanel Margin="16">
        <!-- Toolbar -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource BgSecondary}" CornerRadius="8" Padding="12" Margin="0,0,0,8">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                <TextBlock Text="任务管理" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding Tasks.Count, StringFormat='共 {0} 条'}"
                           FontSize="13" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="16,0,0,0" />
                <Button Grid.Column="3" Content="刷新" Command="{Binding RefreshCommand}" Classes="Secondary" Margin="4,0,0,0" />
            </Grid>
        </Border>

        <!-- 任务列表 DataGrid -->
        <DataGrid ItemsSource="{Binding Tasks}" AutoGenerateColumns="False"
                  IsReadOnly="True"
                  Background="{DynamicResource BgStatusBar}"
                  BorderBrush="{DynamicResource BorderColor}"
                  RowHeight="36"
                  Margin="0,0,0,8">
            <DataGrid.Columns>
                <DataGridTextColumn Header="任务 ID" Binding="{Binding TaskId}" Width="SizeToCells" />
                <DataGridTextColumn Header="设备" Binding="{Binding DeviceId}" Width="SizeToCells" />
                <DataGridTemplateColumn Header="状态" Width="SizeToCells">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <Ellipse Width="10" Height="10"
                                         Fill="{Binding Status, Converter={StaticResource StatusToColor}}" />
                                <TextBlock Text="{Binding Status}" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="优先级" Binding="{Binding Priority}" Width="60" />
                <DataGridTextColumn Header="等级" Binding="{Binding PriorityLevel}" Width="SizeToCells" />
                <DataGridTextColumn Header="类别" Binding="{Binding Category}" Width="SizeToCells" />
                <DataGridTextColumn Header="路径" Binding="{Binding RouteId}" Width="SizeToCells" />
                <DataGridTextColumn Header="创建时间" Binding="{Binding CreatedTime, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}" Width="SizeToCells" />
                <DataGridTextColumn Header="开始时间" Binding="{Binding StartTime, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}" Width="SizeToCells" />
                <DataGridTextColumn Header="结束时间" Binding="{Binding EndTime, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}" Width="SizeToCells" />
                <DataGridTextColumn Header="重试" Binding="{Binding RetryCount}" Width="50" />
                <DataGridTextColumn Header="最大重试" Binding="{Binding MaxRetries}" Width="60" />
                <DataGridTextColumn Header="错误信息" Binding="{Binding ErrorMessage}" Width="2*" />
                <DataGridTextColumn Header="父任务" Binding="{Binding ParentTaskId}" Width="SizeToCells" />
                <DataGridTextColumn Header="依赖" Binding="{Binding Dependencies}" Width="2*" />
                <DataGridTemplateColumn Header="操作" Width="80">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="取消"
                                    Command="{Binding $parent[DataGrid].DataContext.CancelTaskCommand}"
                                    CommandParameter="{Binding TaskId}"
                                    Classes="Danger"
                                    HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
