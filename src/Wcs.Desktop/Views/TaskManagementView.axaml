<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="using:Wcs.Desktop.Converters"
             xmlns:vm="using:Wcs.Desktop.ViewModels"
             x:DataType="vm:TaskManagementViewModel"
             x:Class="Wcs.Desktop.Views.TaskManagementView"
             Background="#1E1E1E">
    <UserControl.Resources>
        <conv:StatusToColorConverter x:Key="StatusToColor" />
    </UserControl.Resources>

    <DockPanel Margin="16">
        <!-- Create Task Panel -->
        <Border DockPanel.Dock="Top" Background="#2A2A2A" CornerRadius="8" Padding="16" Margin="0,0,0,8">
            <StackPanel Spacing="8">
                <TextBlock Text="Create Task" FontSize="16" FontWeight="Bold" Foreground="White" />
                <Grid ColumnDefinitions="Auto,8,*,8,80,8,Auto">
                    <TextBlock Text="Device:" Foreground="#CCC" VerticalAlignment="Center" />
                    <TextBox Grid.Column="2" PlaceholderText="Device ID" Text="{Binding NewTaskDeviceId}"
                             Width="150" Background="#1E1E1E" Foreground="White" />
                    <TextBlock Grid.Column="3" Text="Route:" Foreground="#CCC" VerticalAlignment="Center" />
                    <TextBox Grid.Column="4" PlaceholderText="Route ID" Text="{Binding NewTaskRouteId}"
                             Width="150" Background="#1E1E1E" Foreground="White" />
                    <NumericUpDown Grid.Column="5" Value="{Binding NewTaskPriority}"
                                   Minimum="0" Maximum="10" Width="60" />
                    <Button Grid.Column="6" Content="Create" Command="{Binding CreateTaskCommand}"
                            Background="#2E7D32" Foreground="White" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- Task List Header -->
        <Border DockPanel.Dock="Top" Background="#333333" CornerRadius="4,4,0,0" Padding="8,6">
            <Grid ColumnDefinitions="2*,*,0.5*,*,1.5*,1.5*,*">
                <TextBlock Text="Task ID" Foreground="#999" FontWeight="Bold" />
                <TextBlock Grid.Column="1" Text="Status" Foreground="#999" FontWeight="Bold" />
                <TextBlock Grid.Column="2" Text="Pri" Foreground="#999" FontWeight="Bold" />
                <TextBlock Grid.Column="3" Text="Route" Foreground="#999" FontWeight="Bold" />
                <TextBlock Grid.Column="4" Text="Start" Foreground="#999" FontWeight="Bold" />
                <TextBlock Grid.Column="5" Text="End" Foreground="#999" FontWeight="Bold" />
                <TextBlock Grid.Column="6" Text="Actions" Foreground="#999" FontWeight="Bold" />
            </Grid>
        </Border>

        <ScrollViewer>
            <ItemsControl ItemsSource="{Binding Tasks}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="8,6" BorderBrush="#404040" BorderThickness="0,0,0,1">
                            <Grid ColumnDefinitions="2*,*,0.5*,*,1.5*,1.5*,*">
                                <TextBlock Text="{Binding TaskId}" Foreground="White" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <Ellipse Width="10" Height="10"
                                             Fill="{Binding Status, Converter={StaticResource StatusToColor}}" />
                                    <TextBlock Text="{Binding Status}" Foreground="White" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding Priority}" Foreground="#CCC" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="3" Text="{Binding RouteId}" Foreground="#CCC" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="4" Text="{Binding StartTime}" Foreground="#CCC" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="5" Text="{Binding EndTime}" Foreground="#CCC" VerticalAlignment="Center" />
                                <Button Grid.Column="6" Content="Cancel"
                                        Command="{Binding $parent[ItemsControl].DataContext.CancelTaskCommand}"
                                        CommandParameter="{Binding TaskId}"
                                        Background="#C62828" Foreground="White"
                                        HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
