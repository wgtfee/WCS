<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="using:Wcs.Desktop.Converters"
             xmlns:vm="using:Wcs.Desktop.ViewModels"
             xmlns:atom="https://atomui.net"
             x:Class="Wcs.Desktop.Views.TasksView"
             x:DataType="vm:TasksViewModel"
             Background="{DynamicResource BgPrimary}">
    <UserControl.Resources>
        <conv:StatusToColorConverter x:Key="StatusToColor" />
    </UserControl.Resources>

    <Grid RowDefinitions="Auto,Auto,Auto,*" Margin="22" RowSpacing="14">
        <Border Grid.Row="0" Classes="wcs-page-hero">
            <Grid ColumnDefinitions="4,*,Auto" ColumnSpacing="14">
                <Border Classes="wcs-accent-rail" />
                <StackPanel Grid.Column="1" Spacing="3">
                    <TextBlock Classes="wcs-page-eyebrow" Text="OPERATIONS · TASK RUNTIME" />
                    <TextBlock Classes="wcs-page-title" Text="任务管理" />
                    <TextBlock Classes="wcs-page-subtitle"
                               Text="集中查看任务状态、设备分配、路径、优先级、执行时间和错误信息。列表只保留当前数据源真实填充的字段，避免用大量空列制造信息噪声。" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Border Classes="wcs-status-success">
                        <TextBlock Text="TASK RUNTIME" FontSize="10" FontWeight="SemiBold" />
                    </Border>
                    <atom:Button Content="刷新数据" Command="{Binding RefreshCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" ColumnDefinitions="220,*,180" ColumnSpacing="10">
            <Border Classes="wcs-kpi">
                <StackPanel Spacing="3">
                    <TextBlock Classes="wcs-kpi-label" Text="当前可见任务" />
                    <TextBlock Classes="wcs-kpi-value" Text="{Binding Tasks.Count}" />
                    <TextBlock Classes="wcs-section-caption" Text="随搜索条件实时变化" />
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Classes="wcs-data-summary">
                <StackPanel Spacing="3">
                    <TextBlock Text="运行数据字段" FontSize="11" FontWeight="SemiBold" />
                    <TextBlock Classes="wcs-section-caption"
                               Text="TaskId · DeviceId · Status · Priority · RouteId · Created / Start / End · Retry · Error" />
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Classes="wcs-panel-muted">
                <StackPanel Spacing="3">
                    <TextBlock Classes="wcs-kpi-label" Text="加载状态" />
                    <TextBlock Text="{Binding IsLoading}" FontSize="12" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2" Classes="wcs-toolbar">
            <Grid ColumnDefinitions="Auto,130,280,*,Auto" ColumnSpacing="10">
                <TextBlock Text="筛选" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                <ComboBox Grid.Column="1"
                          ItemsSource="{Binding SearchFields}"
                          SelectedItem="{Binding SearchField}"
                          VerticalAlignment="Center" />
                <atom:LineEdit Grid.Column="2"
                               Text="{Binding SearchText}"
                               Watermark="输入任务、设备、状态、路径或错误..." />
                <TextBlock Grid.Column="3" Classes="wcs-section-caption"
                           Text="搜索只过滤当前已加载任务，不触发新的控制命令。" VerticalAlignment="Center" />
                <TextBlock Grid.Column="4" Text="FILTERED VIEW" FontSize="10" FontWeight="SemiBold"
                           Foreground="{DynamicResource AccentBlue}" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <Border Grid.Row="3" Classes="wcs-table-shell">
            <Grid RowDefinitions="Auto,*">
                <Border Padding="16,12" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource BorderColor}">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="2">
                            <TextBlock Classes="wcs-section-title" Text="任务执行明细" />
                            <TextBlock Classes="wcs-section-caption" Text="取消按钮继续调用既有 CancelTaskCommand；本批只调整信息架构和视觉层级。" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding SearchField}" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <atom:DataGrid Grid.Row="1"
                               ItemsSource="{Binding Tasks}"
                               AutoGenerateColumns="False"
                               IsReadOnly="True"
                               CanUserSortColumns="True"
                               CanUserFilterColumns="True"
                               CanUserResizeColumns="True"
                               PaginationVisibility="None">
                    <atom:DataGrid.Columns>
                        <atom:DataGridTextColumn Header="任务 ID" Binding="{Binding TaskId}" Width="190" />
                        <atom:DataGridTextColumn Header="设备" Binding="{Binding DeviceId}" Width="130" />
                        <atom:DataGridTemplateColumn Header="状态" SortMemberPath="Status" Width="130">
                            <atom:DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center" Margin="4,0">
                                        <Ellipse Width="9" Height="9" Fill="{Binding Status, Converter={StaticResource StatusToColor}}" />
                                        <TextBlock Text="{Binding Status}" FontWeight="SemiBold" />
                                    </StackPanel>
                                </DataTemplate>
                            </atom:DataGridTemplateColumn.CellTemplate>
                        </atom:DataGridTemplateColumn>
                        <atom:DataGridTextColumn Header="优先级" Binding="{Binding Priority}" Width="80" />
                        <atom:DataGridTextColumn Header="路径" Binding="{Binding RouteId}" Width="140" />
                        <atom:DataGridTextColumn Header="创建时间" Binding="{Binding CreatedTime}" Width="180" />
                        <atom:DataGridTextColumn Header="开始时间" Binding="{Binding StartTime}" Width="180" />
                        <atom:DataGridTextColumn Header="结束时间" Binding="{Binding EndTime}" Width="180" />
                        <atom:DataGridTextColumn Header="重试" Binding="{Binding RetryCount}" Width="70" />
                        <atom:DataGridTextColumn Header="错误信息" Binding="{Binding ErrorMessage}" Width="2*" />
                        <atom:DataGridTemplateColumn Header="操作" Width="90">
                            <atom:DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <atom:Button Content="取消"
                                                 Command="{Binding $parent[atom:DataGrid].DataContext.CancelTaskCommand}"
                                                 CommandParameter="{Binding TaskId}" />
                                </DataTemplate>
                            </atom:DataGridTemplateColumn.CellTemplate>
                        </atom:DataGridTemplateColumn>
                    </atom:DataGrid.Columns>
                </atom:DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>