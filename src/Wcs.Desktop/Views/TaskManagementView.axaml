<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="using:Wcs.Desktop.Converters"
             xmlns:vm="using:Wcs.Desktop.ViewModels"
             xmlns:atom="https://atomui.net"
             x:Class="Wcs.Desktop.Views.TasksView"
             x:DataType="vm:TasksViewModel"
             Background="{DynamicResource BgPrimary}">
    <UserControl.Resources>
        <conv:StatusToColorConverter x:Key="StatusToColor" />
    </UserControl.Resources>

    <Grid RowDefinitions="Auto,Auto,*" Margin="24" RowSpacing="16">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="10">
            <StackPanel Spacing="4">
                <TextBlock Classes="wcs-page-title" Text="任务管理" />
                <TextBlock Classes="wcs-page-subtitle" Text="任务状态、设备分配、路径、重试与异常信息的统一运行视图。" />
            </StackPanel>
            <ComboBox Grid.Column="1" ItemsSource="{Binding SearchFields}" SelectedItem="{Binding SearchField}" Width="100" VerticalAlignment="Center" />
            <atom:LineEdit Grid.Column="2" Text="{Binding SearchText}" Watermark="搜索任务..." Width="220" VerticalAlignment="Center" />
            <atom:Button Grid.Column="3" Content="刷新" Command="{Binding RefreshCommand}" />
        </Grid>

        <UniformGrid Grid.Row="1" Columns="1" Rows="1">
            <atom:Card StyleVariant="Outlined" IsHoverable="True">
                <atom:Statistic Header="当前任务" Value="{Binding Tasks.Count}" ContentFontSize="26" />
            </atom:Card>
        </UniformGrid>

        <atom:Card Grid.Row="2" Header="任务列表" StyleVariant="Outlined">
            <atom:DataGrid ItemsSource="{Binding Tasks}" AutoGenerateColumns="False"
                           IsReadOnly="True"
                           CanUserSortColumns="True"
                           CanUserFilterColumns="True"
                           CanUserResizeColumns="True"
                           PaginationVisibility="None">
                <atom:DataGrid.Columns>
                    <atom:DataGridTextColumn Header="任务 ID" Binding="{Binding TaskId}" Width="180" />
                    <atom:DataGridTextColumn Header="设备" Binding="{Binding DeviceId}" Width="120" />
                    <atom:DataGridTemplateColumn Header="状态" SortMemberPath="Status" Width="120">
                        <atom:DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="4,0">
                                    <Ellipse Width="10" Height="10" Fill="{Binding Status, Converter={StaticResource StatusToColor}}" />
                                    <TextBlock Text="{Binding Status}" />
                                </StackPanel>
                            </DataTemplate>
                        </atom:DataGridTemplateColumn.CellTemplate>
                    </atom:DataGridTemplateColumn>
                    <atom:DataGridTextColumn Header="优先级" Binding="{Binding Priority}" Width="80" />
                    <atom:DataGridTextColumn Header="等级" Binding="{Binding PriorityLevel}" Width="90" />
                    <atom:DataGridTextColumn Header="类别" Binding="{Binding Category}" Width="100" />
                    <atom:DataGridTextColumn Header="路径" Binding="{Binding RouteId}" Width="140" />
                    <atom:DataGridTextColumn Header="创建时间" Binding="{Binding CreatedTime}" Width="180" />
                    <atom:DataGridTextColumn Header="开始时间" Binding="{Binding StartTime}" Width="180" />
                    <atom:DataGridTextColumn Header="结束时间" Binding="{Binding EndTime}" Width="180" />
                    <atom:DataGridTextColumn Header="重试" Binding="{Binding RetryCount}" Width="70" />
                    <atom:DataGridTextColumn Header="最大重试" Binding="{Binding MaxRetries}" Width="90" />
                    <atom:DataGridTextColumn Header="错误信息" Binding="{Binding ErrorMessage}" Width="2*" />
                    <atom:DataGridTextColumn Header="父任务" Binding="{Binding ParentTaskId}" Width="140" />
                    <atom:DataGridTextColumn Header="依赖" Binding="{Binding Dependencies}" Width="160" />
                    <atom:DataGridTemplateColumn Header="操作" Width="90">
                        <atom:DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <atom:Button Content="取消"
                                             Command="{Binding $parent[atom:DataGrid].DataContext.CancelTaskCommand}"
                                             CommandParameter="{Binding TaskId}" />
                            </DataTemplate>
                        </atom:DataGridTemplateColumn.CellTemplate>
                    </atom:DataGridTemplateColumn>
                </atom:DataGrid.Columns>
            </atom:DataGrid>
        </atom:Card>
    </Grid>
</UserControl>
