<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="using:Wcs.Desktop.Converters"
             xmlns:vm="using:Wcs.Desktop.ViewModels"
             x:DataType="vm:TaskManagementViewModel"
             x:Class="Wcs.Desktop.Views.TaskManagementView"
             Background="{DynamicResource BgPrimary}">
    <UserControl.Resources>
        <conv:StatusToColorConverter x:Key="StatusToColor" />
    </UserControl.Resources>

    <DockPanel Margin="16">
        <!-- Create Task Panel -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource BgSecondary}" CornerRadius="8" Padding="16" Margin="0,0,0,8">
            <StackPanel Spacing="8">
                <TextBlock Text="Create Task" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" />
                <Grid ColumnDefinitions="Auto,8,*,8,80,8,Auto">
                    <TextBlock Text="Device:" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                    <TextBox Grid.Column="2" PlaceholderText="Device ID" Text="{Binding NewTaskDeviceId}"
                             Width="150" Background="{DynamicResource BgPrimary}" Foreground="{DynamicResource TextPrimary}" />
                    <TextBlock Grid.Column="3" Text="Route:" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                    <TextBox Grid.Column="4" PlaceholderText="Route ID" Text="{Binding NewTaskRouteId}"
                             Width="150" Background="{DynamicResource BgPrimary}" Foreground="{DynamicResource TextPrimary}" />
                    <NumericUpDown Grid.Column="5" Value="{Binding NewTaskPriority}"
                                   Minimum="0" Maximum="10" Width="60" />
                    <Button Grid.Column="6" Content="Create" Command="{Binding CreateTaskCommand}"
                            Classes="Primary"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Task List Header -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource BgCard}" CornerRadius="4,4,0,0" Padding="8,6">
            <Grid ColumnDefinitions="2*,*,0.5*,*,1.5*,1.5*,*">
                <TextBlock Text="Task ID" Foreground="{DynamicResource TextSecondary}" FontWeight="Bold" />
                <TextBlock Grid.Column="1" Text="Status" Foreground="{DynamicResource TextSecondary}" FontWeight="Bold" />
                <TextBlock Grid.Column="2" Text="Pri" Foreground="{DynamicResource TextSecondary}" FontWeight="Bold" />
                <TextBlock Grid.Column="3" Text="Route" Foreground="{DynamicResource TextSecondary}" FontWeight="Bold" />
                <TextBlock Grid.Column="4" Text="Start" Foreground="{DynamicResource TextSecondary}" FontWeight="Bold" />
                <TextBlock Grid.Column="5" Text="End" Foreground="{DynamicResource TextSecondary}" FontWeight="Bold" />
                <TextBlock Grid.Column="6" Text="Actions" Foreground="{DynamicResource TextSecondary}" FontWeight="Bold" />
            </Grid>
        </Border>

        <ScrollViewer>
            <ItemsControl ItemsSource="{Binding Tasks}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="8,6" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1">
                            <Grid ColumnDefinitions="2*,*,0.5*,*,1.5*,1.5*,*">
                                <TextBlock Text="{Binding TaskId}" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <Ellipse Width="10" Height="10"
                                             Fill="{Binding Status, Converter={StaticResource StatusToColor}}" />
                                    <TextBlock Text="{Binding Status}" Foreground="{DynamicResource TextPrimary}" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding Priority}" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="3" Text="{Binding RouteId}" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="4" Text="{Binding StartTime}" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="5" Text="{Binding EndTime}" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                                <Button Grid.Column="6" Content="Cancel"
                                        Command="{Binding $parent[ItemsControl].DataContext.CancelTaskCommand}"
                                        CommandParameter="{Binding TaskId}"
                                        Classes="Danger"
                                        HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
