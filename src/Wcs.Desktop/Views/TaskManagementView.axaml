<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="using:Wcs.Desktop.Converters"
             xmlns:vm="using:Wcs.Desktop.ViewModels"
             xmlns:atom="https://atomui.net"
             x:Class="Wcs.Desktop.Views.TasksView"
             x:DataType="vm:TasksViewModel"
             Background="{DynamicResource BgPrimary}">
    <UserControl.Resources>
        <conv:StatusToColorConverter x:Key="StatusToColor" />
    </UserControl.Resources>

    <DockPanel Margin="16">
        <!-- Toolbar -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource BgSecondary}" CornerRadius="8" Padding="12" Margin="0,0,0,8">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                <TextBlock Text="任务管理" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"
                           VerticalAlignment="Center" />
                <TextBox Grid.Column="1" Watermark="搜索任务..." Text="{Binding SearchText}"
                         Width="200" Margin="16,0,0,0" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="{Binding Tasks.Count, StringFormat='共 {0} 条'}"
                           FontSize="13" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="16,0,0,0" />
                <Button Grid.Column="3" Content="刷新" Command="{Binding RefreshCommand}" Classes="Secondary" Margin="4,0,0,0" />
            </Grid>
        </Border>

        <!-- 任务列表 DataGrid -->
        <atom:DataGrid ItemsSource="{Binding Tasks}" AutoGenerateColumns="False"
                       IsReadOnly="True"
                       CanUserSortColumns="True"
                       CanUserFilterColumns="True"
                       CanUserResizeColumns="True"
                       Margin="0,0,0,8">
            <atom:DataGrid.Columns>
                <atom:DataGridTemplateColumn Header="任务 ID" SortMemberPath="TaskId">
                    <atom:DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding TaskId}" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" Margin="4,0" />
                        </DataTemplate>
                    </atom:DataGridTemplateColumn.CellTemplate>
                </atom:DataGridTemplateColumn>
                <atom:DataGridTemplateColumn Header="设备" SortMemberPath="DeviceId">
                    <atom:DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding DeviceId}" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" Margin="4,0" />
                        </DataTemplate>
                    </atom:DataGridTemplateColumn.CellTemplate>
                </atom:DataGridTemplateColumn>
                <atom:DataGridTemplateColumn Header="状态" SortMemberPath="Status">
                    <atom:DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="4,0">
                                <Ellipse Width="10" Height="10"
                                         Fill="{Binding Status, Converter={StaticResource StatusToColor}}" />
                                <TextBlock Text="{Binding Status}" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </atom:DataGridTemplateColumn.CellTemplate>
                </atom:DataGridTemplateColumn>
                <atom:DataGridTemplateColumn Header="优先级" SortMemberPath="Priority">
                    <atom:DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Priority}" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" Margin="4,0" />
                        </DataTemplate>
                    </atom:DataGridTemplateColumn.CellTemplate>
                </atom:DataGridTemplateColumn>
                <atom:DataGridTemplateColumn Header="等级" SortMemberPath="PriorityLevel">
                    <atom:DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding PriorityLevel}" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" Margin="4,0" />
                        </DataTemplate>
                    </atom:DataGridTemplateColumn.CellTemplate>
                </atom:DataGridTemplateColumn>
                <atom:DataGridTemplateColumn Header="类别" SortMemberPath="Category">
                    <atom:DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Category}" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" Margin="4,0" />
                        </DataTemplate>
                    </atom:DataGridTemplateColumn.CellTemplate>
                </atom:DataGridTemplateColumn>
                <atom:DataGridTemplateColumn Header="路径" SortMemberPath="RouteId">
                    <atom:DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding RouteId}" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" Margin="4,0" />
                        </DataTemplate>
                    </atom:DataGridTemplateColumn.CellTemplate>
                </atom:DataGridTemplateColumn>
                <atom:DataGridTemplateColumn Header="创建时间" SortMemberPath="CreatedTime">
                    <atom:DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding CreatedTime, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" Margin="4,0" />
                        </DataTemplate>
                    </atom:DataGridTemplateColumn.CellTemplate>
                </atom:DataGridTemplateColumn>
                <atom:DataGridTemplateColumn Header="开始时间" SortMemberPath="StartTime">
                    <atom:DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding StartTime, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" Margin="4,0" />
                        </DataTemplate>
                    </atom:DataGridTemplateColumn.CellTemplate>
                </atom:DataGridTemplateColumn>
                <atom:DataGridTemplateColumn Header="结束时间" SortMemberPath="EndTime">
                    <atom:DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding EndTime, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" Margin="4,0" />
                        </DataTemplate>
                    </atom:DataGridTemplateColumn.CellTemplate>
                </atom:DataGridTemplateColumn>
                <atom:DataGridTemplateColumn Header="重试" SortMemberPath="RetryCount">
                    <atom:DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding RetryCount}" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" Margin="4,0" />
                        </DataTemplate>
                    </atom:DataGridTemplateColumn.CellTemplate>
                </atom:DataGridTemplateColumn>
                <atom:DataGridTemplateColumn Header="最大重试" SortMemberPath="MaxRetries">
                    <atom:DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding MaxRetries}" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" Margin="4,0" />
                        </DataTemplate>
                    </atom:DataGridTemplateColumn.CellTemplate>
                </atom:DataGridTemplateColumn>
                <atom:DataGridTemplateColumn Header="错误信息" SortMemberPath="ErrorMessage">
                    <atom:DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" Margin="4,0" />
                        </DataTemplate>
                    </atom:DataGridTemplateColumn.CellTemplate>
                </atom:DataGridTemplateColumn>
                <atom:DataGridTemplateColumn Header="父任务" SortMemberPath="ParentTaskId">
                    <atom:DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding ParentTaskId}" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" Margin="4,0" />
                        </DataTemplate>
                    </atom:DataGridTemplateColumn.CellTemplate>
                </atom:DataGridTemplateColumn>
                <atom:DataGridTemplateColumn Header="依赖" SortMemberPath="Dependencies">
                    <atom:DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Dependencies}" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" Margin="4,0" />
                        </DataTemplate>
                    </atom:DataGridTemplateColumn.CellTemplate>
                </atom:DataGridTemplateColumn>
                <atom:DataGridTemplateColumn Header="操作">
                    <atom:DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" Margin="4,0">
                                <Button Content="取消"
                                        Command="{Binding $parent[atom:DataGrid].DataContext.CancelTaskCommand}"
                                        CommandParameter="{Binding TaskId}"
                                        Classes="Danger" />
                            </StackPanel>
                        </DataTemplate>
                    </atom:DataGridTemplateColumn.CellTemplate>
                </atom:DataGridTemplateColumn>
            </atom:DataGrid.Columns>
        </atom:DataGrid>
    </DockPanel>
</UserControl>
