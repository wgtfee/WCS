<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Wcs.Desktop.ViewModels"
             xmlns:atom="https://atomui.net"
             x:Class="Wcs.Desktop.Views.DashboardView"
             x:DataType="vm:DashboardViewModel"
             Background="{DynamicResource BgPrimary}">
    <ScrollViewer Padding="24">
        <StackPanel Spacing="16">
            <StackPanel Spacing="4">
                <TextBlock Classes="wcs-page-title" Text="System Overview" />
                <TextBlock Classes="wcs-page-subtitle" Text="设备、任务、报警、对象跟踪与资源锁的统一运行概览。" />
            </StackPanel>

            <UniformGrid Columns="5" Rows="1">
                <atom:Card Margin="0,0,6,0" StyleVariant="Outlined" IsHoverable="True"><atom:Statistic Header="Devices" Value="{Binding DeviceCount}" ContentFontSize="26" /></atom:Card>
                <atom:Card Margin="6,0" StyleVariant="Outlined" IsHoverable="True"><atom:Statistic Header="Active Tasks" Value="{Binding ActiveTaskCount}" ContentFontSize="26" /></atom:Card>
                <atom:Card Margin="6,0" StyleVariant="Outlined" IsHoverable="True"><atom:Statistic Header="Active Alarms" Value="{Binding ActiveAlarmCount}" ContentFontSize="26" /></atom:Card>
                <atom:Card Margin="6,0" StyleVariant="Outlined" IsHoverable="True"><atom:Statistic Header="Tracked Objects" Value="{Binding TrackedObjectCount}" ContentFontSize="26" /></atom:Card>
                <atom:Card Margin="6,0,0,0" StyleVariant="Outlined" IsHoverable="True"><atom:Statistic Header="Resource Locks" Value="{Binding ActiveLockCount}" ContentFontSize="26" /></atom:Card>
            </UniformGrid>

            <atom:Card Header="Quick Actions" StyleVariant="Outlined">
                <TextBlock Classes="wcs-page-subtitle" Text="运行入口由左侧导航统一承载，避免在总览页复制控制命令。" />
            </atom:Card>
        </StackPanel>
    </ScrollViewer>
</UserControl>
