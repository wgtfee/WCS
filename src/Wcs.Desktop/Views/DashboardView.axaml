<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Wcs.Desktop.ViewModels"
             xmlns:ctl="using:Wcs.Desktop.Controls"
             x:Class="Wcs.Desktop.Views.DashboardView"
             x:DataType="vm:DashboardViewModel"
             Background="{DynamicResource BgPrimary}">
    <ScrollViewer Padding="24">
        <StackPanel Spacing="16">
            <TextBlock Text="System Overview" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" />

            <!-- Summary Cards -->
            <WrapPanel>
                <ctl:OverviewCard Label="Devices" Value="{Binding DeviceCount}"
                                  BackgroundColor="#1565C0" />
                <ctl:OverviewCard Label="Active Tasks" Value="{Binding ActiveTaskCount}"
                                  BackgroundColor="#2E7D32" />
                <ctl:OverviewCard Label="Active Alarms" Value="{Binding ActiveAlarmCount}"
                                  BackgroundColor="#C62828" />
                <ctl:OverviewCard Label="Tracked Objects" Value="{Binding TrackedObjectCount}"
                                  BackgroundColor="#6A1B9A" />
                <ctl:OverviewCard Label="Resource Locks" Value="{Binding ActiveLockCount}"
                                  BackgroundColor="#E65100" />
            </WrapPanel>

            <!-- Quick Actions -->
            <Border Background="{DynamicResource BgSecondary}" CornerRadius="8" Padding="16" Margin="0,16,0,0">
                <StackPanel Spacing="8">
                    <TextBlock Text="Quick Actions" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
