<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Wcs.Desktop.ViewModels"
             xmlns:atom="https://atomui.net"
             x:Class="Wcs.Desktop.Views.SimulationDeviceOperationsView"
             x:DataType="vm:SimulationVerificationViewModel">
    <ScrollViewer>
        <StackPanel Spacing="14" Margin="0,4,0,10">
            <Border Classes="wcs-boundary-strip">
                <StackPanel Spacing="4">
                    <TextBlock Classes="wcs-section-title" Text="S2/S3 设备级仿真操作" />
                    <TextBlock Classes="wcs-page-subtitle"
                               Text="本页只生成现有 S2 Virtual PLC / S3 Virtual RGV Scenario DSL；生成并注册仍走 S0 Manifest + Content SHA-256，执行仍走 S1 Run。不会直连真实 PLC、RGV 或 HIL。"
                               TextWrapping="Wrap" />
                    <TextBlock Classes="wcs-toolbar-status" Text="{Binding DevicePanelStatusText}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <atom:Card Header="S2 · Virtual PLC DB Block / Fault Injection" StyleVariant="Outlined">
                <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="8">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Block Key" />
                            <atom:LineEdit Text="{Binding DevicePlcBlockKey}" Watermark="PLC1.DB100" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock Text="Block Size(bytes)" />
                            <atom:LineEdit Text="{Binding DevicePlcBlockSizeText}" Watermark="16" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="4">
                            <TextBlock Text="InitialBase64" />
                            <atom:LineEdit Text="{Binding DevicePlcInitialBase64}" Watermark="AAAAAAAA..." />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Spacing="4">
                            <TextBlock Text="Write Offset" />
                            <atom:LineEdit Text="{Binding DevicePlcWriteOffsetText}" Watermark="0" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" Spacing="4">
                            <TextBlock Text="Write DataBase64" />
                            <atom:LineEdit Text="{Binding DevicePlcWriteBase64}" Watermark="AQIDBA==" />
                        </StackPanel>
                        <Grid Grid.Row="1" Grid.Column="2" ColumnDefinitions="*,*" ColumnSpacing="8">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Read Offset" />
                                <atom:LineEdit Text="{Binding DevicePlcReadOffsetText}" Watermark="0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock Text="Read Count" />
                                <atom:LineEdit Text="{Binding DevicePlcReadCountText}" Watermark="4" />
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <atom:Card Header="Fault" StyleVariant="Outlined">
                        <StackPanel Spacing="10">
                            <TextBlock Classes="wcs-page-subtitle" Text="快速选择现有 S2 Fault Kind；也可在 Fault Kind 输入框中填写。" />
                            <WrapPanel Orientation="Horizontal">
                                <atom:Button Margin="0,0,6,6" Content="Disconnect" Command="{Binding SelectDevicePlcFaultKindCommand}" CommandParameter="Disconnect" />
                                <atom:Button Margin="0,0,6,6" Content="Timeout" Command="{Binding SelectDevicePlcFaultKindCommand}" CommandParameter="Timeout" />
                                <atom:Button Margin="0,0,6,6" Content="ReadFailure" Command="{Binding SelectDevicePlcFaultKindCommand}" CommandParameter="ReadFailure" />
                                <atom:Button Margin="0,0,6,6" Content="WriteFailure" Command="{Binding SelectDevicePlcFaultKindCommand}" CommandParameter="WriteFailure" />
                                <atom:Button Margin="0,0,6,6" Content="Stuck" Command="{Binding SelectDevicePlcFaultKindCommand}" CommandParameter="Stuck" />
                                <atom:Button Margin="0,0,6,6" Content="BitFlip" Command="{Binding SelectDevicePlcFaultKindCommand}" CommandParameter="BitFlip" />
                                <atom:Button Margin="0,0,6,6" Content="Jitter" Command="{Binding SelectDevicePlcFaultKindCommand}" CommandParameter="Jitter" />
                                <atom:Button Margin="0,0,6,6" Content="OutOfRange" Command="{Binding SelectDevicePlcFaultKindCommand}" CommandParameter="OutOfRange" />
                            </WrapPanel>

                            <Grid ColumnDefinitions="*,*,*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="8">
                                <StackPanel Spacing="4"><TextBlock Text="Fault Id"/><atom:LineEdit Text="{Binding DevicePlcFaultId}" Watermark="F-PLC-1" /></StackPanel>
                                <StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="Fault Kind"/><atom:LineEdit Text="{Binding DevicePlcFaultKind}" Watermark="BitFlip" /></StackPanel>
                                <StackPanel Grid.Column="2" Spacing="4"><TextBlock Text="Start(ms)"/><atom:LineEdit Text="{Binding DevicePlcFaultStartMsText}" Watermark="30" /></StackPanel>
                                <StackPanel Grid.Column="3" Spacing="4"><TextBlock Text="End(ms)"/><atom:LineEdit Text="{Binding DevicePlcFaultEndMsText}" Watermark="80" /></StackPanel>

                                <StackPanel Grid.Row="1" Spacing="4"><TextBlock Text="Offset"/><atom:LineEdit Text="{Binding DevicePlcFaultOffsetText}" Watermark="0" /></StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="1" Spacing="4"><TextBlock Text="Length"/><atom:LineEdit Text="{Binding DevicePlcFaultLengthText}" Watermark="1" /></StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="2" Spacing="4"><TextBlock Text="BitIndex"/><atom:LineEdit Text="{Binding DevicePlcFaultBitIndexText}" Watermark="0" /></StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="3" Spacing="4"><TextBlock Text="ReplacementBase64"/><atom:LineEdit Text="{Binding DevicePlcReplacementBase64}" Watermark="可选" /></StackPanel>

                                <StackPanel Grid.Row="2" Spacing="4"><TextBlock Text="Jitter Min"/><atom:LineEdit Text="{Binding DevicePlcJitterMinimumText}" Watermark="-1" /></StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="1" Spacing="4"><TextBlock Text="Jitter Max"/><atom:LineEdit Text="{Binding DevicePlcJitterMaximumText}" Watermark="1" /></StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="2" Spacing="4">
                                    <TextBlock Text="支持 Fault Kind" />
                                    <TextBlock Classes="wcs-toolbar-status" Text="{Binding PlcFaultKindsText}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </atom:Card>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <atom:Button Content="生成 PLC DSL" Command="{Binding GenerateDevicePlcScenarioCommand}" />
                        <atom:Button Content="生成并注册 PLC 场景" Command="{Binding GenerateAndRegisterDevicePlcScenarioCommand}" IsEnabled="{Binding CanExecuteSimulation}" />
                    </StackPanel>
                </StackPanel>
            </atom:Card>

            <atom:Card Header="S3 · Virtual RGV Route / Movement / Online / Load" StyleVariant="Outlined">
                <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="8">
                        <StackPanel Spacing="4"><TextBlock Text="Vehicle Id"/><atom:LineEdit Text="{Binding DeviceRgvVehicleId}" Watermark="RGV1" /></StackPanel>
                        <StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="Speed(mm/s)"/><atom:LineEdit Text="{Binding DeviceRgvSpeedMmPerSecondText}" Watermark="1000" /></StackPanel>
                        <StackPanel Grid.Column="2" Spacing="4"><TextBlock Text="Battery(%)"/><atom:LineEdit Text="{Binding DeviceRgvBatteryPercentText}" Watermark="100" /></StackPanel>

                        <StackPanel Grid.Row="1" Spacing="4"><TextBlock Text="Source Node"/><atom:LineEdit Text="{Binding DeviceRgvSourceNodeId}" Watermark="N1" /></StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" Spacing="4"><TextBlock Text="Middle Node"/><atom:LineEdit Text="{Binding DeviceRgvMiddleNodeId}" Watermark="N2" /></StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="2" Spacing="4"><TextBlock Text="Destination Node"/><atom:LineEdit Text="{Binding DeviceRgvDestinationNodeId}" Watermark="N3" /></StackPanel>

                        <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="8">
                            <StackPanel Spacing="4"><TextBlock Text="Segment A"/><atom:LineEdit Text="{Binding DeviceRgvSegmentA}" Watermark="S1" /></StackPanel>
                            <StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="Segment B"/><atom:LineEdit Text="{Binding DeviceRgvSegmentB}" Watermark="S2" /></StackPanel>
                        </Grid>
                        <StackPanel Grid.Row="2" Grid.Column="1" Spacing="4"><TextBlock Text="Segment Length(mm)"/><atom:LineEdit Text="{Binding DeviceRgvSegmentLengthMmText}" Watermark="1000" /></StackPanel>
                        <Grid Grid.Row="2" Grid.Column="2" ColumnDefinitions="*,*" ColumnSpacing="8">
                            <StackPanel Spacing="4"><TextBlock Text="Load Id"/><atom:LineEdit Text="{Binding DeviceRgvLoadId}" Watermark="LOAD1" /></StackPanel>
                            <StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="Offline Duration(ms)"/><atom:LineEdit Text="{Binding DeviceRgvOfflineDurationMsText}" Watermark="500" /></StackPanel>
                        </Grid>
                    </Grid>

                    <TextBlock Classes="wcs-page-subtitle"
                               Text="生成场景包含 segment.define、vehicle.define、load、route.assign、vehicle.advance、vehicle.online.set、unload，并自动验证目标节点、路线完成、电量和卸载状态。"
                               TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <atom:Button Content="生成 RGV DSL" Command="{Binding GenerateDeviceRgvScenarioCommand}" />
                        <atom:Button Content="生成并注册 RGV 场景" Command="{Binding GenerateAndRegisterDeviceRgvScenarioCommand}" IsEnabled="{Binding CanExecuteSimulation}" />
                    </StackPanel>
                </StackPanel>
            </atom:Card>

            <atom:Card Header="当前生成结果" StyleVariant="Outlined">
                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="6">
                    <TextBlock Text="Scenario" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="1" Text="{Binding ScenarioId}" TextWrapping="Wrap" />
                    <TextBlock Grid.Row="1" Text="File" FontWeight="SemiBold" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ScenarioFile}" TextWrapping="Wrap" />
                    <TextBlock Grid.Row="2" Text="说明" FontWeight="SemiBold" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding CheckpointStateText}" TextWrapping="Wrap" />
                </Grid>
            </atom:Card>
        </StackPanel>
    </ScrollViewer>
</UserControl>
