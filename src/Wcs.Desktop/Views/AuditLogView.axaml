<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Wcs.Desktop.ViewModels"
             xmlns:atom="https://atomui.net"
             x:Class="Wcs.Desktop.Views.AuditLogView"
             x:DataType="vm:AuditLogViewModel"
             Background="{DynamicResource BgPrimary}">
    <StackPanel Margin="24" Spacing="16">
        <StackPanel Spacing="4">
            <TextBlock Classes="wcs-page-title" Text="审计日志" />
            <TextBlock Classes="wcs-page-subtitle" Text="安全审计与操作记录。" />
        </StackPanel>
        <atom:Card Header="审计日志" StyleVariant="Outlined">
            <TextBlock Classes="wcs-page-subtitle" Text="页面数据能力尚未接入；本次仅统一表现层，不虚构审计数据源。" TextWrapping="Wrap" />
        </atom:Card>
    </StackPanel>
</UserControl>
