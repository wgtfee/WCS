<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Wcs.Desktop.ViewModels"
             xmlns:atom="https://atomui.net"
             x:Class="Wcs.Desktop.Views.AssetIntelligenceView"
             x:DataType="vm:AssetIntelligenceViewModel">
  <Grid RowDefinitions="Auto,Auto,Auto,*" Margin="24" RowSpacing="14">
    <StackPanel Grid.Row="0" Spacing="8">
      <StackPanel Spacing="4">
        <TextBlock Classes="wcs-page-title" Text="智能运维中心" />
        <TextBlock Classes="wcs-page-subtitle"
                   Text="统一查看资产健康、根因分析、维修建议与 Failure Forecast / RUL。" />
      </StackPanel>
      <Border Classes="wcs-boundary-strip">
        <TextBlock Classes="wcs-page-subtitle" Text="{Binding BoundaryText}" />
      </Border>
    </StackPanel>

    <Grid Grid.Row="1" ColumnDefinitions="*,*,*,*,*" ColumnSpacing="10">
      <atom:Card Grid.Column="0" StyleVariant="Outlined" IsHoverable="True">
        <atom:Statistic Header="资产健康总览" Value="{Binding TrackedAssetCount}" ContentFontSize="26" />
      </atom:Card>
      <atom:Card Grid.Column="1" StyleVariant="Outlined" IsHoverable="True">
        <atom:Statistic Header="退化(&lt;70分)" Value="{Binding DegradedAssetCount}" ContentFontSize="26" />
      </atom:Card>
      <atom:Card Grid.Column="2" StyleVariant="Outlined" IsHoverable="True">
        <atom:Statistic Header="根因" Value="{Binding RootCauseCount}" ContentFontSize="26" />
      </atom:Card>
      <atom:Card Grid.Column="3" StyleVariant="Outlined" IsHoverable="True">
        <atom:Statistic Header="维修动作" Value="{Binding MaintenanceCount}" ContentFontSize="26" />
      </atom:Card>
      <atom:Card Grid.Column="4" StyleVariant="Outlined" IsHoverable="True">
        <atom:Statistic Header="预测结果" Value="{Binding ForecastCount}" ContentFontSize="26" />
      </atom:Card>
    </Grid>

    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="10">
      <atom:Button ButtonType="Primary" Content="刷新智能运维" Command="{Binding RefreshCommand}" />
      <TextBlock Classes="wcs-toolbar-status" Text="{Binding StatusText}" />
    </StackPanel>

    <atom:Card Grid.Row="3" StyleVariant="Outlined">
      <atom:TabControl>
        <atom:TabItem Header="健康分">
          <atom:DataGrid ItemsSource="{Binding HealthAssets}"
                         AutoGenerateColumns="False"
                         IsReadOnly="True"
                         CanUserResizeColumns="True"
                         CanUserSortColumns="True"
                         IsFrameBorderVisible="True"
                         PaginationVisibility="None">
            <atom:DataGrid.Columns>
              <atom:DataGridTextColumn Header="资产" Binding="{Binding AssetId}" Width="160" />
              <atom:DataGridTextColumn Header="健康分" Binding="{Binding HealthScore}" Width="90" />
              <atom:DataGridTextColumn Header="等级" Binding="{Binding Grade}" Width="100" />
              <atom:DataGridTextColumn Header="融合风险" Binding="{Binding FusionRiskScore}" Width="100" />
              <atom:DataGridTextColumn Header="证据来源" Binding="{Binding IndependentSourceCount}" Width="80" />
              <atom:DataGridTextColumn Header="摘要" Binding="{Binding Summary}" Width="*" />
              <atom:DataGridTextColumn Header="计算时间" Binding="{Binding CalculatedAtUtc}" Width="180" />
            </atom:DataGrid.Columns>
          </atom:DataGrid>
        </atom:TabItem>

        <atom:TabItem Header="根因">
          <atom:DataGrid ItemsSource="{Binding RootCauses}"
                         AutoGenerateColumns="False"
                         IsReadOnly="True"
                         CanUserResizeColumns="True"
                         CanUserSortColumns="True"
                         IsFrameBorderVisible="True"
                         PaginationVisibility="None">
            <atom:DataGrid.Columns>
              <atom:DataGridTextColumn Header="分析结论" Binding="{Binding AnalysisId}" Width="190" />
              <atom:DataGridTextColumn Header="触发事件" Binding="{Binding TriggerEventId}" Width="190" />
              <atom:DataGridTextColumn Header="主因" Binding="{Binding PrimaryNodeId}" Width="170" />
              <atom:DataGridTextColumn Header="人工复核" Binding="{Binding ReviewDecision}" Width="100" />
              <atom:DataGridTextColumn Header="创建时间" Binding="{Binding CreatedAtUtc}" Width="*" />
            </atom:DataGrid.Columns>
          </atom:DataGrid>
        </atom:TabItem>

        <atom:TabItem Header="维修动作">
          <atom:DataGrid ItemsSource="{Binding Maintenance}"
                         AutoGenerateColumns="False"
                         IsReadOnly="True"
                         CanUserResizeColumns="True"
                         CanUserSortColumns="True"
                         IsFrameBorderVisible="True"
                         PaginationVisibility="None">
            <atom:DataGrid.Columns>
              <atom:DataGridTextColumn Header="维修建议" Binding="{Binding RecommendationId}" Width="200" />
              <atom:DataGridTextColumn Header="资产" Binding="{Binding AssetId}" Width="140" />
              <atom:DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="100" />
              <atom:DataGridTextColumn Header="摘要" Binding="{Binding Summary}" Width="*" />
              <atom:DataGridTextColumn Header="MES 工单" Binding="{Binding MesWorkOrderNo}" Width="150" />
              <atom:DataGridTextColumn Header="创建时间" Binding="{Binding CreatedAtUtc}" Width="180" />
            </atom:DataGrid.Columns>
          </atom:DataGrid>
        </atom:TabItem>

        <atom:TabItem Header="故障预测 / 剩余寿命">
          <atom:DataGrid ItemsSource="{Binding Forecasts}"
                         AutoGenerateColumns="False"
                         IsReadOnly="True"
                         CanUserResizeColumns="True"
                         CanUserSortColumns="True"
                         IsFrameBorderVisible="True"
                         PaginationVisibility="None">
            <atom:DataGrid.Columns>
              <atom:DataGridTextColumn Header="预测结果" Binding="{Binding ForecastId}" Width="190" />
              <atom:DataGridTextColumn Header="资产" Binding="{Binding AssetId}" Width="140" />
              <atom:DataGridTextColumn Header="24小时预测" Binding="{Binding P24}" Width="90" />
              <atom:DataGridTextColumn Header="72小时预测" Binding="{Binding P72}" Width="90" />
              <atom:DataGridTextColumn Header="168小时预测" Binding="{Binding P168}" Width="90" />
              <atom:DataGridTextColumn Header="剩余寿命中位数(小时)" Binding="{Binding RulMedianHours}" Width="110" />
              <atom:DataGridTextColumn Header="模型" Binding="{Binding ModelVersion}" Width="120" />
              <atom:DataGridTextColumn Header="创建时间" Binding="{Binding CreatedAtUtc}" Width="*" />
            </atom:DataGrid.Columns>
          </atom:DataGrid>
        </atom:TabItem>
      </atom:TabControl>
    </atom:Card>
  </Grid>
</UserControl>
