<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Wcs.Desktop.ViewModels"
             xmlns:atom="https://atomui.net"
             x:Class="Wcs.Desktop.Views.TransportOptimizationView"
             x:DataType="vm:TransportOptimizationViewModel"
             Background="{DynamicResource BgPrimary}">
    <Grid RowDefinitions="Auto,Auto,*" Margin="24" RowSpacing="16">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
            <StackPanel Spacing="4">
                <TextBlock Classes="wcs-page-title" Text="EMS / RGV 充电与运行优化" />
                <TextBlock Classes="wcs-page-subtitle" Text="低电量保护、充电位容量、故障任务转移和车辆效率统计。" />
                <TextBlock Classes="wcs-toolbar-status" Text="{Binding StatusText}" />
            </StackPanel>
            <atom:Button Grid.Column="1" Content="评估充电" Command="{Binding EvaluateChargingCommand}" />
            <atom:Button Grid.Column="2" Content="刷新" Command="{Binding RefreshCommand}" />
        </Grid>

        <UniformGrid Grid.Row="1" Columns="6" Rows="1">
            <atom:Card Margin="0,0,6,0" StyleVariant="Outlined" IsHoverable="True"><atom:Statistic Header="在线车辆" Value="{Binding OnlineVehicleCount}" ContentFontSize="24" /></atom:Card>
            <atom:Card Margin="6,0" StyleVariant="Outlined" IsHoverable="True"><atom:Statistic Header="充电车辆" Value="{Binding ChargingVehicleCount}" ContentFontSize="24" /></atom:Card>
            <atom:Card Margin="6,0" StyleVariant="Outlined" IsHoverable="True"><atom:Statistic Header="低电量车辆" Value="{Binding LowBatteryVehicleCount}" ContentFontSize="24" /></atom:Card>
            <atom:Card Margin="6,0" StyleVariant="Outlined" IsHoverable="True"><atom:Statistic Header="等待任务" Value="{Binding WaitingTaskCount}" ContentFontSize="24" /></atom:Card>
            <atom:Card Margin="6,0" StyleVariant="Outlined" IsHoverable="True"><atom:Statistic Header="车队利用率 %" Value="{Binding FleetUtilizationPercent}" ContentFontSize="24" /></atom:Card>
            <atom:Card Margin="6,0,0,0" StyleVariant="Outlined" IsHoverable="True"><atom:Statistic Header="任务完成率 %" Value="{Binding CompletionRatePercent}" ContentFontSize="24" /></atom:Card>
        </UniformGrid>

        <atom:TabControl Grid.Row="2">
            <atom:TabItem Header="充电站">
                <atom:DataGrid ItemsSource="{Binding Stations}" AutoGenerateColumns="False" IsReadOnly="True" PaginationVisibility="None">
                    <atom:DataGrid.Columns>
                        <atom:DataGridTextColumn Header="充电站" Binding="{Binding StationId}" Width="*" />
                        <atom:DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="*" />
                        <atom:DataGridTextColumn Header="节点" Binding="{Binding NodeId}" Width="130" />
                        <atom:DataGridTextColumn Header="容量" Binding="{Binding Capacity}" Width="80" />
                        <atom:DataGridTextColumn Header="已预留" Binding="{Binding ReservedCount}" Width="90" />
                        <atom:DataGridTextColumn Header="充电中" Binding="{Binding ChargingCount}" Width="90" />
                        <atom:DataGridTextColumn Header="排队" Binding="{Binding QueueLength}" Width="80" />
                        <atom:DataGridCheckBoxColumn Header="在线" Binding="{Binding IsOnline}" Width="80" />
                    </atom:DataGrid.Columns>
                </atom:DataGrid>
            </atom:TabItem>
            <atom:TabItem Header="充电计划">
                <atom:DataGrid ItemsSource="{Binding ChargingPlans}" AutoGenerateColumns="False" IsReadOnly="True" PaginationVisibility="None">
                    <atom:DataGrid.Columns>
                        <atom:DataGridTextColumn Header="计划号" Binding="{Binding PlanId}" Width="*" />
                        <atom:DataGridTextColumn Header="车辆" Binding="{Binding VehicleId}" Width="130" />
                        <atom:DataGridTextColumn Header="充电站" Binding="{Binding StationId}" Width="130" />
                        <atom:DataGridTextColumn Header="状态" Binding="{Binding State}" Width="150" />
                        <atom:DataGridTextColumn Header="起始电量" Binding="{Binding StartBatteryPercent}" Width="100" />
                        <atom:DataGridTextColumn Header="结束电量" Binding="{Binding EndBatteryPercent}" Width="100" />
                        <atom:DataGridCheckBoxColumn Header="临界" Binding="{Binding IsCritical}" Width="80" />
                        <atom:DataGridTextColumn Header="说明" Binding="{Binding Message}" Width="2*" />
                        <atom:DataGridTextColumn Header="更新时间" Binding="{Binding UpdatedAtUtc}" Width="190" />
                    </atom:DataGrid.Columns>
                </atom:DataGrid>
            </atom:TabItem>
            <atom:TabItem Header="故障任务转移">
                <atom:DataGrid ItemsSource="{Binding Reassignments}" AutoGenerateColumns="False" IsReadOnly="True" PaginationVisibility="None">
                    <atom:DataGrid.Columns>
                        <atom:DataGridTextColumn Header="原任务" Binding="{Binding OriginalRequestId}" Width="*" />
                        <atom:DataGridTextColumn Header="接替任务" Binding="{Binding ReplacementRequestId}" Width="*" />
                        <atom:DataGridTextColumn Header="原车辆" Binding="{Binding OriginalVehicleId}" Width="120" />
                        <atom:DataGridTextColumn Header="接替车辆" Binding="{Binding ReplacementVehicleId}" Width="120" />
                        <atom:DataGridTextColumn Header="结果" Binding="{Binding Decision}" Width="170" />
                        <atom:DataGridTextColumn Header="原因" Binding="{Binding Reason}" Width="2*" />
                        <atom:DataGridTextColumn Header="时间" Binding="{Binding OccurredAtUtc}" Width="190" />
                    </atom:DataGrid.Columns>
                </atom:DataGrid>
            </atom:TabItem>
            <atom:TabItem Header="车辆效率">
                <atom:DataGrid ItemsSource="{Binding VehicleMetrics}" AutoGenerateColumns="False" IsReadOnly="True" PaginationVisibility="None">
                    <atom:DataGrid.Columns>
                        <atom:DataGridTextColumn Header="车辆" Binding="{Binding VehicleId}" Width="*" />
                        <atom:DataGridTextColumn Header="类型" Binding="{Binding Kind}" Width="100" />
                        <atom:DataGridTextColumn Header="状态" Binding="{Binding State}" Width="150" />
                        <atom:DataGridTextColumn Header="电量" Binding="{Binding BatteryPercent}" Width="90" />
                        <atom:DataGridTextColumn Header="完成任务" Binding="{Binding CompletedTaskCount}" Width="100" />
                        <atom:DataGridTextColumn Header="故障任务" Binding="{Binding FaultedTaskCount}" Width="100" />
                        <atom:DataGridTextColumn Header="等待任务" Binding="{Binding WaitingTaskCount}" Width="100" />
                        <atom:DataGridTextColumn Header="平均耗时秒" Binding="{Binding AverageCompletedDurationSeconds}" Width="130" />
                    </atom:DataGrid.Columns>
                </atom:DataGrid>
            </atom:TabItem>
        </atom:TabControl>
    </Grid>
</UserControl>
