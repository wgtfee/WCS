<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Wcs.Desktop.ViewModels"
             xmlns:atom="https://atomui.net"
             x:Class="Wcs.Desktop.Views.SimulationTestDataView"
             x:DataType="vm:SimulationVerificationViewModel">
    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="12" Margin="2,4,2,2">
        <Border Grid.Row="0" Classes="wcs-data-summary">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <StackPanel Spacing="3">
                    <TextBlock Classes="wcs-section-title" Text="当前用例真实测试数据" />
                    <TextBlock Classes="wcs-section-caption"
                               Text="这里直接解析当前 Scenario DSL：Action 显示 Payload，Assertion 显示 Expected；读取 Checkpoint 后，右侧显示 Host 返回的真实 StateJson。" />
                    <TextBlock Classes="wcs-toolbar-status" Text="{Binding ScenarioDataStatusText}" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="DATA VIEW" FontSize="11" FontWeight="Bold"
                           Foreground="{DynamicResource AccentBlue}" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <UniformGrid Grid.Row="1" Columns="4" Rows="1">
            <Border Classes="wcs-kpi" Margin="0,0,6,0">
                <StackPanel Spacing="3">
                    <TextBlock Text="ACTION" FontSize="10" Foreground="{DynamicResource TextSecondary}" />
                    <TextBlock Text="{Binding ScenarioActionCount}" FontSize="22" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
            <Border Classes="wcs-kpi" Margin="2,0,4,0">
                <StackPanel Spacing="3">
                    <TextBlock Text="ASSERTION" FontSize="10" Foreground="{DynamicResource TextSecondary}" />
                    <TextBlock Text="{Binding ScenarioAssertionCount}" FontSize="22" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
            <Border Classes="wcs-kpi" Margin="4,0,2,0">
                <StackPanel Spacing="3">
                    <TextBlock Text="DURATION (ms)" FontSize="10" Foreground="{DynamicResource TextSecondary}" />
                    <TextBlock Text="{Binding ScenarioDurationMilliseconds}" FontSize="22" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
            <Border Classes="wcs-kpi" Margin="6,0,0,0">
                <StackPanel Spacing="3">
                    <TextBlock Text="CHECKPOINT STATE" FontSize="10" Foreground="{DynamicResource TextSecondary}" />
                    <TextBlock Text="{Binding CheckpointStateEntryCount}" FontSize="22" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <Grid Grid.Row="2" ColumnDefinitions="3*,2*" ColumnSpacing="12">
            <atom:Card Grid.Column="0" Header="Scenario Action / Assertion 数据" StyleVariant="Outlined">
                <Grid RowDefinitions="Auto,*" RowSpacing="8">
                    <TextBlock Classes="wcs-section-caption"
                               Text="时间轴按照 AtMilliseconds / Order 排序。数据列不是说明文字，而是当前 DSL 内真正参与执行或断言的 JSON 值。" />
                    <atom:DataGrid Grid.Row="1"
                                   ItemsSource="{Binding ScenarioDataRows}"
                                   AutoGenerateColumns="False"
                                   IsReadOnly="True"
                                   PaginationVisibility="None">
                        <atom:DataGrid.Columns>
                            <atom:DataGridTextColumn Header="类型" Binding="{Binding Phase}" Width="70" />
                            <atom:DataGridTextColumn Header="时间(ms)" Binding="{Binding AtMilliseconds}" Width="90" />
                            <atom:DataGridTextColumn Header="Order" Binding="{Binding Order}" Width="65" />
                            <atom:DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="160" />
                            <atom:DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="190" />
                            <atom:DataGridTextColumn Header="Target" Binding="{Binding Target}" Width="170" />
                            <atom:DataGridTextColumn Header="数据类型" Binding="{Binding DataLabel}" Width="90" />
                            <atom:DataGridTextColumn Header="Payload / Expected" Binding="{Binding Data}" Width="*" />
                        </atom:DataGrid.Columns>
                    </atom:DataGrid>
                </Grid>
            </atom:Card>

            <Grid Grid.Column="1" RowDefinitions="3*,2*" RowSpacing="12">
                <atom:Card Grid.Row="0" Header="Checkpoint 状态展开" StyleVariant="Outlined">
                    <Grid RowDefinitions="Auto,*" RowSpacing="8">
                        <TextBlock Classes="wcs-section-caption"
                                   Text="先在“运行控制”选择非终态 Run，再读取 Checkpoint。对象和数组会展开为可检索的状态路径。" />
                        <atom:DataGrid Grid.Row="1"
                                       ItemsSource="{Binding CheckpointStateRows}"
                                       AutoGenerateColumns="False"
                                       IsReadOnly="True"
                                       PaginationVisibility="None">
                            <atom:DataGrid.Columns>
                                <atom:DataGridTextColumn Header="State Path" Binding="{Binding Path}" Width="*" />
                                <atom:DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="90" />
                                <atom:DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="1.3*" />
                            </atom:DataGrid.Columns>
                        </atom:DataGrid>
                    </Grid>
                </atom:Card>

                <atom:Card Grid.Row="1" Header="Raw StateJson" StyleVariant="Outlined">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                        <TextBlock Text="{Binding CheckpointStateJson}"
                                   FontFamily="Consolas"
                                   FontSize="11"
                                   TextWrapping="NoWrap" />
                    </ScrollViewer>
                </atom:Card>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
