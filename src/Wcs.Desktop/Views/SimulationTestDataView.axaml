<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Wcs.Desktop.ViewModels"
             xmlns:atom="https://atomui.net"
             x:Class="Wcs.Desktop.Views.SimulationTestDataView"
             x:DataType="vm:SimulationVerificationViewModel">
    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="12" Margin="2,4,2,2">
        <Border Grid.Row="0" Classes="wcs-data-summary">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <StackPanel Spacing="3">
                    <TextBlock Classes="wcs-section-title" Text="当前用例真实测试数据" />
                    <TextBlock Classes="wcs-section-caption"
                               Text="这里直接解析当前场景数据：执行动作显示真实输入，预期结果显示真实期望值；读取运行检查点后，右侧展示服务端返回的实际状态数据。" />
                    <TextBlock Classes="wcs-toolbar-status" Text="{Binding ScenarioDataStatusText}" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="数据视图" FontSize="11" FontWeight="Bold"
                           Foreground="{DynamicResource AccentBlue}" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <UniformGrid Grid.Row="1" Columns="4" Rows="1">
            <Border Classes="wcs-kpi" Margin="0,0,6,0">
                <StackPanel Spacing="3">
                    <TextBlock Text="执行动作" FontSize="10" Foreground="{DynamicResource TextSecondary}" />
                    <TextBlock Text="{Binding ScenarioActionCount}" FontSize="22" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
            <Border Classes="wcs-kpi" Margin="2,0,4,0">
                <StackPanel Spacing="3">
                    <TextBlock Text="预期结果" FontSize="10" Foreground="{DynamicResource TextSecondary}" />
                    <TextBlock Text="{Binding ScenarioAssertionCount}" FontSize="22" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
            <Border Classes="wcs-kpi" Margin="4,0,2,0">
                <StackPanel Spacing="3">
                    <TextBlock Text="总时长（毫秒）" FontSize="10" Foreground="{DynamicResource TextSecondary}" />
                    <TextBlock Text="{Binding ScenarioDurationMilliseconds}" FontSize="22" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
            <Border Classes="wcs-kpi" Margin="6,0,0,0">
                <StackPanel Spacing="3">
                    <TextBlock Text="检查点状态条目" FontSize="10" Foreground="{DynamicResource TextSecondary}" />
                    <TextBlock Text="{Binding CheckpointStateEntryCount}" FontSize="22" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <Grid Grid.Row="2" ColumnDefinitions="3*,2*" ColumnSpacing="12">
            <atom:Card Grid.Column="0" Header="场景动作与预期结果" StyleVariant="Outlined">
                <Grid RowDefinitions="Auto,*" RowSpacing="8">
                    <TextBlock Classes="wcs-section-caption"
                               Text="按照发生时间和执行顺序排列。主表优先展示中文动作摘要与真实输入/预期数据，便于直接核对测试内容。" />
                    <atom:DataGrid Grid.Row="1"
                                   ItemsSource="{Binding ScenarioDataRows}"
                                   AutoGenerateColumns="False"
                                   IsReadOnly="True"
                                   PaginationVisibility="None">
                        <atom:DataGrid.Columns>
                            <atom:DataGridTextColumn Header="类型" Binding="{Binding Phase}" Width="90" />
                            <atom:DataGridTextColumn Header="发生时间" Binding="{Binding TimeText}" Width="110" />
                            <atom:DataGridTextColumn Header="系统动作 / 检查内容" Binding="{Binding OperationText}" Width="210" />
                            <atom:DataGridTextColumn Header="目标对象" Binding="{Binding Target}" Width="180" />
                            <atom:DataGridTextColumn Header="实际输入 / 预期数据" Binding="{Binding DataSummary}" Width="*" />
                            <atom:DataGridTextColumn Header="记录编号" Binding="{Binding Id}" Width="150" />
                        </atom:DataGrid.Columns>
                    </atom:DataGrid>
                </Grid>
            </atom:Card>

            <Grid Grid.Column="1" RowDefinitions="3*,2*" RowSpacing="12">
                <atom:Card Grid.Row="0" Header="运行检查点状态" StyleVariant="Outlined">
                    <Grid RowDefinitions="Auto,*" RowSpacing="8">
                        <TextBlock Classes="wcs-section-caption"
                                   Text="先在“运行控制”选择未结束的运行记录，再读取检查点。对象和数组会展开为可检索的状态路径。" />
                        <atom:DataGrid Grid.Row="1"
                                       ItemsSource="{Binding CheckpointStateRows}"
                                       AutoGenerateColumns="False"
                                       IsReadOnly="True"
                                       PaginationVisibility="None">
                            <atom:DataGrid.Columns>
                                <atom:DataGridTextColumn Header="状态路径" Binding="{Binding Path}" Width="*" />
                                <atom:DataGridTextColumn Header="数据类型" Binding="{Binding Type}" Width="90" />
                                <atom:DataGridTextColumn Header="当前值" Binding="{Binding Value}" Width="1.3*" />
                            </atom:DataGrid.Columns>
                        </atom:DataGrid>
                    </Grid>
                </atom:Card>

                <atom:Card Grid.Row="1" Header="原始状态数据 · 技术详情" StyleVariant="Outlined">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                        <TextBlock Text="{Binding CheckpointStateJson}"
                                   FontFamily="Consolas"
                                   FontSize="11"
                                   TextWrapping="NoWrap" />
                    </ScrollViewer>
                </atom:Card>
            </Grid>
        </Grid>
    </Grid>
</UserControl>