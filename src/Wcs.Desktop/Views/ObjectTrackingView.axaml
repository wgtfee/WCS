<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="using:Wcs.Desktop.Converters"
             xmlns:vm="using:Wcs.Desktop.ViewModels"
             xmlns:atom="https://atomui.net"
             x:Class="Wcs.Desktop.Views.ObjectsView"
             x:DataType="vm:ObjectsViewModel"
             Background="{DynamicResource BgPrimary}">
    <UserControl.Resources>
        <conv:StatusToColorConverter x:Key="StatusToColor" />
    </UserControl.Resources>

    <Grid RowDefinitions="Auto,Auto,*" Margin="24" RowSpacing="16">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <StackPanel Spacing="4">
                <TextBlock Classes="wcs-page-title" Text="对象跟踪" />
                <TextBlock Classes="wcs-page-subtitle" Text="跟踪对象当前位置、目标位置、状态与更新时间。" />
            </StackPanel>
            <atom:Button Grid.Column="1" Content="刷新" Command="{Binding RefreshCommand}" />
        </Grid>

        <atom:Card Grid.Row="1" StyleVariant="Outlined" IsHoverable="True">
            <atom:Statistic Header="Tracked Objects" Value="{Binding Objects.Count}" ContentFontSize="26" />
        </atom:Card>

        <atom:Card Grid.Row="2" Header="对象列表" StyleVariant="Outlined">
            <atom:DataGrid ItemsSource="{Binding Objects}" AutoGenerateColumns="False" IsReadOnly="True" PaginationVisibility="None" CanUserSortColumns="True" CanUserResizeColumns="True">
                <atom:DataGrid.Columns>
                    <atom:DataGridTextColumn Header="Object ID" Binding="{Binding ObjectId}" Width="2*" />
                    <atom:DataGridTextColumn Header="Current Pos" Binding="{Binding CurrentPosition}" Width="*" />
                    <atom:DataGridTextColumn Header="Target Pos" Binding="{Binding TargetPosition}" Width="*" />
                    <atom:DataGridTemplateColumn Header="Status" SortMemberPath="Status" Width="120">
                        <atom:DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <Ellipse Width="10" Height="10" Fill="{Binding Status, Converter={StaticResource StatusToColor}}" />
                                    <TextBlock Text="{Binding Status}" />
                                </StackPanel>
                            </DataTemplate>
                        </atom:DataGridTemplateColumn.CellTemplate>
                    </atom:DataGridTemplateColumn>
                    <atom:DataGridTextColumn Header="Last Update" Binding="{Binding UpdateTime}" Width="180" />
                </atom:DataGrid.Columns>
            </atom:DataGrid>
        </atom:Card>
    </Grid>
</UserControl>
