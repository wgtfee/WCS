<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="using:Wcs.Desktop.Converters"
             xmlns:vm="using:Wcs.Desktop.ViewModels"
             x:DataType="vm:ObjectTrackingViewModel"
             x:Class="Wcs.Desktop.Views.ObjectTrackingView"
             Background="{DynamicResource BgPrimary}">
    <UserControl.Resources>
        <conv:StatusToColorConverter x:Key="StatusToColor" />
    </UserControl.Resources>

    <DockPanel Margin="16">
        <!-- Toolbar -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource BgSecondary}" CornerRadius="8" Padding="12" Margin="0,0,0,8">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <TextBlock Text="Tracked Objects" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"
                           VerticalAlignment="Center" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                    <Button Content="Refresh" Command="{Binding RefreshCommand}"
                            Classes="Secondary"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Object List Header -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource BgCard}" CornerRadius="4,4,0,0" Padding="8,6">
            <Grid ColumnDefinitions="2*,*,*,*,1.5*">
                <TextBlock Text="Object ID" Foreground="{DynamicResource TextSecondary}" FontWeight="Bold" />
                <TextBlock Grid.Column="1" Text="Current Pos" Foreground="{DynamicResource TextSecondary}" FontWeight="Bold" />
                <TextBlock Grid.Column="2" Text="Target Pos" Foreground="{DynamicResource TextSecondary}" FontWeight="Bold" />
                <TextBlock Grid.Column="3" Text="Status" Foreground="{DynamicResource TextSecondary}" FontWeight="Bold" />
                <TextBlock Grid.Column="4" Text="Last Update" Foreground="{DynamicResource TextSecondary}" FontWeight="Bold" />
            </Grid>
        </Border>

        <ScrollViewer>
            <ItemsControl ItemsSource="{Binding Objects}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="8,6" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1">
                            <Grid ColumnDefinitions="2*,*,*,*,1.5*">
                                <TextBlock Text="{Binding ObjectId}" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding CurrentPosition}" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{Binding TargetPosition}" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <Ellipse Width="10" Height="10"
                                             Fill="{Binding Status, Converter={StaticResource StatusToColor}}" />
                                    <TextBlock Text="{Binding Status}" Foreground="{DynamicResource TextPrimary}" />
                                </StackPanel>
                                <TextBlock Grid.Column="4" Text="{Binding UpdateTime}" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
