<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Wcs.Desktop.ViewModels"
             x:Class="Wcs.Desktop.Views.ShadowDecisionView"
             x:DataType="vm:ShadowDecisionViewModel">
  <ScrollViewer>
    <StackPanel Margin="24" Spacing="16">
      <TextBlock Text="IDI-P3 Shadow Decision Center" FontSize="24" FontWeight="SemiBold" />
      <TextBlock Text="{Binding SafetyText}" TextWrapping="Wrap" Opacity="0.75" />

      <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="12">
        <Border Grid.Column="0" Padding="12" BorderThickness="1" CornerRadius="6"><StackPanel><TextBlock Text="Proposals"/><TextBlock Text="{Binding ProposalCount}" FontSize="26" FontWeight="SemiBold"/></StackPanel></Border>
        <Border Grid.Column="1" Padding="12" BorderThickness="1" CornerRadius="6"><StackPanel><TextBlock Text="Pending"/><TextBlock Text="{Binding PendingCount}" FontSize="26" FontWeight="SemiBold"/></StackPanel></Border>
        <Border Grid.Column="2" Padding="12" BorderThickness="1" CornerRadius="6"><StackPanel><TextBlock Text="Blocked"/><TextBlock Text="{Binding BlockedCount}" FontSize="26" FontWeight="SemiBold"/></StackPanel></Border>
        <Border Grid.Column="3" Padding="12" BorderThickness="1" CornerRadius="6"><StackPanel><TextBlock Text="Approved"/><TextBlock Text="{Binding ApprovedCount}" FontSize="26" FontWeight="SemiBold"/></StackPanel></Border>
      </Grid>

      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Content="刷新 Proposal" Command="{Binding RefreshCommand}" />
        <Button Content="读取选中详情" Command="{Binding LoadSelectedCommand}" />
        <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" TextWrapping="Wrap" />
      </StackPanel>

      <DataGrid ItemsSource="{Binding Proposals}" SelectedItem="{Binding SelectedProposal}" AutoGenerateColumns="False" IsReadOnly="True" MinHeight="260">
        <DataGrid.Columns>
          <DataGridTextColumn Header="ProposalId" Binding="{Binding ProposalId}" Width="210" />
          <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="180" />
          <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="120" />
          <DataGridTextColumn Header="Action" Binding="{Binding Candidate.Action}" Width="180" />
          <DataGridTextColumn Header="Score" Binding="{Binding Candidate.Score}" Width="90" />
          <DataGridTextColumn Header="Created" Binding="{Binding CreatedAtUtc}" Width="180" />
          <DataGridTextColumn Header="Expires" Binding="{Binding ExpiresAtUtc}" Width="180" />
        </DataGrid.Columns>
      </DataGrid>

      <Border Padding="12" BorderThickness="1" CornerRadius="6">
        <StackPanel Spacing="8">
          <TextBlock Text="Proposal Evidence / Explanation" FontSize="18" FontWeight="SemiBold" />
          <TextBlock Text="{Binding DetailText}" TextWrapping="Wrap" />
          <DataGrid ItemsSource="{Binding Constraints}" AutoGenerateColumns="False" IsReadOnly="True" MinHeight="120">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Constraint" Binding="{Binding Code}" Width="160" />
              <DataGridCheckBoxColumn Header="Passed" Binding="{Binding Passed}" Width="80" />
              <DataGridTextColumn Header="Reason" Binding="{Binding Reason}" Width="*" />
              <DataGridTextColumn Header="Evidence" Binding="{Binding EvidenceHash}" Width="220" />
            </DataGrid.Columns>
          </DataGrid>
        </StackPanel>
      </Border>

      <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
        <Border Grid.Column="0" Padding="12" BorderThickness="1" CornerRadius="6">
          <StackPanel Spacing="8">
            <TextBlock Text="人工治理动作" FontSize="18" FontWeight="SemiBold" />
            <TextBox PlaceholderText="Actor" Text="{Binding Actor}" />
            <TextBox PlaceholderText="Reason（必填）" Text="{Binding Reason}" AcceptsReturn="True" MinHeight="60" />
            <TextBox PlaceholderText="CorrelationId" Text="{Binding CorrelationId}" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Content="Approve（仅治理状态）" Command="{Binding ApproveCommand}" />
              <Button Content="Reject" Command="{Binding RejectCommand}" />
            </StackPanel>
          </StackPanel>
        </Border>

        <Border Grid.Column="1" Padding="12" BorderThickness="1" CornerRadius="6">
          <StackPanel Spacing="8">
            <TextBlock Text="实际 Outcome 回填" FontSize="18" FontWeight="SemiBold" />
            <TextBox PlaceholderText="OutcomeType" Text="{Binding OutcomeType}" />
            <TextBox PlaceholderText="ActualReference / 工单 / 任务 / 现场记录" Text="{Binding ActualReference}" />
            <TextBox PlaceholderText="ActualBenefit（可选）" Text="{Binding ActualBenefit}" />
            <TextBox PlaceholderText="Evidence SHA-256" Text="{Binding OutcomeEvidenceHash}" />
            <Button Content="记录 Outcome（不反向控制）" Command="{Binding RecordOutcomeCommand}" />
          </StackPanel>
        </Border>
      </Grid>

      <TextBlock Text="审批审计" FontSize="18" FontWeight="SemiBold" />
      <DataGrid ItemsSource="{Binding Approvals}" AutoGenerateColumns="False" IsReadOnly="True" MinHeight="140">
        <DataGrid.Columns>
          <DataGridTextColumn Header="From" Binding="{Binding FromStatus}" Width="100" />
          <DataGridTextColumn Header="To" Binding="{Binding ToStatus}" Width="100" />
          <DataGridTextColumn Header="Actor" Binding="{Binding Actor}" Width="120" />
          <DataGridTextColumn Header="Reason" Binding="{Binding Reason}" Width="*" />
          <DataGridTextColumn Header="UTC" Binding="{Binding Utc}" Width="180" />
          <DataGridTextColumn Header="Correlation" Binding="{Binding CorrelationId}" Width="180" />
        </DataGrid.Columns>
      </DataGrid>
    </StackPanel>
  </ScrollViewer>
</UserControl>
