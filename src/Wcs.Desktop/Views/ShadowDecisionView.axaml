<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Wcs.Desktop.ViewModels"
             xmlns:atom="https://atomui.net"
             x:Class="Wcs.Desktop.Views.ShadowDecisionView"
             x:DataType="vm:ShadowDecisionViewModel">
  <ScrollViewer>
    <StackPanel Margin="24" Spacing="16">
      <StackPanel Spacing="4">
        <TextBlock Classes="wcs-page-title" Text="影子决策建议中心" />
        <TextBlock Classes="wcs-page-subtitle"
                   Text="Proposal、Constraint、Explanation、人工治理与 Outcome 的统一审查入口。" />
      </StackPanel>

      <Border Classes="wcs-boundary-strip">
        <TextBlock Classes="wcs-page-subtitle" Text="{Binding SafetyText}" />
      </Border>

      <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="12">
        <atom:Card Grid.Column="0" StyleVariant="Outlined" IsHoverable="True">
          <atom:Statistic Header="建议总数" Value="{Binding ProposalCount}" ContentFontSize="28" />
        </atom:Card>
        <atom:Card Grid.Column="1" StyleVariant="Outlined" IsHoverable="True">
          <atom:Statistic Header="待审批" Value="{Binding PendingCount}" ContentFontSize="28" />
        </atom:Card>
        <atom:Card Grid.Column="2" StyleVariant="Outlined" IsHoverable="True">
          <atom:Statistic Header="已拦截" Value="{Binding BlockedCount}" ContentFontSize="28" />
        </atom:Card>
        <atom:Card Grid.Column="3" StyleVariant="Outlined" IsHoverable="True">
          <atom:Statistic Header="已批准" Value="{Binding ApprovedCount}" ContentFontSize="28" />
        </atom:Card>
      </Grid>

      <StackPanel Orientation="Horizontal" Spacing="10">
        <atom:Button ButtonType="Primary" Content="刷新 Proposal" Command="{Binding RefreshCommand}" />
        <atom:Button Content="读取选中详情" Command="{Binding LoadSelectedCommand}" />
        <TextBlock Classes="wcs-toolbar-status" Text="{Binding StatusText}" />
      </StackPanel>

      <atom:Card Header="影子决策建议" StyleVariant="Outlined">
        <atom:DataGrid ItemsSource="{Binding Proposals}"
                       SelectedItem="{Binding SelectedProposal}"
                       SelectionMode="Single"
                       SelectTriggerType="Cell"
                       AutoGenerateColumns="False"
                       IsReadOnly="True"
                       CanUserResizeColumns="True"
                       CanUserSortColumns="True"
                       IsFrameBorderVisible="True"
                       PaginationVisibility="None"
                       Height="300">
          <atom:DataGrid.Columns>
            <atom:DataGridTextColumn Header="建议ID" Binding="{Binding ProposalId}" Width="210" />
            <atom:DataGridTextColumn Header="类型" Binding="{Binding Type}" Width="180" />
            <atom:DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="120" />
            <atom:DataGridTextColumn Header="建议动作" Binding="{Binding Candidate.Action}" Width="180" />
            <atom:DataGridTextColumn Header="得分" Binding="{Binding Candidate.Score}" Width="90" />
<atom:DataGridTextColumn Header="创建时间" Binding="{Binding CreatedAtUtc}" Width="180" />
                            <atom:DataGridTextColumn Header="过期时间" Binding="{Binding ExpiresAtUtc}" Width="*" />
          </atom:DataGrid.Columns>
        </atom:DataGrid>
      </atom:Card>

      <atom:Card Header="建议证据 / 说明" StyleVariant="Outlined">
        <StackPanel Spacing="10">
          <TextBlock Classes="wcs-page-subtitle" Text="{Binding DetailText}" />
          <atom:DataGrid ItemsSource="{Binding Constraints}"
                         AutoGenerateColumns="False"
                         IsReadOnly="True"
                         CanUserResizeColumns="True"
                         IsFrameBorderVisible="True"
                         PaginationVisibility="None"
                         Height="160">
            <atom:DataGrid.Columns>
<atom:DataGridTextColumn Header="约束条件" Binding="{Binding Code}" Width="160" />
                                    <atom:DataGridCheckBoxColumn Header="是否通过" Binding="{Binding Passed}" Width="80" />
                                    <atom:DataGridTextColumn Header="原因" Binding="{Binding Reason}" Width="*" />
                                    <atom:DataGridTextColumn Header="证据哈希" Binding="{Binding EvidenceHash}" Width="220" />
            </atom:DataGrid.Columns>
          </atom:DataGrid>
        </StackPanel>
      </atom:Card>

      <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
        <atom:Card Grid.Column="0" Header="人工治理动作" StyleVariant="Outlined">
          <StackPanel Spacing="10">
            <atom:LineEdit PlaceholderText="操作人" Text="{Binding Actor}" />
            <atom:LineEdit PlaceholderText="Reason（必填）"
                           Text="{Binding Reason}"
                           AcceptsReturn="True"
                           MinHeight="70" />
            <atom:LineEdit PlaceholderText="关联ID" Text="{Binding CorrelationId}" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <atom:Button ButtonType="Primary"
                           Content="批准（仅治理状态）"
                           Command="{Binding ApproveCommand}" />
              <atom:Button Content="驳回" Command="{Binding RejectCommand}" />
            </StackPanel>
          </StackPanel>
        </atom:Card>

        <atom:Card Grid.Column="1" Header="实际 Outcome 回填" StyleVariant="Outlined">
          <StackPanel Spacing="10">
            <atom:LineEdit PlaceholderText="结果类型" Text="{Binding OutcomeType}" />
            <atom:LineEdit PlaceholderText="实际参考（工单 / 任务 / 现场记录）"
                           Text="{Binding ActualReference}" />
            <atom:LineEdit PlaceholderText="实际收益（可选）" Text="{Binding ActualBenefit}" />
            <atom:LineEdit PlaceholderText="证据 SHA-256" Text="{Binding OutcomeEvidenceHash}" />
            <atom:Button ButtonType="Primary"
                         Content="记录 Outcome（不反向控制）"
                         Command="{Binding RecordOutcomeCommand}" />
          </StackPanel>
        </atom:Card>
      </Grid>

      <atom:Card Header="审批审计" StyleVariant="Outlined">
        <atom:DataGrid ItemsSource="{Binding Approvals}"
                       AutoGenerateColumns="False"
                       IsReadOnly="True"
                       CanUserResizeColumns="True"
                       CanUserSortColumns="True"
                       IsFrameBorderVisible="True"
                       PaginationVisibility="None"
                       Height="180">
          <atom:DataGrid.Columns>
<atom:DataGridTextColumn Header="原状态" Binding="{Binding FromStatus}" Width="100" />
                                <atom:DataGridTextColumn Header="新状态" Binding="{Binding ToStatus}" Width="100" />
                                <atom:DataGridTextColumn Header="操作人" Binding="{Binding Actor}" Width="120" />
                                <atom:DataGridTextColumn Header="原因" Binding="{Binding Reason}" Width="*" />
                                <atom:DataGridTextColumn Header="UTC 时间" Binding="{Binding Utc}" Width="180" />
                                <atom:DataGridTextColumn Header="关联ID" Binding="{Binding CorrelationId}" Width="180" />
          </atom:DataGrid.Columns>
        </atom:DataGrid>
      </atom:Card>
    </StackPanel>
  </ScrollViewer>
</UserControl>
