<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Wcs.Desktop.ViewModels"
             xmlns:atom="https://atomui.net"
             x:Class="Wcs.Desktop.Views.ShadowDecisionView"
             x:DataType="vm:ShadowDecisionViewModel">
  <ScrollViewer>
    <StackPanel Margin="24" Spacing="16">
      <StackPanel Spacing="4">
        <TextBlock Classes="wcs-page-title" Text="IDI-P3 Shadow Decision Center" />
        <TextBlock Classes="wcs-page-subtitle"
                   Text="Proposal、Constraint、Explanation、人工治理与 Outcome 的统一审查入口。" />
      </StackPanel>

      <Border Classes="wcs-boundary-strip">
        <TextBlock Classes="wcs-page-subtitle" Text="{Binding SafetyText}" />
      </Border>

      <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="12">
        <atom:Card Grid.Column="0" StyleVariant="Outlined" IsHoverable="True">
          <atom:Statistic Header="Proposals" Value="{Binding ProposalCount}" ContentFontSize="28" />
        </atom:Card>
        <atom:Card Grid.Column="1" StyleVariant="Outlined" IsHoverable="True">
          <atom:Statistic Header="Pending" Value="{Binding PendingCount}" ContentFontSize="28" />
        </atom:Card>
        <atom:Card Grid.Column="2" StyleVariant="Outlined" IsHoverable="True">
          <atom:Statistic Header="Blocked" Value="{Binding BlockedCount}" ContentFontSize="28" />
        </atom:Card>
        <atom:Card Grid.Column="3" StyleVariant="Outlined" IsHoverable="True">
          <atom:Statistic Header="Approved" Value="{Binding ApprovedCount}" ContentFontSize="28" />
        </atom:Card>
      </Grid>

      <StackPanel Orientation="Horizontal" Spacing="10">
        <atom:Button ButtonType="Primary" Content="刷新 Proposal" Command="{Binding RefreshCommand}" />
        <atom:Button Content="读取选中详情" Command="{Binding LoadSelectedCommand}" />
        <TextBlock Classes="wcs-toolbar-status" Text="{Binding StatusText}" />
      </StackPanel>

      <atom:Card Header="Decision Proposals" StyleVariant="Outlined">
        <atom:DataGrid ItemsSource="{Binding Proposals}"
                       SelectedItem="{Binding SelectedProposal}"
                       SelectionMode="Single"
                       SelectTriggerType="Cell"
                       AutoGenerateColumns="False"
                       IsReadOnly="True"
                       CanUserResizeColumns="True"
                       CanUserSortColumns="True"
                       IsFrameBorderVisible="True"
                       PaginationVisibility="None"
                       Height="300">
          <atom:DataGrid.Columns>
            <atom:DataGridTextColumn Header="ProposalId" Binding="{Binding ProposalId}" Width="210" />
            <atom:DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="180" />
            <atom:DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="120" />
            <atom:DataGridTextColumn Header="Action" Binding="{Binding Candidate.Action}" Width="180" />
            <atom:DataGridTextColumn Header="Score" Binding="{Binding Candidate.Score}" Width="90" />
            <atom:DataGridTextColumn Header="Created" Binding="{Binding CreatedAtUtc}" Width="180" />
            <atom:DataGridTextColumn Header="Expires" Binding="{Binding ExpiresAtUtc}" Width="*" />
          </atom:DataGrid.Columns>
        </atom:DataGrid>
      </atom:Card>

      <atom:Card Header="Proposal Evidence / Explanation" StyleVariant="Outlined">
        <StackPanel Spacing="10">
          <TextBlock Classes="wcs-page-subtitle" Text="{Binding DetailText}" />
          <atom:DataGrid ItemsSource="{Binding Constraints}"
                         AutoGenerateColumns="False"
                         IsReadOnly="True"
                         CanUserResizeColumns="True"
                         IsFrameBorderVisible="True"
                         PaginationVisibility="None"
                         Height="160">
            <atom:DataGrid.Columns>
              <atom:DataGridTextColumn Header="Constraint" Binding="{Binding Code}" Width="160" />
              <atom:DataGridCheckBoxColumn Header="Passed" Binding="{Binding Passed}" Width="80" />
              <atom:DataGridTextColumn Header="Reason" Binding="{Binding Reason}" Width="*" />
              <atom:DataGridTextColumn Header="Evidence" Binding="{Binding EvidenceHash}" Width="220" />
            </atom:DataGrid.Columns>
          </atom:DataGrid>
        </StackPanel>
      </atom:Card>

      <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
        <atom:Card Grid.Column="0" Header="人工治理动作" StyleVariant="Outlined">
          <StackPanel Spacing="10">
            <atom:LineEdit PlaceholderText="Actor" Text="{Binding Actor}" />
            <atom:LineEdit PlaceholderText="Reason（必填）"
                           Text="{Binding Reason}"
                           AcceptsReturn="True"
                           MinHeight="70" />
            <atom:LineEdit PlaceholderText="CorrelationId" Text="{Binding CorrelationId}" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <atom:Button ButtonType="Primary"
                           Content="Approve（仅治理状态）"
                           Command="{Binding ApproveCommand}" />
              <atom:Button Content="Reject" Command="{Binding RejectCommand}" />
            </StackPanel>
          </StackPanel>
        </atom:Card>

        <atom:Card Grid.Column="1" Header="实际 Outcome 回填" StyleVariant="Outlined">
          <StackPanel Spacing="10">
            <atom:LineEdit PlaceholderText="OutcomeType" Text="{Binding OutcomeType}" />
            <atom:LineEdit PlaceholderText="ActualReference / 工单 / 任务 / 现场记录"
                           Text="{Binding ActualReference}" />
            <atom:LineEdit PlaceholderText="ActualBenefit（可选）" Text="{Binding ActualBenefit}" />
            <atom:LineEdit PlaceholderText="Evidence SHA-256" Text="{Binding OutcomeEvidenceHash}" />
            <atom:Button ButtonType="Primary"
                         Content="记录 Outcome（不反向控制）"
                         Command="{Binding RecordOutcomeCommand}" />
          </StackPanel>
        </atom:Card>
      </Grid>

      <atom:Card Header="审批审计" StyleVariant="Outlined">
        <atom:DataGrid ItemsSource="{Binding Approvals}"
                       AutoGenerateColumns="False"
                       IsReadOnly="True"
                       CanUserResizeColumns="True"
                       CanUserSortColumns="True"
                       IsFrameBorderVisible="True"
                       PaginationVisibility="None"
                       Height="180">
          <atom:DataGrid.Columns>
            <atom:DataGridTextColumn Header="From" Binding="{Binding FromStatus}" Width="100" />
            <atom:DataGridTextColumn Header="To" Binding="{Binding ToStatus}" Width="100" />
            <atom:DataGridTextColumn Header="Actor" Binding="{Binding Actor}" Width="120" />
            <atom:DataGridTextColumn Header="Reason" Binding="{Binding Reason}" Width="*" />
            <atom:DataGridTextColumn Header="UTC" Binding="{Binding Utc}" Width="180" />
            <atom:DataGridTextColumn Header="Correlation" Binding="{Binding CorrelationId}" Width="180" />
          </atom:DataGrid.Columns>
        </atom:DataGrid>
      </atom:Card>
    </StackPanel>
  </ScrollViewer>
</UserControl>
