<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Wcs.Desktop.ViewModels"
             xmlns:atom="https://atomui.net"
             x:Class="Wcs.Desktop.Views.DigitalTwinOptimizerView"
             x:DataType="vm:DigitalTwinOptimizerViewModel">
  <ScrollViewer>
    <StackPanel Margin="24" Spacing="16">
      <StackPanel Spacing="4"><TextBlock Classes="wcs-page-title" Text="IDI-P5 Digital Twin Optimizer"/><TextBlock Classes="wcs-page-subtitle" Text="只读查看策略实验、结果 Evidence 与 Pareto 多目标排名。"/></StackPanel>
      <Border Classes="wcs-boundary-strip"><TextBlock Classes="wcs-page-subtitle" Text="{Binding SafetyText}"/></Border>
      <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
        <atom:Card Header="Environment" StyleVariant="Outlined"><TextBlock Text="{Binding Environment}" FontSize="18" FontWeight="SemiBold"/></atom:Card>
        <atom:Card Grid.Column="1" Header="Mode / Safety" StyleVariant="Outlined"><TextBlock Text="{Binding ModeText}" TextWrapping="Wrap"/></atom:Card>
        <atom:Card Grid.Column="2" Header="SQL Evidence Recovery" StyleVariant="Outlined"><TextBlock Text="{Binding RecoveryText}" TextWrapping="Wrap"/></atom:Card>
      </Grid>
      <StackPanel Orientation="Horizontal" Spacing="8"><atom:Button Content="刷新只读 Evidence" Command="{Binding RefreshCommand}"/><TextBlock Classes="wcs-toolbar-status" Text="{Binding StatusText}"/></StackPanel>

      <atom:Card Header="最近实验" StyleVariant="Outlined">
        <StackPanel Spacing="8"><atom:Statistic Header="Experiments" Value="{Binding Experiments.Count}" ContentFontSize="24"/>
          <atom:DataGrid ItemsSource="{Binding Experiments}" AutoGenerateColumns="False" IsReadOnly="True" PaginationVisibility="None">
            <atom:DataGrid.Columns><atom:DataGridTextColumn Header="ExperimentId" Binding="{Binding ExperimentId}" Width="220"/><atom:DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/><atom:DataGridTextColumn Header="DefinitionHash" Binding="{Binding DefinitionHash}" Width="*"/><atom:DataGridTextColumn Header="Created" Binding="{Binding CreatedAtUtc}" Width="180"/></atom:DataGrid.Columns>
          </atom:DataGrid>
        </StackPanel>
      </atom:Card>

      <atom:Card Header="实验结果查询（只读）" StyleVariant="Outlined">
        <StackPanel Spacing="8">
          <StackPanel Orientation="Horizontal" Spacing="8"><atom:LineEdit Width="320" Watermark="ExperimentId" Text="{Binding ExperimentId}"/><atom:Button Content="读取 Result" Command="{Binding LoadResultCommand}"/></StackPanel>
          <TextBlock Text="{Binding ResultText}" TextWrapping="Wrap"/><TextBlock Classes="wcs-toolbar-status" Text="{Binding EvidenceHash}"/>
        </StackPanel>
      </atom:Card>

      <atom:Card Header="Pareto / 多目标排名" StyleVariant="Outlined">
        <atom:DataGrid ItemsSource="{Binding Ranking}" AutoGenerateColumns="False" IsReadOnly="True" PaginationVisibility="None">
          <atom:DataGrid.Columns><atom:DataGridTextColumn Header="PolicyId" Binding="{Binding PolicyId}" Width="200"/><atom:DataGridTextColumn Header="Score" Binding="{Binding Score}" Width="100"/><atom:DataGridCheckBoxColumn Header="Pareto" Binding="{Binding ParetoEfficient}" Width="90"/><atom:DataGridCheckBoxColumn Header="Hard Constraint" Binding="{Binding HardConstraintQualified}" Width="120"/><atom:DataGridTextColumn Header="Successful Runs" Binding="{Binding SuccessfulRuns}" Width="110"/><atom:DataGridTextColumn Header="PolicyHash" Binding="{Binding PolicyHash}" Width="*"/></atom:DataGrid.Columns>
        </atom:DataGrid>
      </atom:Card>
    </StackPanel>
  </ScrollViewer>
</UserControl>
