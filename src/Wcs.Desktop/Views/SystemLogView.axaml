<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Wcs.Desktop.ViewModels"
             xmlns:atom="https://atomui.net"
             x:Class="Wcs.Desktop.Views.SysLogView"
             x:DataType="vm:SysLogViewModel"
             Background="{DynamicResource BgPrimary}">
    <StackPanel Margin="24" Spacing="16">
        <StackPanel Spacing="4">
            <TextBlock Classes="wcs-page-title" Text="系统日志" />
            <TextBlock Classes="wcs-page-subtitle" Text="操作系统与服务运行日志。" />
        </StackPanel>
        <atom:Card Header="System Log" StyleVariant="Outlined">
            <TextBlock Classes="wcs-page-subtitle" Text="页面数据能力尚未接入；本次仅统一表现层，不虚构系统日志数据源。" TextWrapping="Wrap" />
        </atom:Card>
    </StackPanel>
</UserControl>
