<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Wcs.Desktop.ViewModels"
             xmlns:atom="https://atomui.net"
             x:Class="Wcs.Desktop.Views.FeatureCenterView"
             x:DataType="vm:FeatureCenterViewModel">
  <ScrollViewer>
    <StackPanel Margin="24" Spacing="16">
      <StackPanel Spacing="4">
        <TextBlock Classes="wcs-page-title" Text="IDI-P2 Feature Center" />
        <TextBlock Classes="wcs-page-subtitle"
                   Text="特征定义、Schema、Snapshot 与 Point-in-Time Dataset 的统一追踪入口。" />
      </StackPanel>

      <Border Classes="wcs-boundary-strip">
        <TextBlock Classes="wcs-page-subtitle" Text="{Binding SafetyText}" />
      </Border>

      <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
        <atom:Card Grid.Column="0" StyleVariant="Outlined" IsHoverable="True">
          <atom:Statistic Header="Feature Definitions"
                          Value="{Binding FeatureCount}"
                          ContentFontSize="28" />
        </atom:Card>
        <atom:Card Grid.Column="1" StyleVariant="Outlined" IsHoverable="True">
          <atom:Statistic Header="Entity Types"
                          Value="{Binding EntityTypeCount}"
                          ContentFontSize="28" />
        </atom:Card>
        <atom:Card Grid.Column="2" StyleVariant="Outlined" IsHoverable="True">
          <atom:Statistic Header="Sources"
                          Value="{Binding SourceCount}"
                          ContentFontSize="28" />
        </atom:Card>
      </Grid>

      <StackPanel Orientation="Horizontal" Spacing="10">
        <atom:Button ButtonType="Primary"
                     Content="刷新 Feature Definitions"
                     Command="{Binding RefreshCommand}" />
        <TextBlock Classes="wcs-toolbar-status" Text="{Binding StatusText}" />
      </StackPanel>

      <atom:Card Header="Feature Definitions" StyleVariant="Outlined">
        <atom:DataGrid ItemsSource="{Binding Features}"
                       AutoGenerateColumns="False"
                       IsReadOnly="True"
                       CanUserResizeColumns="True"
                       CanUserSortColumns="True"
                       IsFrameBorderVisible="True"
                       PaginationVisibility="None"
                       Height="330">
          <atom:DataGrid.Columns>
            <atom:DataGridTextColumn Header="FeatureId" Binding="{Binding FeatureId}" Width="180" />
            <atom:DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="180" />
            <atom:DataGridTextColumn Header="Entity" Binding="{Binding EntityType}" Width="120" />
            <atom:DataGridTextColumn Header="Type" Binding="{Binding DataType}" Width="100" />
            <atom:DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="180" />
            <atom:DataGridTextColumn Header="Aggregation" Binding="{Binding Aggregation}" Width="120" />
            <atom:DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="90" />
            <atom:DataGridTextColumn Header="Owner" Binding="{Binding Owner}" Width="120" />
            <atom:DataGridTextColumn Header="DefinitionHash" Binding="{Binding DefinitionHash}" Width="*" />
          </atom:DataGrid.Columns>
        </atom:DataGrid>
      </atom:Card>

      <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
        <atom:Card Grid.Column="0" Header="Schema 查询" StyleVariant="Outlined">
          <StackPanel Spacing="10">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <atom:LineEdit Width="180" PlaceholderText="SchemaId" Text="{Binding SchemaId}" />
              <atom:LineEdit Width="120" PlaceholderText="Version" Text="{Binding SchemaVersion}" />
              <atom:Button Content="读取" Command="{Binding LoadSchemaCommand}" />
            </StackPanel>
            <TextBlock Classes="wcs-page-subtitle" Text="{Binding SchemaText}" />
          </StackPanel>
        </atom:Card>

        <atom:Card Grid.Column="1" Header="Snapshot 查询" StyleVariant="Outlined">
          <StackPanel Spacing="10">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <atom:LineEdit Width="300" PlaceholderText="SnapshotId" Text="{Binding SnapshotId}" />
              <atom:Button Content="读取" Command="{Binding LoadSnapshotCommand}" />
            </StackPanel>
            <TextBlock Classes="wcs-page-subtitle" Text="{Binding SnapshotText}" />
          </StackPanel>
        </atom:Card>
      </Grid>

      <atom:Card Header="Point-in-Time Dataset 查询" StyleVariant="Outlined">
        <StackPanel Spacing="10">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <atom:LineEdit Width="220" PlaceholderText="DatasetId" Text="{Binding DatasetId}" />
            <atom:LineEdit Width="120" PlaceholderText="Version" Text="{Binding DatasetVersion}" />
            <atom:Button Content="读取" Command="{Binding LoadDatasetCommand}" />
          </StackPanel>
          <TextBlock Classes="wcs-page-subtitle" Text="{Binding DatasetText}" />
        </StackPanel>
      </atom:Card>
    </StackPanel>
  </ScrollViewer>
</UserControl>
