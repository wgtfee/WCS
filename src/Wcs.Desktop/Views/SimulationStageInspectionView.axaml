<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Wcs.Desktop.ViewModels"
             xmlns:atom="https://atomui.net"
             x:Class="Wcs.Desktop.Views.SimulationStageInspectionView"
             x:DataType="vm:SimulationVerificationViewModel">
    <atom:TabControl>
        <atom:TabItem Header="可视化场景编辑">
            <ScrollViewer>
                <StackPanel Spacing="14" Margin="0,4,0,10">
                    <atom:Card Header="可重复场景公共参数" StyleVariant="Outlined">
                        <StackPanel Spacing="10">
                            <TextBlock Text="所有可视化场景最终仍生成严格 Scenario DSL，并经过 S0 Manifest + Content SHA-256 治理；不会直接调用生产 PLC/RGV/Traffic/HIL。" TextWrapping="Wrap" />
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Seed（非 0 Int64）" />
                                    <atom:LineEdit Text="{Binding VisualScenarioSeedText}" Watermark="20260811" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="4">
                                    <TextBlock Text="StartTimeUtc" />
                                    <atom:LineEdit Text="{Binding VisualScenarioStartUtcText}" Watermark="2026-08-11T00:00:00+00:00" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Classes="wcs-toolbar-status" Text="{Binding VisualEditorStatusText}" TextWrapping="Wrap" />
                        </StackPanel>
                    </atom:Card>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
                        <StackPanel Spacing="14">
                            <atom:Card Header="S2 · PLC 断线 / 自动恢复" StyleVariant="Outlined">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="模拟 PLC 在指定虚拟时间断开并在持续窗口结束后恢复，同时自动生成 offline/online 断言。" TextWrapping="Wrap" />
                                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                                        <StackPanel Spacing="4"><TextBlock Text="PLC Id"/><atom:LineEdit Text="{Binding VisualPlcId}" Watermark="PLC1" /></StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="断线时间(ms)"/><atom:LineEdit Text="{Binding VisualPlcDisconnectAtMsText}" Watermark="1000" /></StackPanel>
                                        <StackPanel Grid.Column="2" Spacing="4"><TextBlock Text="持续时间(ms)"/><atom:LineEdit Text="{Binding VisualPlcOutageDurationMsText}" Watermark="9000" /></StackPanel>
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <atom:Button Content="生成 DSL" Command="{Binding GenerateVisualPlcScenarioCommand}" />
                                        <atom:Button Content="生成并注册" Command="{Binding GenerateAndRegisterVisualPlcScenarioCommand}" IsEnabled="{Binding CanExecuteSimulation}" />
                                    </StackPanel>
                                </StackPanel>
                            </atom:Card>

                            <atom:Card Header="S3/S4 · 双 RGV 路权死锁" StyleVariant="Outlined">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="两辆 RGV 分别持有一个区段后交叉申请对方区段，构造 wait-for graph 并执行 deadlock detection。" TextWrapping="Wrap" />
                                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="8">
                                        <StackPanel Spacing="4"><TextBlock Text="车辆 A"/><atom:LineEdit Text="{Binding VisualTrafficVehicleA}" Watermark="RGV1" /></StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="车辆 B"/><atom:LineEdit Text="{Binding VisualTrafficVehicleB}" Watermark="RGV2" /></StackPanel>
                                        <StackPanel Grid.Row="1" Spacing="4"><TextBlock Text="区段 A"/><atom:LineEdit Text="{Binding VisualTrafficSegmentA}" Watermark="S1" /></StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="1" Spacing="4"><TextBlock Text="区段 B"/><atom:LineEdit Text="{Binding VisualTrafficSegmentB}" Watermark="S2" /></StackPanel>
                                        <StackPanel Grid.Row="2" Spacing="4"><TextBlock Text="路权租约(ms)"/><atom:LineEdit Text="{Binding VisualTrafficLeaseMsText}" Watermark="10000" /></StackPanel>
                                        <StackPanel Grid.Row="2" Grid.Column="1" Spacing="4"><TextBlock Text="死锁检测时间(ms)"/><atom:LineEdit Text="{Binding VisualTrafficDetectAtMsText}" Watermark="30" /></StackPanel>
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <atom:Button Content="生成 DSL" Command="{Binding GenerateVisualTrafficScenarioCommand}" />
                                        <atom:Button Content="生成并注册" Command="{Binding GenerateAndRegisterVisualTrafficScenarioCommand}" IsEnabled="{Binding CanExecuteSimulation}" />
                                    </StackPanel>
                                </StackPanel>
                            </atom:Card>

                            <atom:Card Header="S5 · MES / 外部接口超时恢复" StyleVariant="Outlined">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="对虚拟 External Endpoint 注入 Timeout 窗口，第一次请求失败后按 Retry Delay 重试，并验证请求成功、Attempts、Circuit 与故障结束。" TextWrapping="Wrap" />
                                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="8">
                                        <StackPanel Spacing="4"><TextBlock Text="Endpoint"/><atom:LineEdit Text="{Binding VisualExternalEndpointId}" Watermark="MES1" /></StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="Operation"/><atom:LineEdit Text="{Binding VisualExternalOperation}" Watermark="Order.Push" /></StackPanel>
                                        <StackPanel Grid.Row="1" Spacing="4"><TextBlock Text="故障窗口(ms)"/><atom:LineEdit Text="{Binding VisualExternalFaultDurationMsText}" Watermark="50" /></StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="1" Spacing="4"><TextBlock Text="Timeout(ms)"/><atom:LineEdit Text="{Binding VisualExternalTimeoutMsText}" Watermark="20" /></StackPanel>
                                        <StackPanel Grid.Row="2" Spacing="4"><TextBlock Text="Retry Delay(ms)"/><atom:LineEdit Text="{Binding VisualExternalRetryDelayMsText}" Watermark="60" /></StackPanel>
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <atom:Button Content="生成 DSL" Command="{Binding GenerateVisualExternalScenarioCommand}" />
                                        <atom:Button Content="生成并注册" Command="{Binding GenerateAndRegisterVisualExternalScenarioCommand}" IsEnabled="{Binding CanExecuteSimulation}" />
                                    </StackPanel>
                                </StackPanel>
                            </atom:Card>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Spacing="14">
                            <atom:Card Header="S6 · 电机/设备 Health + RUL 退化" StyleVariant="Outlined">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="用虚拟时间构造持续退化曲线、两阶段 Forecast Oracle 与 ObservedFailure，验证特征、预测契约、RUL 与故障概率单调性。" TextWrapping="Wrap" />
                                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="8">
                                        <StackPanel Spacing="4"><TextBlock Text="Asset Id"/><atom:LineEdit Text="{Binding VisualHealthAssetId}" Watermark="RGV-S6" /></StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="退化时长(h)"/><atom:LineEdit Text="{Binding VisualHealthDurationHoursText}" Watermark="72" /></StackPanel>
                                        <StackPanel Grid.Row="1" Spacing="4"><TextBlock Text="目标 Health Score"/><atom:LineEdit Text="{Binding VisualHealthTargetScoreText}" Watermark="30" /></StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="1" Spacing="4"><TextBlock Text="目标 Fusion Risk"/><atom:LineEdit Text="{Binding VisualHealthTargetRiskText}" Watermark="0.95" /></StackPanel>
                                        <StackPanel Grid.Row="2" Spacing="4"><TextBlock Text="目标 RUL Median(h)"/><atom:LineEdit Text="{Binding VisualHealthRulMedianHoursText}" Watermark="100" /></StackPanel>
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <atom:Button Content="生成 DSL" Command="{Binding GenerateVisualHealthScenarioCommand}" />
                                        <atom:Button Content="生成并注册" Command="{Binding GenerateAndRegisterVisualHealthScenarioCommand}" IsEnabled="{Binding CanExecuteSimulation}" />
                                    </StackPanel>
                                </StackPanel>
                            </atom:Card>

                            <atom:Card Header="S7 · 全链任务恢复 / 幂等" StyleVariant="Outlined">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="贯穿虚拟 PLC、RGV、Traffic、External、Health 的 Mission，最后重复 ACK 验证一致性与 exactly-once。" TextWrapping="Wrap" />
                                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="8">
                                        <StackPanel Spacing="4"><TextBlock Text="MissionId"/><atom:LineEdit Text="{Binding VisualRecoveryMissionId}" Watermark="M1" /></StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="PLC Block"/><atom:LineEdit Text="{Binding VisualRecoveryPlcBlockKey}" Watermark="PLC1.DB100" /></StackPanel>
                                        <StackPanel Grid.Row="1" Spacing="4"><TextBlock Text="VehicleId"/><atom:LineEdit Text="{Binding VisualRecoveryVehicleId}" Watermark="RGV1" /></StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="1" Spacing="4"><TextBlock Text="LoadId"/><atom:LineEdit Text="{Binding VisualRecoveryLoadId}" Watermark="LOAD1" /></StackPanel>
                                        <StackPanel Grid.Row="2" Spacing="4"><TextBlock Text="Source Node"/><atom:LineEdit Text="{Binding VisualRecoverySourceNodeId}" Watermark="N1" /></StackPanel>
                                        <StackPanel Grid.Row="2" Grid.Column="1" Spacing="4"><TextBlock Text="Middle Node"/><atom:LineEdit Text="{Binding VisualRecoveryMiddleNodeId}" Watermark="N2" /></StackPanel>
                                        <StackPanel Grid.Row="3" Spacing="4"><TextBlock Text="Destination Node"/><atom:LineEdit Text="{Binding VisualRecoveryDestinationNodeId}" Watermark="N3" /></StackPanel>
                                        <StackPanel Grid.Row="3" Grid.Column="1" Spacing="4"><TextBlock Text="External Endpoint"/><atom:LineEdit Text="{Binding VisualRecoveryExternalEndpointId}" Watermark="MES1" /></StackPanel>
                                        <StackPanel Grid.Row="4" Spacing="4"><TextBlock Text="Health Asset"/><atom:LineEdit Text="{Binding VisualRecoveryHealthAssetId}" Watermark="ASSET1" /></StackPanel>
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <atom:Button Content="生成 DSL" Command="{Binding GenerateVisualRecoveryScenarioCommand}" />
                                        <atom:Button Content="生成并注册" Command="{Binding GenerateAndRegisterVisualRecoveryScenarioCommand}" IsEnabled="{Binding CanExecuteSimulation}" />
                                    </StackPanel>
                                </StackPanel>
                            </atom:Card>

                            <atom:Card Header="当前生成结果" StyleVariant="Outlined">
                                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="6">
                                    <TextBlock Text="Scenario" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="1" Text="{Binding ScenarioId}" TextWrapping="Wrap" />
                                    <TextBlock Grid.Row="1" Text="File" FontWeight="SemiBold" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ScenarioFile}" TextWrapping="Wrap" />
                                    <TextBlock Grid.Row="2" Text="说明" FontWeight="SemiBold" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding CheckpointStateText}" TextWrapping="Wrap" />
                                </Grid>
                            </atom:Card>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </atom:TabItem>

        <atom:TabItem Header="预置场景 / 分层检查">
            <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="12">
                <atom:Card Grid.Row="0" Header="受治理预置场景库" StyleVariant="Outlined">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <StackPanel Spacing="4">
                            <TextBlock Text="无需手写 DSL：载入模板后，仍必须回到“场景治理”执行 Manifest + SHA-256 校验注册，之后才能创建 Run。" TextWrapping="Wrap" />
                            <TextBlock Classes="wcs-toolbar-status" Text="模板只描述 Simulation State 行为，不直接操作生产 PLC、RGV、Traffic、MES 或真实 HIL；S8 为 Capacity/HIL-readiness 证据层，保持只读检查。" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <atom:Button Content="S2 PLC 断线恢复" Command="{Binding LoadPlcDisconnectPresetCommand}" IsEnabled="{Binding CanExecuteSimulation}" />
                            <atom:Button Content="S3/S4 双 RGV 死锁" Command="{Binding LoadTrafficDeadlockPresetCommand}" IsEnabled="{Binding CanExecuteSimulation}" />
                            <atom:Button Content="S5 外部超时恢复" Command="{Binding LoadExternalTimeoutPresetCommand}" IsEnabled="{Binding CanExecuteSimulation}" />
                            <atom:Button Content="S6 Health/RUL 72h" Command="{Binding LoadHealthRulPresetCommand}" IsEnabled="{Binding CanExecuteSimulation}" />
                            <atom:Button Content="S7 全链恢复/幂等" Command="{Binding LoadIntegratedRecoveryPresetCommand}" IsEnabled="{Binding CanExecuteSimulation}" />
                        </StackPanel>
                    </Grid>
                </atom:Card>

                <Grid Grid.Row="1" ColumnDefinitions="2*,*" ColumnSpacing="12">
                    <atom:Card Header="S2～S8 分层只读检查" StyleVariant="Outlined">
                        <StackPanel Spacing="8">
                            <TextBlock Text="{Binding InspectionTitle}" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock Classes="wcs-toolbar-status" Text="{Binding InspectionStatusText}" TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,6,0,0">
                                <atom:Button Content="读取状态" Command="{Binding InspectStatusCommand}" IsEnabled="{Binding CanExecuteSimulation}" />
                                <atom:Button Content="主要对象" Command="{Binding InspectPrimaryCommand}" IsEnabled="{Binding CanExecuteSimulation}" />
                                <atom:Button Content="异常 / 占用" Command="{Binding InspectSecondaryCommand}" IsEnabled="{Binding CanExecuteSimulation}" />
                                <atom:Button Content="审计" Command="{Binding InspectAuditCommand}" IsEnabled="{Binding CanExecuteSimulation}" />
                            </StackPanel>
                        </StackPanel>
                    </atom:Card>

                    <atom:Card Grid.Column="1" Header="当前上下文" StyleVariant="Outlined">
                        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="6">
                            <TextBlock Text="Stage" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="1" Text="{Binding SelectedStage.Id}" />
                            <TextBlock Grid.Row="1" Text="Run" FontWeight="SemiBold" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedRun.RunId}" TextWrapping="Wrap" />
                            <TextBlock Grid.Row="2" Text="Run Status" FontWeight="SemiBold" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedRun.StatusText}" />
                        </Grid>
                    </atom:Card>
                </Grid>

                <UniformGrid Grid.Row="2" Columns="7" Rows="1">
                    <atom:Card Margin="0,0,3,0" StyleVariant="Outlined"><StackPanel><TextBlock FontWeight="SemiBold" Text="S2 PLC"/><TextBlock Classes="wcs-toolbar-status" Text="Blocks / Faults / Audit" TextWrapping="Wrap"/></StackPanel></atom:Card>
                    <atom:Card Margin="3,0" StyleVariant="Outlined"><StackPanel><TextBlock FontWeight="SemiBold" Text="S3 RGV"/><TextBlock Classes="wcs-toolbar-status" Text="Vehicles / Occupancy / Audit" TextWrapping="Wrap"/></StackPanel></atom:Card>
                    <atom:Card Margin="3,0" StyleVariant="Outlined"><StackPanel><TextBlock FontWeight="SemiBold" Text="S4 Traffic"/><TextBlock Classes="wcs-toolbar-status" Text="Reservations / Deadlocks / Audit" TextWrapping="Wrap"/></StackPanel></atom:Card>
                    <atom:Card Margin="3,0" StyleVariant="Outlined"><StackPanel><TextBlock FontWeight="SemiBold" Text="S5 External"/><TextBlock Classes="wcs-toolbar-status" Text="Requests / Faults / Audit" TextWrapping="Wrap"/></StackPanel></atom:Card>
                    <atom:Card Margin="3,0" StyleVariant="Outlined"><StackPanel><TextBlock FontWeight="SemiBold" Text="S6 Health"/><TextBlock Classes="wcs-toolbar-status" Text="Assets / Health Audit" TextWrapping="Wrap"/></StackPanel></atom:Card>
                    <atom:Card Margin="3,0" StyleVariant="Outlined"><StackPanel><TextBlock FontWeight="SemiBold" Text="S7 Recovery"/><TextBlock Classes="wcs-toolbar-status" Text="Missions / Recovery Audit" TextWrapping="Wrap"/></StackPanel></atom:Card>
                    <atom:Card Margin="3,0,0,0" StyleVariant="Outlined"><StackPanel><TextBlock FontWeight="SemiBold" Text="S8 Capacity"/><TextBlock Classes="wcs-toolbar-status" Text="8h / 24h Readiness Status" TextWrapping="Wrap"/></StackPanel></atom:Card>
                </UniformGrid>

                <atom:Card Grid.Row="3" Header="Inspection JSON 扁平视图" StyleVariant="Outlined">
                    <atom:DataGrid ItemsSource="{Binding InspectionItems}" AutoGenerateColumns="False" IsReadOnly="True" PaginationVisibility="None">
                        <atom:DataGrid.Columns>
                            <atom:DataGridTextColumn Header="Path" Binding="{Binding Path}" Width="2*" />
                            <atom:DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="3*" />
                        </atom:DataGrid.Columns>
                    </atom:DataGrid>
                </atom:Card>
            </Grid>
        </atom:TabItem>
    </atom:TabControl>
</UserControl>