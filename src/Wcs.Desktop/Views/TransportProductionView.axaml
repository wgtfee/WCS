<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Wcs.Desktop.ViewModels"
             xmlns:atom="https://atomui.net"
             x:Class="Wcs.Desktop.Views.TransportProductionView"
             x:DataType="vm:TransportProductionViewModel"
             Background="{DynamicResource BgPrimary}">
    <Grid RowDefinitions="Auto,Auto,*" Margin="24" RowSpacing="16">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="10">
            <StackPanel Spacing="4">
                <TextBlock Classes="wcs-page-title" Text="EMS / RGV 生产级调度" />
                <TextBlock Classes="wcs-page-subtitle" Text="任务竞争、动态优先级、站点拥堵、单轨会车、故障接管与趋势回放。" />
                <TextBlock Classes="wcs-toolbar-status" Text="{Binding StatusText}" />
            </StackPanel>
            <atom:Button Grid.Column="1" Content="无副作用试算" Command="{Binding DryRunCommand}" />
            <atom:Button Grid.Column="2" Content="立即派单" Command="{Binding DispatchCycleCommand}" />
            <atom:Button Grid.Column="3" Content="故障接管评估" Command="{Binding EvaluateTakeoverCommand}" />
            <atom:Button Grid.Column="4" Content="刷新" Command="{Binding RefreshCommand}" />
        </Grid>

        <UniformGrid Grid.Row="1" Columns="7" Rows="1">
            <atom:Card Margin="0,0,5,0" StyleVariant="Outlined" IsHoverable="True"><atom:Statistic Header="参数版本" Value="{Binding TuningVersion}" ContentFontSize="22" /></atom:Card>
            <atom:Card Margin="5,0" StyleVariant="Outlined" IsHoverable="True"><atom:Statistic Header="队列任务" Value="{Binding QueuedTaskCount}" ContentFontSize="22" /></atom:Card>
            <atom:Card Margin="5,0" StyleVariant="Outlined" IsHoverable="True"><atom:Statistic Header="等待站点" Value="{Binding WaitingForStationCount}" ContentFontSize="22" /></atom:Card>
            <atom:Card Margin="5,0" StyleVariant="Outlined" IsHoverable="True"><atom:Statistic Header="等待交通" Value="{Binding WaitingForTrafficCount}" ContentFontSize="22" /></atom:Card>
            <atom:Card Margin="5,0" StyleVariant="Outlined" IsHoverable="True"><atom:Statistic Header="单轨许可" Value="{Binding ActiveSingleTrackPermitCount}" ContentFontSize="22" /></atom:Card>
            <atom:Card Margin="5,0" StyleVariant="Outlined" IsHoverable="True"><atom:Statistic Header="站点最高占用 %" Value="{Binding MaximumStationUtilizationPercent}" ContentFontSize="22" /></atom:Card>
            <atom:Card Margin="5,0,0,0" StyleVariant="Outlined" IsHoverable="True"><atom:Statistic Header="平均车队利用率 %" Value="{Binding AverageFleetUtilizationPercent}" ContentFontSize="22" /></atom:Card>
        </UniformGrid>

        <atom:TabControl Grid.Row="2">
            <atom:TabItem Header="生产队列">
                <atom:DataGrid ItemsSource="{Binding Queue}" AutoGenerateColumns="False" IsReadOnly="True" PaginationVisibility="None">
                    <atom:DataGrid.Columns>
                        <atom:DataGridTextColumn Header="任务" Binding="{Binding ProductionRequest.Request.RequestId}" Width="*" />
                        <atom:DataGridTextColumn Header="状态" Binding="{Binding State}" Width="140" />
                        <atom:DataGridTextColumn Header="动态优先级" Binding="{Binding EffectivePriority}" Width="110" />
                        <atom:DataGridTextColumn Header="目标站点" Binding="{Binding ProductionRequest.DestinationStationId}" Width="120" />
                        <atom:DataGridTextColumn Header="车辆" Binding="{Binding AssignedVehicleId}" Width="110" />
                        <atom:DataGridTextColumn Header="尝试次数" Binding="{Binding AttemptCount}" Width="90" />
                        <atom:DataGridTextColumn Header="原因" Binding="{Binding LastReason}" Width="2*" />
                        <atom:DataGridTextColumn Header="更新时间" Binding="{Binding UpdatedAtUtc}" Width="180" />
                    </atom:DataGrid.Columns>
                </atom:DataGrid>
            </atom:TabItem>
            <atom:TabItem Header="站点拥堵">
                <atom:DataGrid ItemsSource="{Binding Stations}" AutoGenerateColumns="False" IsReadOnly="True" PaginationVisibility="None">
                    <atom:DataGrid.Columns>
                        <atom:DataGridTextColumn Header="站点" Binding="{Binding StationId}" Width="*" />
                        <atom:DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="*" />
                        <atom:DataGridTextColumn Header="容量" Binding="{Binding Capacity}" Width="80" />
                        <atom:DataGridTextColumn Header="占用" Binding="{Binding OccupiedCount}" Width="80" />
                        <atom:DataGridTextColumn Header="排队" Binding="{Binding QueuedTaskCount}" Width="80" />
                        <atom:DataGridTextColumn Header="利用率 %" Binding="{Binding UtilizationPercent}" Width="100" />
                        <atom:DataGridCheckBoxColumn Header="启用" Binding="{Binding Enabled}" Width="80" />
                    </atom:DataGrid.Columns>
                </atom:DataGrid>
            </atom:TabItem>
            <atom:TabItem Header="单轨会车">
                <atom:DataGrid ItemsSource="{Binding SingleTracks}" AutoGenerateColumns="False" IsReadOnly="True" PaginationVisibility="None">
                    <atom:DataGrid.Columns>
                        <atom:DataGridTextColumn Header="区段" Binding="{Binding Definition.SectionId}" Width="*" />
                        <atom:DataGridTextColumn Header="名称" Binding="{Binding Definition.Name}" Width="*" />
                        <atom:DataGridTextColumn Header="当前方向" Binding="{Binding ActiveDirection}" Width="120" />
                        <atom:DataGridTextColumn Header="活动许可" Binding="{Binding ActivePermits.Count}" Width="100" />
                        <atom:DataGridTextColumn Header="等待车辆" Binding="{Binding WaitingRequests.Count}" Width="100" />
                        <atom:DataGridTextColumn Header="同向上限" Binding="{Binding Definition.MaximumSameDirectionConvoy}" Width="100" />
                    </atom:DataGrid.Columns>
                </atom:DataGrid>
            </atom:TabItem>
            <atom:TabItem Header="调度试算">
                <atom:DataGrid ItemsSource="{Binding DryRunItems}" AutoGenerateColumns="False" IsReadOnly="True" PaginationVisibility="None">
                    <atom:DataGrid.Columns>
                        <atom:DataGridTextColumn Header="排名" Binding="{Binding Rank}" Width="70" />
                        <atom:DataGridTextColumn Header="任务" Binding="{Binding RequestId}" Width="*" />
                        <atom:DataGridTextColumn Header="动态优先级" Binding="{Binding EffectivePriority}" Width="110" />
                        <atom:DataGridCheckBoxColumn Header="站点准入" Binding="{Binding StationAdmitted}" Width="100" />
                        <atom:DataGridTextColumn Header="解释" Binding="{Binding Explanation}" Width="2*" />
                    </atom:DataGrid.Columns>
                </atom:DataGrid>
            </atom:TabItem>
            <atom:TabItem Header="决策回放">
                <atom:DataGrid ItemsSource="{Binding Decisions}" AutoGenerateColumns="False" IsReadOnly="True" PaginationVisibility="None">
                    <atom:DataGrid.Columns>
                        <atom:DataGridTextColumn Header="任务" Binding="{Binding RequestId}" Width="*" />
                        <atom:DataGridTextColumn Header="优先级" Binding="{Binding EffectivePriority}" Width="90" />
                        <atom:DataGridTextColumn Header="结果" Binding="{Binding ResultState}" Width="140" />
                        <atom:DataGridTextColumn Header="车辆" Binding="{Binding VehicleId}" Width="100" />
                        <atom:DataGridTextColumn Header="原因" Binding="{Binding Reason}" Width="2*" />
                        <atom:DataGridTextColumn Header="时间" Binding="{Binding OccurredAtUtc}" Width="180" />
                    </atom:DataGrid.Columns>
                </atom:DataGrid>
            </atom:TabItem>
            <atom:TabItem Header="故障接管">
                <atom:DataGrid ItemsSource="{Binding Takeovers}" AutoGenerateColumns="False" IsReadOnly="True" PaginationVisibility="None">
                    <atom:DataGrid.Columns>
                        <atom:DataGridTextColumn Header="任务" Binding="{Binding RequestId}" Width="*" />
                        <atom:DataGridTextColumn Header="故障车辆" Binding="{Binding VehicleId}" Width="110" />
                        <atom:DataGridTextColumn Header="接替车辆" Binding="{Binding ReplacementVehicleId}" Width="110" />
                        <atom:DataGridTextColumn Header="结果" Binding="{Binding Decision}" Width="170" />
                        <atom:DataGridTextColumn Header="说明" Binding="{Binding Message}" Width="2*" />
                    </atom:DataGrid.Columns>
                </atom:DataGrid>
            </atom:TabItem>
            <atom:TabItem Header="运行趋势">
                <atom:DataGrid ItemsSource="{Binding TrendPoints}" AutoGenerateColumns="False" IsReadOnly="True" PaginationVisibility="None">
                    <atom:DataGrid.Columns>
                        <atom:DataGridTextColumn Header="时间" Binding="{Binding CapturedAtUtc}" Width="180" />
                        <atom:DataGridTextColumn Header="队列" Binding="{Binding QueueLength}" Width="80" />
                        <atom:DataGridTextColumn Header="等站点" Binding="{Binding WaitingForStationCount}" Width="90" />
                        <atom:DataGridTextColumn Header="等交通" Binding="{Binding WaitingForTrafficCount}" Width="90" />
                        <atom:DataGridTextColumn Header="故障车辆" Binding="{Binding FaultedVehicleCount}" Width="90" />
                        <atom:DataGridTextColumn Header="单轨等待" Binding="{Binding SingleTrackWaitingCount}" Width="90" />
                        <atom:DataGridTextColumn Header="站点最高 %" Binding="{Binding MaximumStationUtilizationPercent}" Width="110" />
                        <atom:DataGridTextColumn Header="车队利用率 %" Binding="{Binding FleetUtilizationPercent}" Width="110" />
                        <atom:DataGridTextColumn Header="完成率 %" Binding="{Binding CompletionRatePercent}" Width="100" />
                    </atom:DataGrid.Columns>
                </atom:DataGrid>
            </atom:TabItem>
        </atom:TabControl>
    </Grid>
</UserControl>
