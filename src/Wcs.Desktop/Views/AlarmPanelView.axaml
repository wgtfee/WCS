<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="using:Wcs.Desktop.Converters"
             xmlns:vm="using:Wcs.Desktop.ViewModels"
             x:Class="Wcs.Desktop.Views.AlarmsView"
             x:DataType="vm:AlarmsViewModel"
             Background="{DynamicResource BgPrimary}">
    <UserControl.Resources>
        <conv:StatusToColorConverter x:Key="StatusToColor" />
    </UserControl.Resources>

    <DockPanel Margin="16">
        <!-- Toolbar -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource BgSecondary}" CornerRadius="8" Padding="12" Margin="0,0,0,8">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                <TextBlock Text="报警管理" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding Alarms.Count, StringFormat='共 {0} 条'}"
                           FontSize="13" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="16,0,0,0" />
                <Button Grid.Column="3" Content="刷新" Command="{Binding RefreshCommand}" Classes="Secondary" Margin="4,0,0,0" />
            </Grid>
        </Border>

        <!-- 报警列表 DataGrid -->
        <DataGrid ItemsSource="{Binding Alarms}" AutoGenerateColumns="False"
                  IsReadOnly="True"
                  Background="{DynamicResource BgStatusBar}"
                  BorderBrush="{DynamicResource BorderColor}"
                  RowHeight="36"
                  Margin="0,0,0,8">
            <DataGrid.Columns>
                <DataGridTextColumn Header="报警 ID" Binding="{Binding AlarmId}" Width="SizeToCells" />
                <DataGridTextColumn Header="报警码" Binding="{Binding AlarmCode}" Width="SizeToCells" />
                <DataGridTextColumn Header="级别" Binding="{Binding Level}" Width="SizeToCells" />
                <DataGridTextColumn Header="消息" Binding="{Binding Message}" Width="3*" />
                <DataGridTemplateColumn Header="状态" Width="SizeToCells">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border CornerRadius="3" Padding="6,2"
                                    Background="{Binding Level, Converter={StaticResource StatusToColor}, ConverterParameter=bg}"
                                    Opacity="0.8">
                                <TextBlock Text="{Binding Status}" Foreground="{DynamicResource TextPrimary}" FontSize="12" />
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="发生时间" Binding="{Binding OccurTime, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}" Width="SizeToCells" />
                <DataGridTextColumn Header="恢复时间" Binding="{Binding RecoverTime, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}" Width="SizeToCells" />
                <DataGridTextColumn Header="根因报警" Binding="{Binding RootCauseAlarmId}" Width="SizeToCells" />
                <DataGridTextColumn Header="根因深度" Binding="{Binding RootCauseDepth}" Width="60" />
                <DataGridTemplateColumn Header="操作" Width="140">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <Button Content="确认"
                                        Command="{Binding $parent[DataGrid].DataContext.AckAlarmCommand}"
                                        CommandParameter="{Binding AlarmId}"
                                        Classes="Warning" />
                                <Button Content="恢复"
                                        Command="{Binding $parent[DataGrid].DataContext.RecoverAlarmCommand}"
                                        CommandParameter="{Binding AlarmCode}"
                                        Classes="Primary" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
