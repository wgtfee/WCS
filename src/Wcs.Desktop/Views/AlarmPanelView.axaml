<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="using:Wcs.Desktop.Converters"
             xmlns:vm="using:Wcs.Desktop.ViewModels"
             xmlns:atom="https://atomui.net"
             x:Class="Wcs.Desktop.Views.AlarmsView"
             x:DataType="vm:AlarmsViewModel"
             Background="{DynamicResource BgPrimary}">
    <UserControl.Resources>
        <conv:StatusToColorConverter x:Key="StatusToColor" />
    </UserControl.Resources>

    <DockPanel Margin="16">
        <!-- Toolbar -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource BgSecondary}" CornerRadius="8" Padding="12" Margin="0,0,0,8">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                <TextBlock Text="报警管理" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"
                           VerticalAlignment="Center" />
                <TextBox Grid.Column="1" Watermark="搜索报警..." Text="{Binding SearchText}"
                         Width="200" Margin="16,0,0,0" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="{Binding Alarms.Count, StringFormat='共 {0} 条'}"
                           FontSize="13" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="16,0,0,0" />
                <Button Grid.Column="3" Content="刷新" Command="{Binding RefreshCommand}" Classes="Secondary" Margin="4,0,0,0" />
            </Grid>
        </Border>

        <atom:DataGrid ItemsSource="{Binding Alarms}" AutoGenerateColumns="False"
                       IsReadOnly="True"
                       CanUserSortColumns="True"
                       CanUserFilterColumns="True"
                       CanUserResizeColumns="True"
                       Margin="0,0,0,8">
            <atom:DataGrid.Columns>
                <atom:DataGridTemplateColumn Header="报警 ID" SortMemberPath="AlarmId">
                    <atom:DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding AlarmId}" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" Margin="4,0" />
                        </DataTemplate>
                    </atom:DataGridTemplateColumn.CellTemplate>
                </atom:DataGridTemplateColumn>
                <atom:DataGridTemplateColumn Header="报警码" SortMemberPath="AlarmCode">
                    <atom:DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding AlarmCode}" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" Margin="4,0" />
                        </DataTemplate>
                    </atom:DataGridTemplateColumn.CellTemplate>
                </atom:DataGridTemplateColumn>
                <atom:DataGridTemplateColumn Header="级别" SortMemberPath="Level">
                    <atom:DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Level}" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" Margin="4,0" />
                        </DataTemplate>
                    </atom:DataGridTemplateColumn.CellTemplate>
                </atom:DataGridTemplateColumn>
                <atom:DataGridTemplateColumn Header="消息" SortMemberPath="Message">
                    <atom:DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Message}" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" Margin="4,0" />
                        </DataTemplate>
                    </atom:DataGridTemplateColumn.CellTemplate>
                </atom:DataGridTemplateColumn>
                <atom:DataGridTemplateColumn Header="状态" SortMemberPath="Status">
                    <atom:DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border CornerRadius="3" Padding="6,2"
                                    Background="{Binding Level, Converter={StaticResource StatusToColor}, ConverterParameter=bg}"
                                    Opacity="0.8">
                                <TextBlock Text="{Binding Status}" Foreground="White" FontSize="12" />
                            </Border>
                        </DataTemplate>
                    </atom:DataGridTemplateColumn.CellTemplate>
                </atom:DataGridTemplateColumn>
                <atom:DataGridTemplateColumn Header="发生时间" SortMemberPath="OccurTime">
                    <atom:DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding OccurTime, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" Margin="4,0" />
                        </DataTemplate>
                    </atom:DataGridTemplateColumn.CellTemplate>
                </atom:DataGridTemplateColumn>
                <atom:DataGridTemplateColumn Header="恢复时间" SortMemberPath="RecoverTime">
                    <atom:DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding RecoverTime, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" Margin="4,0" />
                        </DataTemplate>
                    </atom:DataGridTemplateColumn.CellTemplate>
                </atom:DataGridTemplateColumn>
                <atom:DataGridTemplateColumn Header="根因报警" SortMemberPath="RootCauseAlarmId">
                    <atom:DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding RootCauseAlarmId}" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" Margin="4,0" />
                        </DataTemplate>
                    </atom:DataGridTemplateColumn.CellTemplate>
                </atom:DataGridTemplateColumn>
                <atom:DataGridTemplateColumn Header="根因深度" SortMemberPath="RootCauseDepth">
                    <atom:DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding RootCauseDepth}" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" Margin="4,0" />
                        </DataTemplate>
                    </atom:DataGridTemplateColumn.CellTemplate>
                </atom:DataGridTemplateColumn>
                <atom:DataGridTemplateColumn Header="操作">
                    <atom:DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" Margin="4,0">
                                <Button Content="确认"
                                        Command="{Binding $parent[atom:DataGrid].DataContext.AckAlarmCommand}"
                                        CommandParameter="{Binding AlarmId}"
                                        Classes="Warning" />
                                <Button Content="恢复"
                                        Command="{Binding $parent[atom:DataGrid].DataContext.RecoverAlarmCommand}"
                                        CommandParameter="{Binding AlarmCode}"
                                        Classes="Primary" />
                            </StackPanel>
                        </DataTemplate>
                    </atom:DataGridTemplateColumn.CellTemplate>
                </atom:DataGridTemplateColumn>
            </atom:DataGrid.Columns>
        </atom:DataGrid>
    </DockPanel>
</UserControl>
