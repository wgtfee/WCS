<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="using:Wcs.Desktop.Converters"
             xmlns:vm="using:Wcs.Desktop.ViewModels"
             xmlns:atom="https://atomui.net"
             x:Class="Wcs.Desktop.Views.AlarmsView"
             x:DataType="vm:AlarmsViewModel"
             Background="{DynamicResource BgPrimary}">
    <UserControl.Resources>
        <conv:StatusToColorConverter x:Key="StatusToColor" />
    </UserControl.Resources>

    <Grid RowDefinitions="Auto,Auto,*" Margin="24" RowSpacing="16">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="10">
            <StackPanel Spacing="4">
                <TextBlock Classes="wcs-page-title" Text="报警管理" />
                <TextBlock Classes="wcs-page-subtitle" Text="统一查看报警级别、状态、发生/恢复时间与根因关联。" />
            </StackPanel>
            <ComboBox Grid.Column="1" ItemsSource="{Binding SearchFields}" SelectedItem="{Binding SearchField}" Width="100" VerticalAlignment="Center" />
            <atom:LineEdit Grid.Column="2" Text="{Binding SearchText}" Watermark="搜索报警..." Width="220" VerticalAlignment="Center" />
            <atom:Button Grid.Column="3" Content="刷新" Command="{Binding RefreshCommand}" />
        </Grid>

        <UniformGrid Grid.Row="1" Columns="1" Rows="1">
            <atom:Card StyleVariant="Outlined" IsHoverable="True">
                <atom:Statistic Header="当前报警" Value="{Binding Alarms.Count}" ContentFontSize="26" />
            </atom:Card>
        </UniformGrid>

        <atom:Card Grid.Row="2" Header="报警列表" StyleVariant="Outlined">
            <atom:DataGrid ItemsSource="{Binding Alarms}" AutoGenerateColumns="False"
                           IsReadOnly="True"
                           CanUserSortColumns="True"
                           CanUserFilterColumns="True"
                           CanUserResizeColumns="True"
                           PaginationVisibility="None">
                <atom:DataGrid.Columns>
                    <atom:DataGridTextColumn Header="报警 ID" Binding="{Binding AlarmId}" Width="180" />
                    <atom:DataGridTextColumn Header="报警码" Binding="{Binding AlarmCode}" Width="150" />
                    <atom:DataGridTextColumn Header="级别" Binding="{Binding Level}" Width="90" />
                    <atom:DataGridTextColumn Header="消息" Binding="{Binding Message}" Width="2*" />
                    <atom:DataGridTemplateColumn Header="状态" SortMemberPath="Status" Width="110">
                        <atom:DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="3" Padding="6,2"
                                        Background="{Binding Level, Converter={StaticResource StatusToColor}, ConverterParameter=bg}"
                                        Opacity="0.8">
                                    <TextBlock Text="{Binding Status}" Foreground="White" FontSize="12" />
                                </Border>
                            </DataTemplate>
                        </atom:DataGridTemplateColumn.CellTemplate>
                    </atom:DataGridTemplateColumn>
                    <atom:DataGridTextColumn Header="发生时间" Binding="{Binding OccurTime}" Width="180" />
                    <atom:DataGridTextColumn Header="恢复时间" Binding="{Binding RecoverTime}" Width="180" />
                    <atom:DataGridTextColumn Header="根因报警" Binding="{Binding RootCauseAlarmId}" Width="150" />
                    <atom:DataGridTextColumn Header="根因深度" Binding="{Binding RootCauseDepth}" Width="90" />
                    <atom:DataGridTemplateColumn Header="操作" Width="150">
                        <atom:DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <atom:Button Content="确认"
                                                 Command="{Binding $parent[atom:DataGrid].DataContext.AckAlarmCommand}"
                                                 CommandParameter="{Binding AlarmId}" />
                                    <atom:Button Content="恢复"
                                                 Command="{Binding $parent[atom:DataGrid].DataContext.RecoverAlarmCommand}"
                                                 CommandParameter="{Binding AlarmCode}" />
                                </StackPanel>
                            </DataTemplate>
                        </atom:DataGridTemplateColumn.CellTemplate>
                    </atom:DataGridTemplateColumn>
                </atom:DataGrid.Columns>
            </atom:DataGrid>
        </atom:Card>
    </Grid>
</UserControl>
