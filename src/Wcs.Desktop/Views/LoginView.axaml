<UserControl x:Class="Wcs.Desktop.Views.LoginView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Wcs.Desktop.ViewModels"
             xmlns:atom="https://atomui.net"
             x:DataType="vm:LoginViewModel"
             Background="{DynamicResource BgPrimary}">
    <Grid ColumnDefinitions="*,1.2*">
        <Border Grid.Column="0" Background="{DynamicResource AccentBlue}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="40" Spacing="10">
                <TextBlock Text="工业智能管理系统"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="White"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Industrial Intelligence Management System"
                           FontSize="14"
                           Foreground="#B0D4F1"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <Grid Grid.Column="1" Margin="50,40">
            <atom:Card StyleVariant="Outlined" VerticalAlignment="Center">
                <StackPanel Spacing="18" Margin="8">
                    <StackPanel Spacing="4">
                        <TextBlock Classes="wcs-page-title" Text="用户登录"/>
                        <TextBlock Classes="wcs-page-subtitle" Text="登录 WCS Runtime Engine 管理与监控工作台。"/>
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="用户名" Foreground="{DynamicResource TextSecondary}"/>
                        <atom:LineEdit Text="{Binding UserName, Mode=TwoWay}"
                                       Watermark="请输入用户名"
                                       IsEnabled="{Binding !IsLoading}">
                            <atom:LineEdit.InnerLeftContent>
                                <PathIcon Data="{StaticResource UserIcon}"
                                          Width="16" Height="16"
                                          Foreground="{DynamicResource TextSecondary}"/>
                            </atom:LineEdit.InnerLeftContent>
                        </atom:LineEdit>
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="密码" Foreground="{DynamicResource TextSecondary}"/>
                        <atom:LineEdit Text="{Binding Password, Mode=TwoWay}"
                                       PasswordChar="*"
                                       Watermark="请输入密码"
                                       IsEnabled="{Binding !IsLoading}">
                            <atom:LineEdit.InnerLeftContent>
                                <PathIcon Data="{StaticResource LockIcon}"
                                          Width="16" Height="16"
                                          Foreground="{DynamicResource TextSecondary}"/>
                            </atom:LineEdit.InnerLeftContent>
                        </atom:LineEdit>
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="验证码" Foreground="{DynamicResource TextSecondary}"/>
                        <Grid ColumnDefinitions="*,130,70" ColumnSpacing="8">
                            <atom:LineEdit Grid.Column="0"
                                           Text="{Binding Captcha, Mode=TwoWay}"
                                           Watermark="请输入验证码"
                                           MaxLength="6"
                                           MinWidth="100"
                                           IsEnabled="{Binding !IsLoading}"/>
                            <Border Grid.Column="1"
                                    Width="130" Height="40"
                                    CornerRadius="6"
                                    BorderBrush="{DynamicResource BorderColor}"
                                    BorderThickness="1"
                                    Background="{DynamicResource BgCard}">
                                <Image Source="{Binding CaptchaImage}"
                                       Width="126" Height="36"
                                       Stretch="Uniform"
                                       Margin="2"/>
                            </Border>
                            <atom:Button Grid.Column="2"
                                         Content="刷新"
                                         Height="40"
                                         Command="{Binding GenerateCaptchaCommand}"
                                         IsEnabled="{Binding !IsLoading}"/>
                        </Grid>
                    </StackPanel>

                    <Border Background="#FEE2E2"
                            CornerRadius="6"
                            Padding="10,6"
                            IsVisible="{Binding HasError}">
                        <TextBlock Text="{Binding ErrorMessage}"
                                   Foreground="#DC2626"
                                   TextWrapping="Wrap"
                                   FontSize="13"/>
                    </Border>

                    <atom:Button Content="登 录"
                                 Command="{Binding LoginCommand}"
                                 IsEnabled="{Binding !IsLoading}"
                                 HorizontalAlignment="Stretch"
                                 Height="44"/>
                </StackPanel>
            </atom:Card>
        </Grid>
    </Grid>
</UserControl>
