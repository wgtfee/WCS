<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Wcs.Desktop.ViewModels"
             xmlns:atom="https://atomui.net"
             x:Class="Wcs.Desktop.Views.TransportSimulationView"
             x:DataType="vm:TransportSimulationViewModel"
             Background="{DynamicResource BgPrimary}">
    <Grid RowDefinitions="Auto,Auto,*" Margin="24" RowSpacing="16">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <StackPanel Spacing="4">
                <TextBlock Classes="wcs-page-title" Text="EMS / RGV 调度仿真与最终验收" />
                <TextBlock Classes="wcs-page-subtitle" Text="历史回放、批量优化、策略 A/B、拥堵预测、容量压力和最终投产门槛。" />
                <Border Classes="wcs-boundary-strip"><TextBlock Classes="wcs-page-subtitle" Text="本页面只展示离线结果；任何推荐参数都不会自动应用到生产调度。" /></Border>
                <TextBlock Classes="wcs-toolbar-status" Text="{Binding StatusText}" />
            </StackPanel>
            <atom:Button Grid.Column="1" Content="刷新" Command="{Binding RefreshCommand}" />
        </Grid>

        <UniformGrid Grid.Row="1" Columns="10" Rows="1">
            <atom:Card Margin="0,0,4,0" StyleVariant="Outlined" IsHoverable="True"><atom:Statistic Header="最近策略" Value="{Binding LatestPolicy}" ContentFontSize="16" /></atom:Card>
            <atom:Card Margin="4,0" StyleVariant="Outlined" IsHoverable="True"><atom:Statistic Header="吞吐 /h" Value="{Binding LatestThroughput}" ContentFontSize="20" /></atom:Card>
            <atom:Card Margin="4,0" StyleVariant="Outlined" IsHoverable="True"><atom:Statistic Header="P95 等待(s)" Value="{Binding LatestP95Waiting}" ContentFontSize="20" /></atom:Card>
            <atom:Card Margin="4,0" StyleVariant="Outlined" IsHoverable="True"><atom:Statistic Header="交期违约(%)" Value="{Binding LatestDeadlineMissRate}" ContentFontSize="20" /></atom:Card>
            <atom:Card Margin="4,0" StyleVariant="Outlined" IsHoverable="True"><atom:Statistic Header="车队利用率(%)" Value="{Binding LatestFleetUtilization}" ContentFontSize="20" /></atom:Card>
            <atom:Card Margin="4,0" StyleVariant="Outlined" IsHoverable="True"><atom:Statistic Header="可持续任务率" Value="{Binding MaximumSustainableRate}" ContentFontSize="20" /></atom:Card>
            <atom:Card Margin="4,0" StyleVariant="Outlined" IsHoverable="True"><atom:Statistic Header="建议车辆数" Value="{Binding RecommendedVehicleCount}" ContentFontSize="20" /></atom:Card>
            <atom:Card Margin="4,0" StyleVariant="Outlined" IsHoverable="True"><atom:Statistic Header="验收状态" Value="{Binding AcceptanceState}" ContentFontSize="16" /></atom:Card>
            <atom:Card Margin="4,0" StyleVariant="Outlined" IsHoverable="True"><atom:Statistic Header="仿真次数" Value="{Binding RunCount}" ContentFontSize="20" /></atom:Card>
            <atom:Card Margin="4,0,0,0" StyleVariant="Outlined" IsHoverable="True"><atom:Statistic Header="策略对比" Value="{Binding ComparisonCount}" ContentFontSize="20" /></atom:Card>
        </UniformGrid>

        <atom:TabControl Grid.Row="2">
            <atom:TabItem Header="仿真运行">
                <atom:DataGrid ItemsSource="{Binding Runs}" AutoGenerateColumns="False" IsReadOnly="True" PaginationVisibility="None"><atom:DataGrid.Columns>
                    <atom:DataGridTextColumn Header="运行号" Binding="{Binding RunId}" Width="230"/><atom:DataGridTextColumn Header="场景" Binding="{Binding ScenarioName}" Width="180"/><atom:DataGridTextColumn Header="策略" Binding="{Binding PolicyName}" Width="180"/><atom:DataGridTextColumn Header="任务" Binding="{Binding Metrics.TotalTaskCount}" Width="80"/><atom:DataGridTextColumn Header="完成" Binding="{Binding Metrics.CompletedTaskCount}" Width="80"/><atom:DataGridTextColumn Header="吞吐/h" Binding="{Binding Metrics.ThroughputPerHour}" Width="100"/><atom:DataGridTextColumn Header="P95等待" Binding="{Binding Metrics.P95WaitingSeconds}" Width="100"/><atom:DataGridTextColumn Header="违约率" Binding="{Binding Metrics.DeadlineMissRatePercent}" Width="100"/><atom:DataGridTextColumn Header="目标得分" Binding="{Binding Metrics.ObjectiveScore}" Width="100"/><atom:DataGridTextColumn Header="执行人" Binding="{Binding InitiatedBy}" Width="120"/><atom:DataGridTextColumn Header="完成时间" Binding="{Binding CompletedAtUtc}" Width="190"/>
                </atom:DataGrid.Columns></atom:DataGrid>
            </atom:TabItem>
            <atom:TabItem Header="策略 A/B">
                <atom:DataGrid ItemsSource="{Binding Comparisons}" AutoGenerateColumns="False" IsReadOnly="True" PaginationVisibility="None"><atom:DataGrid.Columns>
                    <atom:DataGridTextColumn Header="对比号" Binding="{Binding ComparisonId}" Width="230"/><atom:DataGridTextColumn Header="场景" Binding="{Binding ScenarioName}" Width="180"/><atom:DataGridTextColumn Header="推荐策略" Binding="{Binding RecommendedPolicyId}" Width="230"/><atom:DataGridTextColumn Header="结论" Binding="{Binding Recommendation}" Width="*"/><atom:DataGridTextColumn Header="执行人" Binding="{Binding InitiatedBy}" Width="120"/><atom:DataGridTextColumn Header="时间" Binding="{Binding CompletedAtUtc}" Width="190"/>
                </atom:DataGrid.Columns></atom:DataGrid>
            </atom:TabItem>
            <atom:TabItem Header="批量优化">
                <atom:DataGrid ItemsSource="{Binding Optimizations}" AutoGenerateColumns="False" IsReadOnly="True" PaginationVisibility="None"><atom:DataGrid.Columns>
                    <atom:DataGridTextColumn Header="优化号" Binding="{Binding OptimizationId}" Width="230"/><atom:DataGridTextColumn Header="场景号" Binding="{Binding ScenarioId}" Width="230"/><atom:DataGridTextColumn Header="推荐策略" Binding="{Binding RecommendedPolicy.Name}" Width="180"/><atom:DataGridTextColumn Header="策略类型" Binding="{Binding RecommendedPolicy.Strategy}" Width="160"/><atom:DataGridTextColumn Header="目标得分" Binding="{Binding ObjectiveScore}" Width="100"/><atom:DataGridTextColumn Header="说明" Binding="{Binding Explanation}" Width="*"/><atom:DataGridTextColumn Header="时间" Binding="{Binding GeneratedAtUtc}" Width="190"/>
                </atom:DataGrid.Columns></atom:DataGrid>
            </atom:TabItem>
            <atom:TabItem Header="容量基线">
                <atom:DataGrid ItemsSource="{Binding Benchmarks}" AutoGenerateColumns="False" IsReadOnly="True" PaginationVisibility="None"><atom:DataGrid.Columns>
                    <atom:DataGridTextColumn Header="基线号" Binding="{Binding BenchmarkId}" Width="230"/><atom:DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="180"/><atom:DataGridTextColumn Header="最大可持续任务率" Binding="{Binding MaximumSustainableTaskRatePerHour}" Width="150"/><atom:DataGridTextColumn Header="建议车辆数" Binding="{Binding RecommendedVehicleCount}" Width="120"/><atom:DataGridTextColumn Header="结论" Binding="{Binding Conclusion}" Width="*"/><atom:DataGridTextColumn Header="执行人" Binding="{Binding InitiatedBy}" Width="120"/><atom:DataGridTextColumn Header="时间" Binding="{Binding CompletedAtUtc}" Width="190"/>
                </atom:DataGrid.Columns></atom:DataGrid>
            </atom:TabItem>
            <atom:TabItem Header="拥堵预测">
                <atom:DataGrid ItemsSource="{Binding Forecast}" AutoGenerateColumns="False" IsReadOnly="True" PaginationVisibility="None"><atom:DataGrid.Columns>
                    <atom:DataGridTextColumn Header="偏移秒" Binding="{Binding OffsetSeconds}" Width="100"/><atom:DataGridTextColumn Header="队列长度" Binding="{Binding QueueLength}" Width="110"/><atom:DataGridTextColumn Header="活动任务" Binding="{Binding ActiveTaskCount}" Width="110"/><atom:DataGridTextColumn Header="车队利用率" Binding="{Binding FleetUtilizationPercent}" Width="130"/><atom:DataGridTextColumn Header="拥堵等级" Binding="{Binding CongestionLevel}" Width="130"/>
                </atom:DataGrid.Columns></atom:DataGrid>
            </atom:TabItem>
            <atom:TabItem Header="最终验收">
                <atom:DataGrid ItemsSource="{Binding AcceptanceReports}" AutoGenerateColumns="False" IsReadOnly="True" PaginationVisibility="None"><atom:DataGrid.Columns>
                    <atom:DataGridTextColumn Header="报告号" Binding="{Binding ReportId}" Width="230"/><atom:DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="180"/><atom:DataGridTextColumn Header="状态" Binding="{Binding State}" Width="110"/><atom:DataGridTextColumn Header="仿真运行" Binding="{Binding SimulationRunId}" Width="230"/><atom:DataGridTextColumn Header="结论" Binding="{Binding Conclusion}" Width="*"/><atom:DataGridTextColumn Header="执行人" Binding="{Binding InitiatedBy}" Width="120"/><atom:DataGridTextColumn Header="时间" Binding="{Binding GeneratedAtUtc}" Width="190"/>
                </atom:DataGrid.Columns></atom:DataGrid>
            </atom:TabItem>
        </atom:TabControl>
    </Grid>
</UserControl>
