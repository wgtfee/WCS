<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Wcs.Desktop.ViewModels"
             xmlns:atom="https://atomui.net"
             x:Class="Wcs.Desktop.Views.TransportResilienceView"
             x:DataType="vm:TransportResilienceViewModel"
             Background="{DynamicResource BgPrimary}">
    <Grid RowDefinitions="Auto,Auto,*" Margin="24" RowSpacing="16">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
            <StackPanel Spacing="4">
                <TextBlock Classes="wcs-page-title" Text="EMS / RGV 生产韧性与恢复演练" />
                <TextBlock Classes="wcs-page-subtitle" Text="生产就绪检查、运行基线、逻辑备份、完整性校验和隔离恢复演练。" />
                <Border Classes="wcs-boundary-strip" Margin="0,4,0,0">
                    <TextBlock Classes="wcs-page-subtitle" Text="恢复准备只生成待审批配置快照，不自动恢复活动任务、路权或 PLC 命令。" />
                </Border>
                <TextBlock Classes="wcs-toolbar-status" Text="{Binding StatusText}" />
            </StackPanel>
            <atom:Button Grid.Column="1" Content="生产就绪检查" Command="{Binding RunReadinessCommand}" />
            <atom:Button Grid.Column="2" Content="刷新" Command="{Binding RefreshCommand}" />
        </Grid>

        <UniformGrid Grid.Row="1" Columns="8" Rows="1">
            <atom:Card Margin="0,0,5,0" StyleVariant="Outlined" IsHoverable="True"><atom:Statistic Header="就绪状态" Value="{Binding ReadinessState}" ContentFontSize="20" /></atom:Card>
            <atom:Card Margin="5,0" StyleVariant="Outlined" IsHoverable="True"><atom:Statistic Header="Critical" Value="{Binding CriticalCount}" ContentFontSize="20" /></atom:Card>
            <atom:Card Margin="5,0" StyleVariant="Outlined" IsHoverable="True"><atom:Statistic Header="Error" Value="{Binding ErrorCount}" ContentFontSize="20" /></atom:Card>
            <atom:Card Margin="5,0" StyleVariant="Outlined" IsHoverable="True"><atom:Statistic Header="Warning" Value="{Binding WarningCount}" ContentFontSize="20" /></atom:Card>
            <atom:Card Margin="5,0" StyleVariant="Outlined" IsHoverable="True"><atom:Statistic Header="备份数量" Value="{Binding BackupCount}" ContentFontSize="20" /></atom:Card>
            <atom:Card Margin="5,0" StyleVariant="Outlined" IsHoverable="True"><atom:Statistic Header="演练数量" Value="{Binding DrillCount}" ContentFontSize="20" /></atom:Card>
            <atom:Card Margin="5,0" StyleVariant="Outlined"><StackPanel><TextBlock Classes="wcs-page-subtitle" Text="最近备份"/><TextBlock Text="{Binding LastBackupText}" FontWeight="SemiBold" TextWrapping="Wrap"/></StackPanel></atom:Card>
            <atom:Card Margin="5,0,0,0" StyleVariant="Outlined"><StackPanel><TextBlock Classes="wcs-page-subtitle" Text="最近演练"/><TextBlock Text="{Binding LastDrillText}" FontWeight="SemiBold" TextWrapping="Wrap"/></StackPanel></atom:Card>
        </UniformGrid>

        <atom:TabControl Grid.Row="2">
            <atom:TabItem Header="生产就绪检查">
                <atom:DataGrid ItemsSource="{Binding ReadinessChecks}" AutoGenerateColumns="False" IsReadOnly="True" PaginationVisibility="None">
                    <atom:DataGrid.Columns>
                        <atom:DataGridCheckBoxColumn Header="通过" Binding="{Binding Passed}" Width="80" />
                        <atom:DataGridTextColumn Header="检查项" Binding="{Binding CheckType}" Width="220" />
                        <atom:DataGridTextColumn Header="级别" Binding="{Binding Severity}" Width="110" />
                        <atom:DataGridTextColumn Header="说明" Binding="{Binding Message}" Width="*" />
                    </atom:DataGrid.Columns>
                </atom:DataGrid>
            </atom:TabItem>
            <atom:TabItem Header="运行基线">
                <atom:DataGrid ItemsSource="{Binding Baselines}" AutoGenerateColumns="False" IsReadOnly="True" PaginationVisibility="None">
                    <atom:DataGrid.Columns>
                        <atom:DataGridTextColumn Header="基线号" Binding="{Binding BaselineId}" Width="240" />
                        <atom:DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="160" />
                        <atom:DataGridTextColumn Header="配置版本" Binding="{Binding RuntimeConfigurationVersion}" Width="110" />
                        <atom:DataGridTextColumn Header="整定版本" Binding="{Binding ProductionTuningVersion}" Width="110" />
                        <atom:DataGridTextColumn Header="车辆" Binding="{Binding VehicleCount}" Width="80" />
                        <atom:DataGridTextColumn Header="在线" Binding="{Binding OnlineVehicleCount}" Width="80" />
                        <atom:DataGridTextColumn Header="活动任务" Binding="{Binding ActiveExecutionCount}" Width="100" />
                        <atom:DataGridTextColumn Header="路权" Binding="{Binding ActiveReservationCount}" Width="80" />
                        <atom:DataGridTextColumn Header="创建人" Binding="{Binding CapturedBy}" Width="120" />
                        <atom:DataGridTextColumn Header="时间" Binding="{Binding CapturedAtUtc}" Width="190" />
                    </atom:DataGrid.Columns>
                </atom:DataGrid>
            </atom:TabItem>
            <atom:TabItem Header="逻辑备份">
                <Grid RowDefinitions="Auto,*,Auto,*" RowSpacing="8">
                    <atom:Button Grid.Row="0" HorizontalAlignment="Left" Content="校验选中备份" Command="{Binding ValidateSelectedBackupCommand}" />
                    <atom:DataGrid Grid.Row="1" ItemsSource="{Binding Backups}" SelectedItem="{Binding SelectedBackup}" SelectionMode="Single" SelectTriggerType="Cell" AutoGenerateColumns="False" IsReadOnly="True" PaginationVisibility="None">
                        <atom:DataGrid.Columns>
                            <atom:DataGridTextColumn Header="备份号" Binding="{Binding BackupId}" Width="240" />
                            <atom:DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="150" />
                            <atom:DataGridTextColumn Header="SHA-256" Binding="{Binding Sha256}" Width="280" />
                            <atom:DataGridTextColumn Header="大小" Binding="{Binding SizeBytes}" Width="100" />
                            <atom:DataGridCheckBoxColumn Header="就绪" Binding="{Binding PreflightReady}" Width="80" />
                            <atom:DataGridTextColumn Header="车辆" Binding="{Binding VehicleCount}" Width="80" />
                            <atom:DataGridTextColumn Header="活动任务" Binding="{Binding ActiveExecutionCount}" Width="100" />
                            <atom:DataGridTextColumn Header="创建人" Binding="{Binding CreatedBy}" Width="120" />
                            <atom:DataGridTextColumn Header="时间" Binding="{Binding CreatedAtUtc}" Width="190" />
                        </atom:DataGrid.Columns>
                    </atom:DataGrid>
                    <TextBlock Grid.Row="2" Classes="wcs-section-title" Text="备份校验结果" Margin="0,4,0,0" />
                    <atom:DataGrid Grid.Row="3" ItemsSource="{Binding ValidationIssues}" AutoGenerateColumns="False" IsReadOnly="True" PaginationVisibility="None">
                        <atom:DataGrid.Columns>
                            <atom:DataGridTextColumn Header="类型" Binding="{Binding IssueType}" Width="230" />
                            <atom:DataGridTextColumn Header="级别" Binding="{Binding Severity}" Width="110" />
                            <atom:DataGridTextColumn Header="说明" Binding="{Binding Message}" Width="*" />
                        </atom:DataGrid.Columns>
                    </atom:DataGrid>
                </Grid>
            </atom:TabItem>
            <atom:TabItem Header="恢复演练">
                <atom:DataGrid ItemsSource="{Binding Drills}" AutoGenerateColumns="False" IsReadOnly="True" PaginationVisibility="None">
                    <atom:DataGrid.Columns>
                        <atom:DataGridTextColumn Header="演练号" Binding="{Binding DrillId}" Width="240" />
                        <atom:DataGridTextColumn Header="场景" Binding="{Binding Scenario}" Width="200" />
                        <atom:DataGridTextColumn Header="车辆" Binding="{Binding TargetVehicleId}" Width="120" />
                        <atom:DataGridCheckBoxColumn Header="隔离" Binding="{Binding IsIsolatedSimulation}" Width="80" />
                        <atom:DataGridCheckBoxColumn Header="通过" Binding="{Binding Passed}" Width="80" />
                        <atom:DataGridTextColumn Header="原因" Binding="{Binding Reason}" Width="*" />
                        <atom:DataGridTextColumn Header="执行人" Binding="{Binding ExecutedBy}" Width="120" />
                        <atom:DataGridTextColumn Header="时间" Binding="{Binding CompletedAtUtc}" Width="190" />
                    </atom:DataGrid.Columns>
                </atom:DataGrid>
            </atom:TabItem>
        </atom:TabControl>
    </Grid>
</UserControl>
