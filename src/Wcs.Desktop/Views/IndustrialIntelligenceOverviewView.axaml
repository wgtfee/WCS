<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Wcs.Desktop.ViewModels"
             xmlns:atom="https://atomui.net"
             x:Class="Wcs.Desktop.Views.IndustrialIntelligenceOverviewView"
             x:DataType="vm:IndustrialIntelligenceOverviewViewModel">
  <ScrollViewer>
    <StackPanel Margin="24" Spacing="16">
      <StackPanel Spacing="4">
        <TextBlock Classes="wcs-page-title" Text="Industrial Decision Intelligence 总览" />
        <TextBlock Classes="wcs-page-subtitle"
                   Text="统一查看 P0-P6 能力可用性、环境边界与自动化权限。" />
      </StackPanel>

      <Border Classes="wcs-boundary-strip">
        <TextBlock Classes="wcs-page-subtitle" Text="{Binding BoundaryText}" />
      </Border>

      <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
        <atom:Card Grid.Column="0" StyleVariant="Outlined" IsHoverable="True">
          <atom:Statistic Header="可用阶段"
                          Value="{Binding AvailableStageCount}"
                          ContentFontSize="28" />
        </atom:Card>
        <atom:Card Grid.Column="1" StyleVariant="Outlined" IsHoverable="True">
          <atom:Statistic Header="失效关闭 / 不可用"
                          Value="{Binding FailClosedStageCount}"
                          ContentFontSize="28" />
        </atom:Card>
      </Grid>

      <StackPanel Orientation="Horizontal" Spacing="10">
        <atom:Button ButtonType="Primary" Content="刷新 P0-P6" Command="{Binding RefreshCommand}" />
        <TextBlock Classes="wcs-toolbar-status" Text="{Binding StatusText}" />
      </StackPanel>

      <atom:Card Header="P0–P6 能力矩阵" StyleVariant="Outlined">
        <atom:DataGrid ItemsSource="{Binding Stages}"
                       AutoGenerateColumns="False"
                       IsReadOnly="True"
                       CanUserResizeColumns="True"
                       CanUserSortColumns="True"
                       IsFrameBorderVisible="True"
                       PaginationVisibility="None"
                       Height="380">
          <atom:DataGrid.Columns>
            <atom:DataGridTextColumn Header="阶段" Binding="{Binding Stage}" Width="70" />
            <atom:DataGridTextColumn Header="能力" Binding="{Binding Name}" Width="220" />
            <atom:DataGridCheckBoxColumn Header="可用" Binding="{Binding Available}" Width="90" />
            <atom:DataGridTextColumn Header="环境" Binding="{Binding Environment}" Width="120" />
            <atom:DataGridTextColumn Header="最高等级" Binding="{Binding MaximumAutomationLevel}" Width="100" />
            <atom:DataGridCheckBoxColumn Header="控制写入权" Binding="{Binding ControlWriteAllowed}" Width="100" />
            <atom:DataGridTextColumn Header="条目数" Binding="{Binding ItemCount}" Width="70" />
            <atom:DataGridTextColumn Header="说明" Binding="{Binding Detail}" Width="*" />
          </atom:DataGrid.Columns>
        </atom:DataGrid>
      </atom:Card>

      <atom:Card Header="治理顺序与边界" StyleVariant="Outlined">
        <TextBlock Classes="wcs-page-subtitle"
                   Text="建议使用顺序：P0 Governance → P1 ModelOps → P2 Feature Center → P3 Shadow Decision → P4 Maintenance Learning → P5 Digital Twin Optimizer → P6 Bounded Automation Readiness。P5/P6 仍是 recommendation/software-side readiness，不是 Production 自动控制。" />
      </atom:Card>
    </StackPanel>
  </ScrollViewer>
</UserControl>
