<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Wcs.Desktop.Views.ChangePasswordPage"
             Background="#1E1E1E">
    <Border Padding="32" MaxWidth="400">
        <StackPanel Spacing="16">
            <TextBlock Text="修改密码" FontSize="22" FontWeight="Bold" Foreground="White"/>

            <Border Background="#2A2A2A" CornerRadius="8" Padding="24">
                <StackPanel Spacing="14">
                    <StackPanel Spacing="4">
                        <TextBlock Text="原密码" Foreground="#9E9E9E" FontSize="13"/>
                        <TextBox PasswordChar="●" Background="#333333" Foreground="White"
                                 BorderThickness="1" BorderBrush="#404040"/>
                    </StackPanel>
                    <StackPanel Spacing="4">
                        <TextBlock Text="新密码" Foreground="#9E9E9E" FontSize="13"/>
                        <TextBox PasswordChar="●" Background="#333333" Foreground="White"
                                 BorderThickness="1" BorderBrush="#404040"/>
                    </StackPanel>
                    <StackPanel Spacing="4">
                        <TextBlock Text="确认新密码" Foreground="#9E9E9E" FontSize="13"/>
                        <TextBox PasswordChar="●" Background="#333333" Foreground="White"
                                 BorderThickness="1" BorderBrush="#404040"/>
                    </StackPanel>
                    <Button Content="确认修改" Margin="0,10,0,0" Height="36"
                            Background="#2196F3" Foreground="White"
                            BorderThickness="0" CornerRadius="4"
                            HorizontalAlignment="Center" Width="160"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</UserControl>
