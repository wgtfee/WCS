<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:atom="https://atomui.net"
             x:Class="Wcs.Desktop.Views.ChangePasswordPage"
             Background="{DynamicResource BgPrimary}">
    <Grid Margin="24">
        <atom:Card Header="修改密码" StyleVariant="Outlined" MaxWidth="460" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel Spacing="14">
                <StackPanel Spacing="4">
                    <TextBlock Text="原密码" Foreground="{DynamicResource TextSecondary}" FontSize="13"/>
                    <atom:LineEdit PasswordChar="●" Watermark="请输入原密码"/>
                </StackPanel>
                <StackPanel Spacing="4">
                    <TextBlock Text="新密码" Foreground="{DynamicResource TextSecondary}" FontSize="13"/>
                    <atom:LineEdit PasswordChar="●" Watermark="请输入新密码"/>
                </StackPanel>
                <StackPanel Spacing="4">
                    <TextBlock Text="确认新密码" Foreground="{DynamicResource TextSecondary}" FontSize="13"/>
                    <atom:LineEdit PasswordChar="●" Watermark="再次输入新密码"/>
                </StackPanel>
                <atom:Button Content="确认修改" Margin="0,8,0,0" Height="38" HorizontalAlignment="Stretch"/>
            </StackPanel>
        </atom:Card>
    </Grid>
</UserControl>
