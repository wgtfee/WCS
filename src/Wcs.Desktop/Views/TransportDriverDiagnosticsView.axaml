<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Wcs.Desktop.ViewModels"
             x:Class="Wcs.Desktop.Views.TransportDriverDiagnosticsView"
             x:DataType="vm:TransportDriverDiagnosticsViewModel"
             Background="{DynamicResource BgPrimary}">
    <Grid RowDefinitions="Auto,Auto,*" Margin="24" RowSpacing="16">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="10">
            <StackPanel>
                <TextBlock Text="EMS / RGV PLC 驱动诊断" FontSize="24" FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimary}" />
                <TextBlock Text="标签批量读写、命令握手、心跳、故障码和重启对账"
                           Margin="0,4,0,0" Foreground="{DynamicResource TextSecondary}" />
                <TextBlock Text="{Binding StatusText}" Margin="0,4,0,0"
                           Foreground="{DynamicResource TextSecondary}" />
            </StackPanel>
            <Button Grid.Column="1" Content="刷新" Command="{Binding RefreshCommand}" Padding="18,8" />
            <Button Grid.Column="2" Content="立即轮询" Command="{Binding PollCommand}" Padding="18,8" />
            <Button Grid.Column="3" Content="安全对账" Command="{Binding ReconcileCommand}" Padding="18,8" />
        </Grid>

        <UniformGrid Grid.Row="1" Columns="4" Rows="1">
            <Border Margin="0,0,8,0" Padding="16" CornerRadius="8" Background="{DynamicResource BgSecondary}">
                <StackPanel><TextBlock Text="点位映射" Foreground="{DynamicResource TextSecondary}"/><TextBlock Text="{Binding MapCount}" FontSize="26" FontWeight="Bold"/></StackPanel>
            </Border>
            <Border Margin="8,0" Padding="16" CornerRadius="8" Background="{DynamicResource BgSecondary}">
                <StackPanel><TextBlock Text="设备在线" Foreground="{DynamicResource TextSecondary}"/><TextBlock Text="{Binding OnlineCount}" FontSize="26" FontWeight="Bold"/></StackPanel>
            </Border>
            <Border Margin="8,0" Padding="16" CornerRadius="8" Background="{DynamicResource BgSecondary}">
                <StackPanel><TextBlock Text="驱动故障" Foreground="{DynamicResource TextSecondary}"/><TextBlock Text="{Binding FaultCount}" FontSize="26" FontWeight="Bold"/></StackPanel>
            </Border>
            <Border Margin="8,0,0,0" Padding="16" CornerRadius="8" Background="{DynamicResource BgSecondary}">
                <StackPanel><TextBlock Text="需人工确认" Foreground="{DynamicResource TextSecondary}"/><TextBlock Text="{Binding ManualConfirmationCount}" FontSize="26" FontWeight="Bold"/></StackPanel>
            </Border>
        </UniformGrid>

        <TabControl Grid.Row="2">
            <TabItem Header="点位映射">
                <DataGrid ItemsSource="{Binding Maps}" AutoGenerateColumns="False" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="车辆" Binding="{Binding VehicleId}" Width="130" />
                        <DataGridTextColumn Header="驱动" Binding="{Binding DriverId}" Width="150" />
                        <DataGridTextColumn Header="类型" Binding="{Binding Kind}" Width="90" />
                        <DataGridTextColumn Header="模式" Binding="{Binding Mode}" Width="100" />
                        <DataGridCheckBoxColumn Header="启用" Binding="{Binding Enabled}" Width="70" />
                        <DataGridTextColumn Header="轮询(ms)" Binding="{Binding PollIntervalMs}" Width="90" />
                        <DataGridTextColumn Header="心跳超时(ms)" Binding="{Binding HeartbeatTimeoutMs}" Width="120" />
                        <DataGridTextColumn Header="版本" Binding="{Binding Version}" Width="80" />
                        <DataGridTextColumn Header="更新人" Binding="{Binding UpdatedBy}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="实时诊断">
                <DataGrid ItemsSource="{Binding Diagnostics}" AutoGenerateColumns="False" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="车辆" Binding="{Binding VehicleId}" Width="120" />
                        <DataGridCheckBoxColumn Header="在线" Binding="{Binding DeviceOnline}" Width="70" />
                        <DataGridTextColumn Header="节点" Binding="{Binding CurrentNodeId}" Width="120" />
                        <DataGridTextColumn Header="状态" Binding="{Binding OperatingState}" Width="110" />
                        <DataGridTextColumn Header="电量" Binding="{Binding BatteryPercent}" Width="70" />
                        <DataGridTextColumn Header="故障码" Binding="{Binding FaultCode}" Width="80" />
                        <DataGridTextColumn Header="状态序号" Binding="{Binding StateSequence}" Width="90" />
                        <DataGridTextColumn Header="确认序号" Binding="{Binding AcknowledgedSequence}" Width="90" />
                        <DataGridTextColumn Header="待确认命令" Binding="{Binding PendingCommandId}" Width="180" />
                        <DataGridTextColumn Header="最后错误" Binding="{Binding LastError}" Width="2*" />
                        <DataGridTextColumn Header="最后读取" Binding="{Binding LastReadAtUtc}" Width="180" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="重启对账">
                <DataGrid ItemsSource="{Binding ReconciliationItems}" AutoGenerateColumns="False" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="车辆" Binding="{Binding VehicleId}" Width="120" />
                        <DataGridTextColumn Header="结果" Binding="{Binding Decision}" Width="160" />
                        <DataGridTextColumn Header="数据库节点" Binding="{Binding PersistedNodeId}" Width="130" />
                        <DataGridTextColumn Header="设备节点" Binding="{Binding DeviceNodeId}" Width="130" />
                        <DataGridTextColumn Header="数据库命令" Binding="{Binding PersistedCommandId}" Width="180" />
                        <DataGridTextColumn Header="设备命令" Binding="{Binding DeviceCommandId}" Width="180" />
                        <DataGridTextColumn Header="说明" Binding="{Binding Message}" Width="2*" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
