<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Wcs.Desktop.ViewModels"
             xmlns:atom="https://atomui.net"
             x:Class="Wcs.Desktop.Views.TransportDriverDiagnosticsView"
             x:DataType="vm:TransportDriverDiagnosticsViewModel"
             Background="{DynamicResource BgPrimary}">
    <Grid RowDefinitions="Auto,Auto,*" Margin="24" RowSpacing="16">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="10">
            <StackPanel Spacing="4">
                <TextBlock Classes="wcs-page-title" Text="EMS / RGV PLC 驱动诊断" />
                <TextBlock Classes="wcs-page-subtitle" Text="标签批量读写、命令握手、心跳、故障码和重启对账。" />
                <TextBlock Classes="wcs-toolbar-status" Text="{Binding StatusText}" />
            </StackPanel>
            <atom:Button Grid.Column="1" Content="刷新" Command="{Binding RefreshCommand}" />
            <atom:Button Grid.Column="2" Content="立即轮询" Command="{Binding PollCommand}" />
            <atom:Button Grid.Column="3" Content="安全对账" Command="{Binding ReconcileCommand}" />
        </Grid>

        <UniformGrid Grid.Row="1" Columns="4" Rows="1">
            <atom:Card Margin="0,0,8,0" StyleVariant="Outlined" IsHoverable="True"><atom:Statistic Header="点位映射" Value="{Binding MapCount}" ContentFontSize="26" /></atom:Card>
            <atom:Card Margin="8,0" StyleVariant="Outlined" IsHoverable="True"><atom:Statistic Header="设备在线" Value="{Binding OnlineCount}" ContentFontSize="26" /></atom:Card>
            <atom:Card Margin="8,0" StyleVariant="Outlined" IsHoverable="True"><atom:Statistic Header="驱动故障" Value="{Binding FaultCount}" ContentFontSize="26" /></atom:Card>
            <atom:Card Margin="8,0,0,0" StyleVariant="Outlined" IsHoverable="True"><atom:Statistic Header="需人工确认" Value="{Binding ManualConfirmationCount}" ContentFontSize="26" /></atom:Card>
        </UniformGrid>

        <atom:TabControl Grid.Row="2">
            <atom:TabItem Header="点位映射">
                <atom:DataGrid ItemsSource="{Binding Maps}" AutoGenerateColumns="False" IsReadOnly="True" PaginationVisibility="None">
                    <atom:DataGrid.Columns>
                        <atom:DataGridTextColumn Header="车辆" Binding="{Binding VehicleId}" Width="130" />
                        <atom:DataGridTextColumn Header="驱动" Binding="{Binding DriverId}" Width="150" />
                        <atom:DataGridTextColumn Header="类型" Binding="{Binding Kind}" Width="90" />
                        <atom:DataGridTextColumn Header="模式" Binding="{Binding Mode}" Width="100" />
                        <atom:DataGridCheckBoxColumn Header="启用" Binding="{Binding Enabled}" Width="70" />
                        <atom:DataGridTextColumn Header="轮询(ms)" Binding="{Binding PollIntervalMs}" Width="90" />
                        <atom:DataGridTextColumn Header="心跳超时(ms)" Binding="{Binding HeartbeatTimeoutMs}" Width="120" />
                        <atom:DataGridTextColumn Header="版本" Binding="{Binding Version}" Width="80" />
                        <atom:DataGridTextColumn Header="更新人" Binding="{Binding UpdatedBy}" Width="*" />
                    </atom:DataGrid.Columns>
                </atom:DataGrid>
            </atom:TabItem>
            <atom:TabItem Header="实时诊断">
                <atom:DataGrid ItemsSource="{Binding Diagnostics}" AutoGenerateColumns="False" IsReadOnly="True" PaginationVisibility="None">
                    <atom:DataGrid.Columns>
                        <atom:DataGridTextColumn Header="车辆" Binding="{Binding VehicleId}" Width="120" />
                        <atom:DataGridCheckBoxColumn Header="在线" Binding="{Binding DeviceOnline}" Width="70" />
                        <atom:DataGridTextColumn Header="节点" Binding="{Binding CurrentNodeId}" Width="120" />
                        <atom:DataGridTextColumn Header="状态" Binding="{Binding OperatingState}" Width="110" />
                        <atom:DataGridTextColumn Header="电量" Binding="{Binding BatteryPercent}" Width="70" />
                        <atom:DataGridTextColumn Header="故障码" Binding="{Binding FaultCode}" Width="80" />
                        <atom:DataGridTextColumn Header="状态序号" Binding="{Binding StateSequence}" Width="90" />
                        <atom:DataGridTextColumn Header="确认序号" Binding="{Binding AcknowledgedSequence}" Width="90" />
                        <atom:DataGridTextColumn Header="待确认命令" Binding="{Binding PendingCommandId}" Width="180" />
                        <atom:DataGridTextColumn Header="最后错误" Binding="{Binding LastError}" Width="2*" />
                        <atom:DataGridTextColumn Header="最后读取" Binding="{Binding LastReadAtUtc}" Width="180" />
                    </atom:DataGrid.Columns>
                </atom:DataGrid>
            </atom:TabItem>
            <atom:TabItem Header="重启对账">
                <atom:DataGrid ItemsSource="{Binding ReconciliationItems}" AutoGenerateColumns="False" IsReadOnly="True" PaginationVisibility="None">
                    <atom:DataGrid.Columns>
                        <atom:DataGridTextColumn Header="车辆" Binding="{Binding VehicleId}" Width="120" />
                        <atom:DataGridTextColumn Header="结果" Binding="{Binding Decision}" Width="160" />
                        <atom:DataGridTextColumn Header="数据库节点" Binding="{Binding PersistedNodeId}" Width="130" />
                        <atom:DataGridTextColumn Header="设备节点" Binding="{Binding DeviceNodeId}" Width="130" />
                        <atom:DataGridTextColumn Header="数据库命令" Binding="{Binding PersistedCommandId}" Width="180" />
                        <atom:DataGridTextColumn Header="设备命令" Binding="{Binding DeviceCommandId}" Width="180" />
                        <atom:DataGridTextColumn Header="说明" Binding="{Binding Message}" Width="2*" />
                    </atom:DataGrid.Columns>
                </atom:DataGrid>
            </atom:TabItem>
        </atom:TabControl>
    </Grid>
</UserControl>
