<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Light blue theme palette -->
    <Color x:Key="BgPrimary">#EBF2F7</Color>
    <Color x:Key="BgSecondary">#E0EAF3</Color>
    <Color x:Key="BgSidebar">#D4E2F0</Color>
    <Color x:Key="BgStatusBar">#E0EAF3</Color>
    <Color x:Key="TabBg">#F0F6FB</Color>
    <Color x:Key="TreeViewSelectedBg">#B8D4F0</Color>
    <Color x:Key="BgCard">#F7FAFD</Color>
    <Color x:Key="TextPrimary">#1A2B3C</Color>
    <Color x:Key="TextSecondary">#5A6B7C</Color>
    <Color x:Key="AccentBlue">#1976D2</Color>
    <Color x:Key="AccentGreen">#388E3C</Color>
    <Color x:Key="AccentRed">#D32F2F</Color>
    <Color x:Key="AccentOrange">#F57C00</Color>
    <Color x:Key="AccentYellow">#FBC02D</Color>
    <Color x:Key="BorderColor">#C8D6E5</Color>
</ResourceDictionary>
