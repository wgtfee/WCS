<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:atom="https://atomui.net"
             x:Class="Wcs.Desktop.Controls.ChangePasswordOverlay"
             Width="440" Height="340">
    <atom:Card Header="修改密码" StyleVariant="Outlined">
        <Grid RowDefinitions="*,Auto" RowSpacing="16">
            <StackPanel Spacing="14" Margin="8">
                <StackPanel Spacing="4">
                    <TextBlock Text="原密码" Foreground="{DynamicResource TextSecondary}" FontSize="13"/>
                    <atom:LineEdit PasswordChar="●" Watermark="请输入原密码"/>
                </StackPanel>
                <StackPanel Spacing="4">
                    <TextBlock Text="新密码" Foreground="{DynamicResource TextSecondary}" FontSize="13"/>
                    <atom:LineEdit PasswordChar="●" Watermark="请输入新密码"/>
                </StackPanel>
                <StackPanel Spacing="4">
                    <TextBlock Text="确认新密码" Foreground="{DynamicResource TextSecondary}" FontSize="13"/>
                    <atom:LineEdit PasswordChar="●" Watermark="再次输入新密码"/>
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="12">
                <atom:Button Content="取消" Width="90" Height="34" Click="CloseClick"/>
                <atom:Button Content="确认修改" Width="110" Height="34"/>
            </StackPanel>
        </Grid>
    </atom:Card>
</UserControl>
