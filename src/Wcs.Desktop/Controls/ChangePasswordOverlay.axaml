<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Wcs.Desktop.Controls.ChangePasswordOverlay"
             Width="420" Height="320">
    <Border Background="{DynamicResource BgSecondary}" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource BorderColor}">
        <Grid RowDefinitions="Auto,*,Auto">
            <!-- Header -->
            <Border Background="{DynamicResource BgCard}" Padding="16,12" CornerRadius="8,8,0,0">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="修改密码" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                    <Button Grid.Column="1" Width="30" Height="30"
                            Content="✕" FontSize="12"
                            Background="Transparent" BorderThickness="0"
                            Click="CloseClick"/>
                </Grid>
            </Border>

            <!-- Body -->
            <StackPanel Grid.Row="1" Spacing="14" Margin="24,20">
                <StackPanel Spacing="4">
                    <TextBlock Text="原密码" Foreground="{DynamicResource TextSecondary}" FontSize="13"/>
                    <TextBox PasswordChar="●" Background="{DynamicResource BgPrimary}"
                             Foreground="{DynamicResource TextPrimary}"
                             BorderThickness="1" BorderBrush="{DynamicResource BorderColor}"/>
                </StackPanel>
                <StackPanel Spacing="4">
                    <TextBlock Text="新密码" Foreground="{DynamicResource TextSecondary}" FontSize="13"/>
                    <TextBox PasswordChar="●" Background="{DynamicResource BgPrimary}"
                             Foreground="{DynamicResource TextPrimary}"
                             BorderThickness="1" BorderBrush="{DynamicResource BorderColor}"/>
                </StackPanel>
                <StackPanel Spacing="4">
                    <TextBlock Text="确认新密码" Foreground="{DynamicResource TextSecondary}" FontSize="13"/>
                    <TextBox PasswordChar="●" Background="{DynamicResource BgPrimary}"
                             Foreground="{DynamicResource TextPrimary}"
                             BorderThickness="1" BorderBrush="{DynamicResource BorderColor}"/>
                </StackPanel>
            </StackPanel>

            <!-- Footer -->
            <Border Grid.Row="2" Padding="16,10" CornerRadius="0,0,8,8" Background="{DynamicResource BgSidebar}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="16">
                    <Button Content="取消" Width="90" Height="32"
                            Classes="Secondary"
                            VerticalContentAlignment="Center"
                            Click="CloseClick"/>
                    <Button Content="确认修改" Width="100" Height="32"
                            Classes="Primary"
                            VerticalContentAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
