<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Wcs.Desktop.ViewModels"
             xmlns:md="using:Wcs.Desktop.Models"
             xmlns:atom="https://atomui.net"
             x:Class="Wcs.Desktop.Controls.NotificationCenterView"
             Width="720" Height="400"
             x:DataType="vm:MainWindowViewModel">
    <atom:Card Header="消息中心" StyleVariant="Outlined">
        <Grid RowDefinitions="Auto,*" RowSpacing="10">
            <TextBlock Grid.Row="0" HorizontalAlignment="Right" FontSize="12" Foreground="{DynamicResource TextSecondary}">
                <Run Text="{Binding NotificationCenter.UnreadCount}"/>
                <Run Text=" 条未读"/>
            </TextBlock>
            <Grid Grid.Row="1" ColumnDefinitions="*,*,*" ColumnSpacing="10">
                <atom:Card Grid.Column="0" Header="未读消息" StyleVariant="Outlined">
                    <atom:ListView ItemsSource="{Binding NotificationCenter.UnreadMessages}">
                        <atom:ListView.ItemTemplate>
                            <DataTemplate x:DataType="md:NotificationItem">
                                <StackPanel Spacing="3" Margin="4">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" FontSize="12"/>
                                    <TextBlock Text="{Binding Message}" Foreground="{DynamicResource TextSecondary}" FontSize="11" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Time, StringFormat='{}{0:HH:mm}'}" Foreground="{DynamicResource TextSecondary}" FontSize="10"/>
                                </StackPanel>
                            </DataTemplate>
                        </atom:ListView.ItemTemplate>
                    </atom:ListView>
                </atom:Card>
                <atom:Card Grid.Column="1" Header="系统消息" StyleVariant="Outlined">
                    <atom:ListView ItemsSource="{Binding NotificationCenter.SystemMessages}">
                        <atom:ListView.ItemTemplate>
                            <DataTemplate x:DataType="md:NotificationItem">
                                <StackPanel Spacing="3" Margin="4">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" FontSize="12"/>
                                    <TextBlock Text="{Binding Message}" Foreground="{DynamicResource TextSecondary}" FontSize="11" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Time, StringFormat='{}{0:MM/dd HH:mm}'}" Foreground="{DynamicResource TextSecondary}" FontSize="10"/>
                                </StackPanel>
                            </DataTemplate>
                        </atom:ListView.ItemTemplate>
                    </atom:ListView>
                </atom:Card>
                <atom:Card Grid.Column="2" Header="已读消息" StyleVariant="Outlined">
                    <atom:ListView ItemsSource="{Binding NotificationCenter.ReadMessages}">
                        <atom:ListView.ItemTemplate>
                            <DataTemplate x:DataType="md:NotificationItem">
                                <StackPanel Spacing="3" Margin="4">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" FontSize="12"/>
                                    <TextBlock Text="{Binding Message}" Foreground="{DynamicResource TextSecondary}" FontSize="11" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Time, StringFormat='{}{0:MM/dd HH:mm}'}" Foreground="{DynamicResource TextSecondary}" FontSize="10"/>
                                </StackPanel>
                            </DataTemplate>
                        </atom:ListView.ItemTemplate>
                    </atom:ListView>
                </atom:Card>
            </Grid>
        </Grid>
    </atom:Card>
</UserControl>
