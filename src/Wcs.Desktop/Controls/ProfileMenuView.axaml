<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:atom="https://atomui.net"
             x:Class="Wcs.Desktop.Controls.ProfileMenuView"
             Width="220">
    <atom:Card StyleVariant="Outlined">
        <StackPanel Spacing="6">
            <StackPanel Spacing="2" Margin="4,0,4,6">
                <TextBlock Text="Admin" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" FontSize="14"/>
                <TextBlock Text="系统管理员" Foreground="{DynamicResource TextSecondary}" FontSize="12"/>
            </StackPanel>
            <Separator/>
            <atom:Button Content="👤 个人信息" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="OnPersonalInfoClick"/>
            <atom:Button Content="🔑 修改密码" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="OnChangePasswordClick"/>
            <Separator/>
            <atom:Button x:Name="ThemeButton" Content="🎨 浅色主题" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="OnThemeToggleClick"/>
            <Separator/>
            <atom:Button Content="🚪 注销登录" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="OnLogoutClick"/>
        </StackPanel>
    </atom:Card>
</UserControl>
