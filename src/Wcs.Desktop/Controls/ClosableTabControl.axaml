<UserControl
    x:Class="Wcs.Desktop.Controls.ClosableTabControl"
    x:Name="PART_Root"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="clr-namespace:Wcs.Desktop.Controls"
    xmlns:atom="https://atomui.net"
    mc:Ignorable="d">

    <UserControl.Styles>
        <!-- 页签关闭按钮：原生 Button 保证字形可见，悬停高亮提示可点击 -->
        <Style Selector="Button.tab-close">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style Selector="Button.tab-close:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BorderColor}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentBlue}"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="44,Auto,*" Background="{DynamicResource BgPrimary}">
        <Border Grid.Row="0"
                Background="{DynamicResource BgSecondary}"
                BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource BorderColor}"
                Padding="10,0,8,0">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Tabs, ElementName=PART_Root}" VerticalAlignment="Stretch">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Stretch"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="local:ClosableTabItem">
                            <Grid Margin="2,5,2,0" MinWidth="112">
                                <Border IsVisible="{Binding IsSelected, Converter={StaticResource InverseBool}}"
                                        CornerRadius="7,7,0,0"
                                        Background="Transparent"
                                        BorderThickness="1,1,1,0"
                                        BorderBrush="Transparent" />
                                <Border IsVisible="{Binding IsSelected}"
                                        CornerRadius="7,7,0,0"
                                        Background="{DynamicResource TabActiveBg}"
                                        BorderThickness="1,1,1,0"
                                        BorderBrush="{DynamicResource BorderColor}" />

                                <Border Padding="12,7,8,7"
                                        Background="Transparent"
                                        PointerPressed="OnTabPointerPressed">
                                    <Border.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="关闭" IsVisible="{Binding CanClose}" Click="OnCloseMenuItemClick"/>
                                            <MenuItem Header="关闭左侧页面" Click="OnCloseLeftMenuItemClick"/>
                                            <MenuItem Header="关闭右侧页面" Click="OnCloseRightMenuItemClick"/>
                                            <Separator/>
                                            <MenuItem Header="关闭全部页面" Click="OnCloseAllMenuItemClick"/>
                                            <MenuItem Header="关闭其他页面" Click="OnCloseAllButThisMenuItemClick"/>
                                        </ContextMenu>
                                    </Border.ContextMenu>
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Header}"
                                                   Foreground="{DynamicResource TextPrimary}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"/>
                                        <Button Grid.Column="1"
                                                Classes="tab-close"
                                                Width="22" Height="20"
                                                Content="✕"
                                                IsVisible="{Binding CanClose}"
                                                ToolTip.Tip="关闭此页面"
                                                Click="OnCloseButtonClick" />
                                    </Grid>
                                </Border>

                                <Border Height="2"
                                        Background="{DynamicResource AccentBlue}"
                                        VerticalAlignment="Bottom"
                                        Margin="9,0"
                                        IsVisible="{Binding IsSelected}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- 页面用途说明栏：随选中页签切换，帮助用户理解当前页面职责 -->
        <Border Grid.Row="1"
                Background="{DynamicResource BgSecondary}"
                BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource BorderColor}"
                Padding="14,5,10,5"
                IsVisible="{Binding SelectedTab.Description, ElementName=PART_Root, Converter={StaticResource NullToBool}}">
            <TextBlock Text="{Binding SelectedTab.Description, ElementName=PART_Root}"
                       Foreground="{DynamicResource TextSecondary}"
                       FontSize="11.5"
                       TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center"/>
        </Border>

        <Border Grid.Row="2" Background="{DynamicResource BgPrimary}">
            <ContentPresenter Content="{Binding SelectedTab.Content, ElementName=PART_Root}" />
        </Border>
    </Grid>
</UserControl>