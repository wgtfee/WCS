{
  "WcsIamMigration": {
    "ShadowSupported": false,
    "Mode": "IamPrepareAlias",
    "Reason": "WCS has no independent local user/role entitlement source to compare with IAM. Use Centralized only after permission preparation."
  },
  "Security": {
    "Authentication": { "Mode": "Local" },
    "Authorization": { "Mode": "Local" },
    "LocalUserManagementMode": "Enabled",
    "Central": {
      "Authority": "http://localhost:5100",
      "Audience": "industrial-platform",
      "PermissionFailureMode": "FailClosed",
      "PermissionCacheMinutes": 5,
      "ShadowCentralAuthorization": false,
      "SystemCode": "WCS",
      "ShadowUserProvisioning": "AutoCreate",
      "RequireSystemAccess": true,
      "AllowEmergencyLocalLogin": false,
      "EmergencyLocalUserNames": []
    },
    "ResourceSync": {
      "Enabled": true,
      "SystemCode": "WCS",
      "ManifestPath": "permission-manifest.json",
      "ClientId": "wcs-service",
      "ClientSecret": ""
    }
  }
}
