{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "ConnectionStrings": {
    "WcsDb": "Server=localhost;Database=WcsDb;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "WcsOptions": {
    "PlcPolling": {
      "Enabled": true,
      "IntervalMs": 100
    },
    "Persistence": {
      "IntervalSeconds": 10
    },
    "Snapshot": {
      "IntervalSeconds": 5,
      "MaxSnapshots": 100
    },
    "AlarmMonitor": {
      "IntervalSeconds": 10
    }
  },
  "PlcConnections": [
    {
      "PlcName": "PLC1",
      "Address": "192.168.0.1",
      "Rack": 0,
      "Slot": 1,
      "Timeout": 5000,
      "RetryCount": 3,
      "RetryInterval": 1000
    }
  ]
}
