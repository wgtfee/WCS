{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "ConnectionStrings": {
    "WcsDb": ""
  },
  "WcsOptions": {
    "PlcPolling": {
      "Enabled": true,
      "IntervalMs": 100
    },
    "Persistence": {
      "IntervalSeconds": 10
    },
    "Snapshot": {
      "IntervalSeconds": 5,
      "MaxSnapshots": 100
    },
    "AlarmMonitor": {
      "IntervalSeconds": 10
    },
    "AlarmRules": [
      {
        "AlarmCode": "DEADLOCK",
        "Level": "Warning",
        "DelayRaiseMs": 1000,
        "AlarmGroup": "System"
      }
    ]
  },
  "Simulator": {
    "Enabled": false,
    "TransportTps": 2
  },
  "Storage": {
    "Telemetry": {
      "Provider": "Disabled",
      "DurabilityMode": "WriteAhead",
      "ChannelCapacity": 100000,
      "BatchSize": 1000,
      "FlushIntervalMs": 1000,
      "RetryDelayMs": 2000,
      "WalBatchSize": 256,
      "WalFlushIntervalMs": 10,
      "SpoolDirectory": "data/plc-telemetry-spool",
      "Site": "default",
      "Measurement": "plc_signal",
      "InfluxDb": {
        "ApiVersion": "V2",
        "Url": "http://127.0.0.1:8086",
        "Token": "",
        "Organization": "wcs",
        "Bucket": "wcs_plc",
        "Database": "wcs_plc",
        "Gzip": false
      }
    }
  },
  "AnomalyDetection": {
    "Enabled": false,
    "WindowSize": 120,
