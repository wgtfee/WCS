{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "Wcs.Host.BackgroundServices.SimulatorBackgroundService": "Information",
      "Wcs.Host.BackgroundServices.SignalRBridgeBackgroundService": "Information",
      "Wcs.Host.BackgroundServices.TaskExecutionWorker": "Information",
      "Wcs.Simulator.PlcSimulatorEngine.SimulatedPlcPollingService": "Information"
    }
  },
  "WcsOptions": {
    "PlcPolling": {
      "Enabled": true,
      "IntervalMs": 100
    },
    "Persistence": {
      "IntervalSeconds": 1
    },
    "Snapshot": {
      "IntervalSeconds": 5,
      "MaxSnapshots": 20
    },
    "AlarmMonitor": {
      "IntervalSeconds": 5
    }
  },
  "Simulator": {
    "Enabled": true,
    "TransportTps": 2
  },
  "TaskExecution": {
    "WorkerCount": 24,
    "IdleDelayMs": 10,
    "ExecutionDelayMs": 250
  },
  "TransportObservability": {
    "Enabled": true,
    "ConsistencyInspectionIntervalSeconds": 10,
    "HealthEvaluationIntervalSeconds": 5,
    "TraceRetentionCount": 5000,
    "RaiseConsistencyAlarms": false,
    "EnablePrometheusEndpoint": true,
    "EnableOtlpExporter": false
  },
  "TransportResilience": {
    "Enabled": true,
    "PreflightIntervalSeconds": 10,
    "AutomaticBackupEnabled": false,
    "RequireReadyBeforeAutomaticBackup": false,
    "BackupDirectory": "artifacts/transport-backups"
  }
}
