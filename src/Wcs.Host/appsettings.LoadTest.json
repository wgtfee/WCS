{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "Wcs.Host.BackgroundServices.SimulatorBackgroundService": "Information",
      "Wcs.Host.BackgroundServices.SignalRBridgeBackgroundService": "Information",
      "Wcs.Host.BackgroundServices.TaskExecutionWorker": "Information",
      "Wcs.Host.BackgroundServices.PlcTelemetryEventBridgeService": "Information",
      "Wcs.Host.BackgroundServices.PlcAnomalyDetectionService": "Information",
      "Wcs.Host.BackgroundServices.PlcAnomalyPersistenceService": "Information",
      "Wcs.Infrastructure.Telemetry.PlcTelemetryBuffer": "Information",
      "Wcs.Infrastructure.Telemetry.PlcTelemetryBatchWriterService": "Information",
      "Wcs.Simulator.PlcSimulatorEngine.SimulatedPlcPollingService": "Information"
    }
  },
  "WcsOptions": {
    "PlcPolling": {
      "Enabled": true,
      "IntervalMs": 100
    },
    "Persistence": {
      "IntervalSeconds": 1
    },
    "Snapshot": {
      "IntervalSeconds": 5,
      "MaxSnapshots": 20
    },
    "AlarmMonitor": {
      "IntervalSeconds": 5
    }
  },
  "Simulator": {
    "Enabled": true,
    "TransportTps": 2,
    "ChangeProbabilityEnvironmentVariable": "SIMULATOR_CHANGE_PROBABILITY"
  },
  "Storage": {
    "Telemetry": {
      "Provider": "SqlServer",
      "DurabilityMode": "Buffered",
      "ChannelCapacity": 100000,
      "BatchSize": 1000,
      "FlushIntervalMs": 500,
      "RetryDelayMs": 1000,
      "WalBatchSize": 256,
      "WalFlushIntervalMs": 10,
      "SpoolDirectory": "artifacts/plc-telemetry-spool",
      "Site": "load-test",
      "Measurement": "plc_signal",
      "InfluxDb": {
        "ApiVersion": "V2",
        "Url": "http://127.0.0.1:8086",
        "Token": "wcs-load-test-token",
        "Organization": "wcs",
        "Bucket": "wcs_plc",
        "Database": "wcs_plc",
        "Gzip": false
      }
    }
  },
  "AnomalyDetection": {
    "Enabled": true,
    "WindowSize": 120,
    "MinimumSamples": 30,
    "MaximumTrackedRuleSignals": 25000,
    "ObserveThreshold": 0.70,
    "WarningThreshold": 0.85,
    "AlarmThreshold": 0.95,
    "ConsecutiveWarningCount": 3,
    "ConsecutiveAlarmCount": 5,
    "RecoveryCount": 2,
    "DurationSweepIntervalMs": 250,
    "AlarmDelayRaiseMs": 0,
    "AlarmDelayRecoverMs": 0,
    "Rules": [
      {
        "RuleId": "ANOMALY-LOAD-HIGH-CURRENT",
        "Enabled": true,
        "PlcPattern": "ANOMALY-LOAD-PLC",
        "DevicePattern": "ANOM*",
        "SignalPattern": "*_ANOMALY_LOAD_Current",
        "Maximum": 10,
        "Severity": "Warning",
        "RaiseAlarm": false,
        "ConsecutiveAbnormalCount": 3,
        "ConsecutiveRecoveryCount": 2,
        "Description": "CI deterministic threshold anomaly"
      },
      {
        "RuleId": "ANOMALY-LOAD-RUNNING-WITHOUT-SPEED",
        "Enabled": true,
        "PlcPattern": "ANOMALY-LOAD-PLC",
        "DevicePattern": "ANOMCONS*",
        "SignalPattern": "*_ANOMALY_LOAD_Running",
        "RelatedSignalPattern": "*_ANOMALY_LOAD_Speed",
        "WhenValueEquals": "true",
        "RelatedMinimum": 0.1,
        "MaximumRelatedAgeMs": 5000,
        "Severity": "Warning",
        "RaiseAlarm": false,
        "ConsecutiveAbnormalCount": 1,
        "ConsecutiveRecoveryCount": 1,
        "Description": "CI cross-signal consistency anomaly"
      }
    ]
  },
  "TaskExecution": {
    "WorkerCount": 24,
    "IdleDelayMs": 10,
    "ExecutionDelayMs": 250
  },
  "TransportObservability": {
    "Enabled": true,
    "ConsistencyInspectionIntervalSeconds": 10,
    "HealthEvaluationIntervalSeconds": 5,
    "TraceRetentionCount": 5000,
    "RaiseConsistencyAlarms": false,
    "EnablePrometheusEndpoint": true,
    "EnableOtlpExporter": false
  },
  "TransportResilience": {
    "Enabled": true,
    "PreflightIntervalSeconds": 10,
    "AutomaticBackupEnabled": false,
    "RequireReadyBeforeAutomaticBackup": false,
    "BackupDirectory": "artifacts/transport-backups"
  }
}
