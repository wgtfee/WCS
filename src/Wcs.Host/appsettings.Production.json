{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "ConnectionStrings": {
    "WcsDb": ""
  },
  "Simulator": {
    "Enabled": false
  },
  "HilVerification": {
    "Enabled": false,
    "AllowedEnvironments": [
      "HIL",
      "TrialRun"
    ],
    "RequireDualApproval": true,
    "RequireSelfHostedHilRunner": true
  },
  "Storage": {
    "Telemetry": {
      "Provider": "Disabled",
      "DurabilityMode": "WriteAhead",
      "SpoolDirectory": "data/plc-telemetry-spool",
      "Site": "production",
      "Line": "production",
      "Production": true
    }
  }
}
